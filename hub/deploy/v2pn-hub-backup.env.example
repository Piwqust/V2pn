# /etc/v2pn-hub-backup.env: the settings of deploy/v2pn-hub-backup.sh (deploy/BACKUP.md). HUB_DATA comes from
# /etc/v2pn-hub.env.
HUB_BACKUP_DIR=/var/backups/v2pn-hub
HUB_BACKUP_KEEP_DAYS=14
# A copy of each new archive on another machine (rsync over ssh); none when empty. The archive holds the hub's key.
#HUB_BACKUP_REMOTE=v2pn-backup@backup.example:/srv/backups/v2pn-hub/
#HUB_BACKUP_SSH=ssh -i /var/lib/v2pn-hub/.ssh/backup_ed25519 -o BatchMode=yes
