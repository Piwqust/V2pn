HUB_PORT=18190
HUB_DATA=/var/lib/v2pn-hub
HUB_PUBLIC_DIR=/var/www/v2pn.angleford.co
HUB_ORIGIN=https://v2pn.angleford.co
HUB_GITHUB_REPO=Piwqust/V2pn
# Partners the owner signs with V2pn's root key (the release asset partner-index.json): the hub keeps their ids and
# domains for them. It reads the index at start and every six hours, checks it with the root key and keeps a copy in
# HUB_DATA/root-partner-index.json. The defaults follow HUB_GITHUB_REPO and the key in v2rayN/Directory.Build.targets.
#HUB_ROOT_INDEX_URL=https://github.com/Piwqust/V2pn/releases/latest/download/partner-index.json
#HUB_ROOT_KEYS=<base64 SubjectPublicKeyInfo>|<another one>
# Kept as well, whatever GitHub says: id=domain,domain; id=domain
#HUB_ROOT_PARTNERS=configra=angleford.co,*.angleford.co
