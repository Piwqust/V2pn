---
// The arrow of a link that leaves at 45°: the fork's right road. Square ends, like the brand's icons.
interface Props { class?: string; down?: boolean }
const { class: cls = 'arr', down } = Astro.props;
---
<svg class={cls} viewBox="0 0 16 16" aria-hidden="true">
  {down ? <path d="M8 2v11M3 8.5l5 5 5-5" /> : <path d="M4 12L12 4M5.5 4H12v6.5" />}
</svg>
