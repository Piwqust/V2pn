---
// The fork alone: a road seen from above (brand book, chapter 02).
import brand from '../data/brand.json';
interface Props { class?: string; label?: string }
const { class: cls, label } = Astro.props;
---
<svg class={cls} viewBox="0 0 104 112" role={label ? 'img' : undefined} aria-hidden={label ? undefined : 'true'} aria-label={label}>
  <polygon points={brand.markPoints}></polygon>
</svg>
