---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Arrow from '../components/Arrow.astro';
import { site, downloads, commands, decisions, checkLog, faq, shots } from '../data/site';
import { presets } from '../data/routes';
import connected from '../assets/shots/ru/connected.png';
import routingRu from '../assets/shots/ru/routing.png';
import partnerScene from '../assets/shots/configra-scene-dark.webp';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'V2pn',
  operatingSystem: 'Windows 10, Windows 11, macOS 13.6+',
  applicationCategory: 'NetworkingApplication',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'RUB' },
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  url: site.url,
  downloadUrl: `${site.url}/download/`,
  softwareVersion: site.version || undefined,
  inLanguage: ['ru', 'en'],
};
const first = presets[0];
---
<Base description={site.description} jsonLd={jsonLd}>
  <!-- HERO: the fork. Text on the left road of the grid, the mark on the right, bleeding off the edge. -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap grid hero__grid">
      <div class="hero__text">
        <h1 id="hero-h" class="hero__h">
          <span class="hero__kicker">V2pn, VPN-клиент для Windows и macOS.</span>
          <span class="t-mega hero__title" data-split="lines" data-intro data-delay="0.1">Всегда две дороги</span>
        </h1>
        <p class="lead hero__lead">
          Вставьте ссылку на подписку от провайдера и нажмите «Подключиться». Российские сайты пойдут напрямую, остальное через выбранный сервер.
        </p>
        <div class="hero__act">
          <a class="btn btn--lg" href="/download/" data-dl-primary><span data-dl-label>Скачать V2pn</span><Arrow class="btn__arr" /></a>
          <a class="btn btn--text" href="#install"><span>Установить одной командой</span></a>
        </div>
        <p class="t-xs muted hero__meta">
          <span data-dl-detail>Windows 10 и 11, macOS 13.6 и новее</span> · бесплатно · открытый код
        </p>
        <div class="hero__route">
          <p class="label" id="route-label">Что идёт через VPN: выберите, как в приложении</p>
          <div class="presets" role="radiogroup" aria-labelledby="route-label" data-presets>
            {presets.map((p, i) => (
              <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-preset-id={p.id}>
                {p.name}{p.recommended && <span class="presets__rec">Рекомендуем</span>}
              </button>
            ))}
          </div>
          <p class="t-s muted presets__hint" aria-live="polite" data-preset-hint>{first.hint}</p>
        </div>
      </div>

      <div class="fork" data-fork data-preset="ru" aria-hidden="true">
        <svg class="fork__still" viewBox="-8 -6 120 150" preserveAspectRatio="xMidYMin meet"><polygon points="0,0 32,0 32,40 72,0 104,0 104,32 85.255,32 64,53.255 64,112 32,112 32,72 0,40"></polygon><rect x="32" y="111" width="32" height="40"></rect></svg>
        <canvas class="fork__cv"></canvas>
        <span class="fork__tag" data-fork-label="direct"><span>Напрямую</span></span>
        <span class="fork__tag fork__tag--server" data-fork-label="server"><span>Через сервер</span></span>
      </div>

    </div>
  </section>

  <!-- WINDOW: the real window, three decisions moving one frame over it. -->
  <section class="section win" id="app" aria-labelledby="win-h">
    <div class="wrap grid">
      <div class="win__text">
        <h2 id="win-h" class="t-xl" data-split="lines">Одно окно, три решения</h2>
        <p class="win__lead muted" data-reveal="up">Внутри работает v2rayN с ядрами Xray, sing-box и mihomo: подойдёт любая подписка, которая работает там. Снаружи одно окно.</p>
        <ol class="win__steps" role="list">
          {decisions.map((d) => (
            <li class="win__step" data-chapter={JSON.stringify(d.focus)}>
              <span class="win__n tnum" aria-hidden="true">{d.n}</span>
              <h3 class="t-m">{d.title}</h3>
              <p class="muted">{d.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="win__stage" data-stage>
        <figure class="shot win__shot">
          <div class="win__frame">
            <Picture src={connected} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1280, 1618]} sizes="(max-width: 767px) 92vw, 62vw" alt={shots.connected.alt} />
            <div class="win__alt"><Picture src={routingRu} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1280, 1618]} sizes="(max-width: 767px) 92vw, 62vw" alt={shots.routingRu.alt} loading="lazy" /></div>
            <span class="win__focus" data-focus aria-hidden="true"></span>
          </div>
          <figcaption>V2pn с демо-подпиской: сервер во Франкфурте, «Прокси» на локальном порту, всё через VPN.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- CHECK: the status says «Защищено» only after a real check. -->
  <section class="section check" aria-labelledby="check-h" data-ground="tunnel">
    <div class="wrap grid">
      <p class="check__num on-left" aria-hidden="true"><span class="t-num">38</span><span class="check__unit">мс</span></p>
      <div class="check__text">
        <h2 id="check-h" class="t-l" data-split="lines">«Защищено» появляется только после проверки</h2>
        <p class="muted measure" data-reveal="up">Нажать «Подключиться» мало. V2pn проверяет соединение через выбранный сервер и только потом меняет статус. Перестал отвечать сервер: V2pn предложит другой из той же страны. После сна и смены Wi-Fi проверит заново.</p>
        <ol class="log" role="list" data-reveal="branch">
          {checkLog.map((l) => (
            <li><span class="log__ok" aria-hidden="true"></span><span>{l.text}</span>{l.value && <span class="mono log__v">{l.value}</span>}</li>
          ))}
        </ol>
        <p class="t-xs muted">38 мс: пинг демо-подписки со скриншота выше. У вашего провайдера будет свой.</p>
      </div>
    </div>
  </section>

  <!-- PROMISE: one statement. -->
  <section class="section promise" aria-labelledby="promise-h">
    <div class="wrap grid">
      <h2 id="promise-h" class="label on-left promise__label">Серверы и подписка</h2>
      <p class="t-l promise__text" data-split="lines">V2pn не продаёт серверы. Подписка остаётся у вашего провайдера. V2pn подключает её серверы, обновляется сам с подписанных релизов и ничего не отправляет о вас.</p>
    </div>
  </section>

  <!-- TAB: a provider's tab, a real capture. -->
  <section class="section tab" aria-labelledby="tab-h">
    <div class="wrap grid">
      <figure class="shot tab__shot" data-reveal="clip">
        <Picture src={partnerScene} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 960, 1280]} sizes="(max-width: 767px) 92vw, 58vw" alt={shots.partnerScene.alt} loading="lazy" />
        <figcaption>Вкладка Configra, первого провайдера в V2pn.</figcaption>
      </figure>
      <div class="tab__text">
        <h2 id="tab-h" class="t-l" data-split="lines">Вкладка вашего провайдера</h2>
        <p class="muted" data-reveal="up">Если провайдер работает с V2pn, его кнопка «Подключить в V2pn» добавит подписку вместе с вкладкой в заголовке окна: его цвета, ваш тариф и только его серверы.</p>
        <ul class="ticks" role="list" data-reveal="up">
          <li>Вкладка V2pn остаётся обычным V2pn.</li>
          <li><kbd>Ctrl</kbd>+<kbd>Tab</kbd> переключает вкладки, подключение не прерывается.</li>
          <li>Пришли не от провайдера: вкладок нет.</li>
        </ul>
        <a class="btn btn--ghost" href="/providers/">Провайдерам<Arrow class="btn__arr" /></a>
      </div>
    </div>
  </section>

  <!-- INSTALL: the files as an index, then the one command. -->
  <section class="section install" id="install" aria-labelledby="install-h" data-ground="paper">
    <div class="wrap grid">
      <div class="install__head on-left">
        <h2 id="install-h" class="t-xl" data-split="lines">Скачать</h2>
        {site.version && <p class="muted t-s">Версия <span class="tnum">{site.version}</span>. Обновляется сама раз в шесть часов, с подписанных релизов.</p>}
      </div>
      <ul class="files" role="list">
        {downloads.map((d) => (
          <li>
            <a class="row-link files__row" href={d.href} data-dl={d.key}>
              <span class="files__title t-m">{d.title}</span>
              <span class="files__detail muted t-s">{d.detail}</span>
              <span class="files__file mono muted">{d.file}</span>
              <span class="files__yours t-xs">для этого компьютера</span>
              <Arrow class="arr" down />
            </a>
          </li>
        ))}
      </ul>
      <div class="install__cmd">
        <h3 class="t-m">Или одной командой</h3>
        <p class="muted t-s measure">Команда скачает последнюю версию, сверит её со списком файлов релиза и поставит V2pn без прав администратора. Если на компьютере есть v2rayN, V2pn заберёт его серверы.</p>
        <p class="label">Windows, в Терминале (<kbd>Win</kbd>+<kbd>X</kbd> → Терминал)</p>
        <div class="cmd cmd--ps"><code id="cmd-win">{commands.win}</code><button class="copy" type="button" data-copy="cmd-win">Копировать</button></div>
        <p class="label">macOS, в Терминале</p>
        <div class="cmd"><code id="cmd-mac">{commands.mac}</code><button class="copy" type="button" data-copy="cmd-mac">Копировать</button></div>
        <p class="t-s"><a class="link" href="/download/">Что делать после загрузки</a></p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq" aria-labelledby="faq-h">
    <div class="wrap grid">
      <h2 id="faq-h" class="t-l on-left">Вопросы</h2>
      <dl class="faq__list">
        {faq.map((f) => (<div class="faq__item" data-reveal="up"><dt class="t-m">{f.q}</dt><dd class="muted">{f.a}</dd></div>))}
      </dl>
      <p class="faq__more"><a class="btn btn--ghost" href="/docs/">Вся документация<Arrow class="btn__arr" /></a></p>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------ hero */
  .hero { position: relative; overflow: clip; }
  .hero__grid { min-height: max(100svh, 46rem); align-items: center; }
  .hero__text { grid-column: 1 / span 6; grid-row: 1; padding-block: calc(var(--header-h) + 1.5rem) 2.5rem; position: relative; z-index: 2; }
  .hero__h { display: grid; gap: 1rem; }
  .hero__kicker { font: 500 var(--t-m)/1.3 var(--f-body); color: var(--c-muted); letter-spacing: -0.01em; }
  .hero__title { font-size: clamp(3.4rem, 1rem + 7.6vw, 9rem); max-width: 6.5ch; }
  .hero__lead { margin-top: 1.5rem; max-width: 34ch; font-size: clamp(1.1rem, 1rem + 0.35vw, 1.3rem); }
  .hero__act { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; margin-top: 1.75rem; }
  .hero__meta { margin-top: 0.85rem; }
  .hero__route { margin-top: 2.25rem; }

  .fork {
    grid-column: 7 / -1; grid-row: 1; align-self: stretch;
    position: relative; z-index: 1;
    margin-right: calc((min(100vw - 2 * var(--margin), var(--max)) - 100vw) / 2);
    min-height: 100%;
  }
  .fork__cv { position: absolute; inset: 0; width: 100%; height: 100%; }
  .fork__still { position: absolute; inset: 6% 0 0; width: 100%; height: 94%; fill: var(--signal); }
  .fork.is-live .fork__still { display: none; }
  /* Without the canvas the right road still sits behind glass. */
  .fork:not(.is-live)::after {
    content: ''; position: absolute; inset: 0 0 0 62%;
    background: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.16) 0, rgb(255 255 255 / 0.04) 3px, rgb(0 0 0 / 0) 50%, rgb(0 0 0 / 0.3) 18px, rgb(255 255 255 / 0.1) 20px);
    backdrop-filter: blur(10px);
  }
  .fork__tag { position: absolute; left: 0; top: 0; z-index: 2; pointer-events: none; }
  .fork__tag > span {
    display: block; translate: -50% calc(-100% - 0.6rem); white-space: nowrap;
    font: 600 var(--t-xs)/1 var(--f-body); letter-spacing: 0.01em;
    padding: 0.45rem 0.6rem; background: var(--tunnel); color: #ECECF1;
    box-shadow: inset 2px 0 0 #ECECF1;
  }
  .fork__tag--server > span { box-shadow: inset 2px 0 0 var(--signal); }
  .fork:not(.is-live) .fork__tag { display: none; }

  .presets { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 0.75rem; border: 1px solid var(--c-line); max-width: 40rem; }
  .presets button {
    position: relative; padding: 0.85rem 1.1rem; font-size: var(--t-s); font-weight: 500; color: var(--c-muted);
    border-right: 1px solid var(--c-line); text-align: left; min-height: 2.75rem;
    transition: color 0.25s var(--e-standard), background-color 0.25s var(--e-standard);
  }
  .presets button:last-child { border-right: 0; }
  .presets button[aria-checked='true'] { background: #ECECF1; color: var(--tunnel); }
  .presets button::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--signal); scale: 0 1; transform-origin: left; transition: scale 0.35s var(--e-standard); }
  @media (hover: hover) { .presets button:hover::after { scale: 1 1; } }
  .presets button:focus-visible::after { scale: 1 1; }
  @media (hover: hover) { .presets button:not([aria-checked='true']):hover { color: var(--c-fg); background: rgb(255 255 255 / 0.06); } }
  .presets button:focus-visible { outline-offset: -3px; }
  .presets__rec { display: block; font-size: 0.6875rem; font-weight: 600; color: var(--protected); margin-top: 0.15rem; }
  .presets button[aria-checked='true'] .presets__rec { color: var(--protected-deep); }
  .presets__hint { margin-top: 0.85rem; max-width: 52ch; min-height: 3em; }

  @media (max-width: 1100px) and (min-width: 768px) {
    .hero__text { grid-column: 1 / span 7; }
    .fork { grid-column: 8 / -1; }
  }
  @media (max-width: 767px) {
    .hero__grid { min-height: 0; grid-template-rows: auto auto; }
    .fork { grid-column: 1 / -1; grid-row: 1; height: 54svh; min-height: 22rem; margin-top: var(--header-h); margin-inline: calc(-1 * var(--margin)); }
    .hero__text { grid-column: 1 / -1; grid-row: 2; padding-top: 1.75rem; }
    .presets { grid-template-columns: 1fr; }
    .presets button { border-right: 0; border-bottom: 1px solid var(--c-line); }
    .presets button:last-child { border-bottom: 0; }
  }

  /* ------------------------------------------------------------ window */
  .win__text { grid-column: 1 / span 4; }
  .win__lead { margin-top: 1.5rem; }
  .win__steps { margin-top: calc(var(--u) * 6); display: grid; gap: calc(var(--u) * 10); padding-bottom: 12vh; }
  .win__step { position: relative; padding-left: 3rem; opacity: 0.38; transition: opacity 0.5s var(--e-standard); }
  .win__step.is-on { opacity: 1; }
  html:not(.motion) .win__step { opacity: 1; }
  .win__n { position: absolute; left: 0; top: -0.1rem; font: 200 2.4rem/1 var(--f-display); color: var(--signal); }
  .win__step h3 { margin-bottom: 0.5rem; }
  .win__stage { grid-column: 5 / -1; position: relative; }
  .win__shot { position: sticky; top: calc(var(--header-h) + 3vh); }
  .win__frame { position: relative; overflow: hidden; border-radius: 14px; box-shadow: 0 40px 90px -40px rgb(0 0 0 / 0.8); }
  .win__frame :global(img) { box-shadow: none; border-radius: 0; }
  .win__alt { position: absolute; inset: 0; opacity: 0; transition: opacity 0.5s var(--e-standard); }
  .win__alt :global(img) { width: 100%; height: 100%; }
  .win__stage[data-state='2'] .win__alt { opacity: 1; }
  html:not(.js) .win__alt { display: none; }
  .win__focus {
    position: absolute; left: 2%; top: 17%; width: 22%; height: 60%;
    box-shadow: 0 0 0 2px var(--signal), 0 0 0 9999px rgb(11 11 13 / 0.5);
    pointer-events: none;
  }
  html:not(.js) .win__focus { display: none; }
  @media (max-width: 767px) {
    .win__text, .win__stage { grid-column: 1 / -1; }
    .win__stage { grid-row: 1; margin-bottom: 2rem; }
    .win__shot { top: calc(var(--header-h) + 0.5rem); z-index: 2; }
    .win__steps { gap: 40vh; padding-bottom: 10vh; }
    .win__shot figcaption { display: none; }
  }

  /* ------------------------------------------------------------ check */
  .check__num { display: flex; align-items: baseline; gap: 0.4rem; color: var(--c-fg); }
  .check__unit { font: 200 var(--t-l)/1 var(--f-display); color: var(--c-muted); }
  .check__text { grid-column: 5 / span 7; display: grid; gap: 1.5rem; align-content: start; }
  .log { list-style: none; padding: 0; border-top: 1px solid var(--c-line); font-family: var(--f-mono); font-size: 0.875rem; max-width: 40rem; }
  .log li { display: grid; grid-template-columns: 1.5rem 1fr auto; align-items: center; padding: 0.8rem 0; border-bottom: 1px solid var(--c-line); }
  .log__ok { width: 0.65rem; height: 0.65rem; background: var(--protected); }
  .log__v { color: var(--protected); }
  @media (max-width: 767px) { .check__text { grid-column: 1 / -1; } .check__num { margin-bottom: 1rem; } }

  /* ------------------------------------------------------------ promise */
  .promise__label { padding-top: 0.9rem; }
  .promise__text { grid-column: 5 / -1; max-width: 26ch; font-weight: 500; }

  /* ------------------------------------------------------------ tab */
  .tab .grid { align-items: center; }
  .tab__shot { grid-column: 1 / span 8; }
  .tab__text { grid-column: 10 / -1; display: grid; gap: 1.4rem; justify-items: start; }
  .ticks { list-style: none; padding: 0; display: grid; gap: 0.7rem; font-size: var(--t-s); }
  .ticks li { position: relative; padding-left: 1.4rem; }
  .ticks li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 0.5rem; height: 0.5rem; background: var(--signal); }
  @media (max-width: 1100px) { .tab__shot { grid-column: 1 / span 7; } .tab__text { grid-column: 8 / -1; } }
  @media (max-width: 767px) { .tab__shot, .tab__text { grid-column: 1 / -1; } .tab__text { margin-top: 2rem; } }

  /* ------------------------------------------------------------ install */
  .install { background: var(--c-bg); color: var(--c-fg); }
  .install__head { display: grid; gap: 1rem; align-content: start; }
  .install__cmd { grid-column: 5 / span 7; margin-top: calc(var(--u) * 8); display: grid; gap: 0.85rem; }
  .install__cmd .label { margin-top: 0.6rem; }
  @media (max-width: 767px) {
    .files, .install__cmd { grid-column: 1 / -1; }
    .files { margin-top: 2rem; }
    .files__row { grid-template-columns: 1fr 1.25rem; }
    .files__detail, .files__file { grid-column: 1; }
    .files__row .arr { grid-column: 2; grid-row: 1; }
  }

  /* ------------------------------------------------------------ faq */
  .faq__more { grid-column: 5 / -1; margin-top: calc(var(--u) * 6); }
  @media (max-width: 767px) { .faq__list, .faq__more { grid-column: 1 / -1; grid-template-columns: 1fr; } .faq__list { margin-top: 1.5rem; } }
</style>
