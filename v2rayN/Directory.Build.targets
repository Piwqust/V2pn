<Project>
  <!--
    V2pn's own release number. v2rayN's <Version> in Directory.Build.props is left alone so that
    merges from v2rayN never conflict on it, and because ServiceLib must keep reporting it:
    subscription panels pick the config format from the "v2rayN/x.y.z" User-Agent.
    The release script and CI pass -p:V2pnVersion=x.y.z; this default is for local builds.
  -->
  <PropertyGroup>
    <V2pnVersion Condition="'$(V2pnVersion)' == ''">1.2.2</V2pnVersion>

    <!--
      "release" only in packages made by tools/release.ps1. Everything else (dotnet build, the IDE)
      is a dev build: it shows "1.0.0-dev" and never replaces itself with a downloaded package,
      which would unpack a self-contained release over a framework-dependent build folder.
    -->
    <V2pnChannel Condition="'$(V2pnChannel)' == ''">dev</V2pnChannel>

    <!--
      Where the app looks for new versions, in order, separated by "|". Every source has the
      layout of a GitHub releases page:
        <source>/latest/download/release.json(.sig)   the newest release's signed manifest
        <source>/download/v<version>/<file>           its packages
      V2pn's server comes first: it answers with a redirect to the GitHub release, so the address
      of updates can change later without a new release. GitHub is the fallback when the server
      does not answer. release.json is signed, so no source has to be trusted.
      A mirror on your own server is a folder of static files laid out like that
      (tools/publish-mirror.ps1 uploads one); add it after the GitHub address.
    -->
    <V2pnUpdateSources Condition="'$(V2pnUpdateSources)' == ''">https://v2pn.angleford.co/releases|https://github.com/Piwqust/V2pn/releases</V2pnUpdateSources>

    <!--
      Public keys (ECDSA P-256, SubjectPublicKeyInfo in base64, "|" between several) that sign
      release.json. The private half never enters the repository: tools/release.ps1 reads it
      from V2PN_SIGNING_KEY or ~/.v2pn/release-signing-key.pem. A second key here lets the old
      one be retired without stranding installed copies.
    -->
    <V2pnUpdateKeys Condition="'$(V2pnUpdateKeys)' == ''">MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEF1jwl9+NW069mc9OSG/didQuIcb0MowrLCF8Qv7B2VH27Z0ujKDj6M8txvra7q4jxomLfQmIwMaBCthrxim4Ig==</V2pnUpdateKeys>

    <!--
      Public keys (ECDSA P-256, SubjectPublicKeyInfo in base64, "|" between several) that sign
      the partner index, partner-index.json: which subscription domains are whose, with which grants and
      which pack. Not the release key: a partner key must never be able to sign an update.
      A plain key is a root key: the owner of V2pn signs with it on his computer (tools/partner.cs
      publish, the private half in ~/.v2pn/partner-root-key.pem), and only an index it signs may
      grant what the owner reviews by hand (routing, transport, core). A key written "hub:<key>" is
      the V2pn Hub's (hub/, on v2pn.angleford.co): it signs what providers publish there, and V2pn
      drops those reviewed grants from an index it signs (V2pnPartnerTrust.ReadIndex).
    -->
    <V2pnPartnerKeys Condition="'$(V2pnPartnerKeys)' == ''">MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE4LVjtb8RY7TUlzR32OpH1Tn5FPKp5B+m2Zb72/cQzjOSuBvYnBWdHnZ7PnPoFhmNKSeCj5shwtmJD1JIVtCGCg==|hub:MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEXiLGsFVHz/rlCFoS8ya/U2TmHc4wdxMJMC6Ti04ONqVlPiGI8WygOlCWPdSApROtsnIF43NdldvSsVm+gsDfYg==</V2pnPartnerKeys>

    <!--
      Where the partner index and the packs are published, in order, separated by "|"; each laid out
      like a releases page (<source>/latest/download/partner-index.json(.sig), partner-<id>.zip).
      The V2pn Hub publishes there as soon as the owner approves a provider; the GitHub release
      carries the copy the owner signs with the root key (tools/sign-release.ps1). V2pn asks both
      and goes by the hub's index, with the root-signed one adding the partners the hub does not
      list (V2pnPartnerIndex.Merge).
    -->
    <V2pnPartnerSources Condition="'$(V2pnPartnerSources)' == ''">https://v2pn.angleford.co/partners|https://github.com/Piwqust/V2pn/releases</V2pnPartnerSources>
  </PropertyGroup>

  <!--
    A build from the developer mode carries a suffix ("1.0.1-local.202611141320"); Windows file
    versions take only the numbers.
  -->
  <PropertyGroup>
    <V2pnNumericVersion>$([System.Text.RegularExpressions.Regex]::Match('$(V2pnVersion)', '^\d+\.\d+\.\d+').Value)</V2pnNumericVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'v2rayN.Desktop'">
    <Version>$(V2pnVersion)</Version>
    <AssemblyVersion>$(V2pnNumericVersion)</AssemblyVersion>
    <FileVersion>$(V2pnNumericVersion)</FileVersion>
    <InformationalVersion>$(V2pnVersion)</InformationalVersion>
    <InformationalVersion Condition="'$(V2pnChannel)' != 'release'">$(V2pnVersion)-dev</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- What Windows shows in the file properties of V2pn.exe and AmazTool.exe. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'v2rayN.Desktop' Or '$(MSBuildProjectName)' == 'AmazTool'">
    <Company>V2pn</Company>
    <Authors>V2pn contributors</Authors>
    <Copyright>Copyright © 2026 V2pn contributors. Based on v2rayN, © 2017-2026 2dust. GPL-3.0.</Copyright>
  </PropertyGroup>

  <!-- Release builds embed their symbols; without this the paths of the build machine go with them. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'ServiceLib'">
    <AssemblyMetadata Include="V2pnVersion" Value="$(V2pnVersion)" />
    <AssemblyMetadata Include="V2pnChannel" Value="$(V2pnChannel)" />
    <!-- The commit a package was built from, "+" when the tree had uncommitted changes. -->
    <AssemblyMetadata Include="V2pnCommit" Value="$(V2pnCommit)" Condition="'$(V2pnCommit)' != ''" />
    <!-- Only in builds made by the developer mode: the source folder they came from. -->
    <AssemblyMetadata Include="V2pnSourceDir" Value="$(V2pnSourceDir)" Condition="'$(V2pnSourceDir)' != ''" />
    <AssemblyMetadata Include="V2pnUpdateSources" Value="$(V2pnUpdateSources)" />
    <AssemblyMetadata Include="V2pnUpdateKeys" Value="$(V2pnUpdateKeys)" />
    <AssemblyMetadata Include="V2pnPartnerKeys" Value="$(V2pnPartnerKeys)" />
    <AssemblyMetadata Include="V2pnPartnerSources" Value="$(V2pnPartnerSources)" />
  </ItemGroup>
</Project>
