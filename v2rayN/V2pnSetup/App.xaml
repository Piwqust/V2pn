<Application x:Class="V2pnSetup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <!-- V2pn's dark theme (v2rayN.Desktop/Assets/V2pnTheme.axaml). -->
    <SolidColorBrush x:Key="WindowBg" Color="#0D0D10" />
    <SolidColorBrush x:Key="MapBg" Color="#0E0E11" />
    <SolidColorBrush x:Key="MapLand" Color="#1C1C23" />
    <SolidColorBrush x:Key="MapBorder" Color="#2C2C36" />
    <SolidColorBrush x:Key="MapDot" Color="#8A8A99" />
    <SolidColorBrush x:Key="Field" Color="#17171D" />
    <SolidColorBrush x:Key="FieldBorder" Color="#30303A" />
    <SolidColorBrush x:Key="Divider" Color="#1C1C23" />
    <SolidColorBrush x:Key="Ink" Color="#ECECF1" />
    <SolidColorBrush x:Key="InkSoft" Color="#C9C9D3" />
    <SolidColorBrush x:Key="Muted" Color="#9B9BA8" />
    <SolidColorBrush x:Key="Faint" Color="#6C6C78" />
    <SolidColorBrush x:Key="Accent" Color="#FF3D1F" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF5A3F" />
    <SolidColorBrush x:Key="AccentPressed" Color="#E8361A" />
    <SolidColorBrush x:Key="AccentSoft" Color="#26FF3D1F" />
    <SolidColorBrush x:Key="OnAccent" Color="#0B0B0D" />
    <SolidColorBrush x:Key="Neutral" Color="#26262F" />
    <SolidColorBrush x:Key="NeutralHover" Color="#33343F" />
    <SolidColorBrush x:Key="NeutralPressed" Color="#3D3E4A" />
    <SolidColorBrush x:Key="Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Pressed" Color="#21FFFFFF" />
    <SolidColorBrush x:Key="Safe" Color="#3DD68C" />
    <SolidColorBrush x:Key="SafeSoft" Color="#1F3DD68C" />
    <SolidColorBrush x:Key="Unsafe" Color="#FF5A3D" />
    <SolidColorBrush x:Key="UnsafeSoft" Color="#1FFF5A3D" />
    <SolidColorBrush x:Key="Track" Color="#22222A" />

    <FontFamily x:Key="Inter">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Inter}" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="21" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
    </Style>

    <!-- Buttons: a rounded body whose colour follows hover and press; Tag carries the three colours. -->
    <Style x:Key="ButtonBase" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource Inter}" />
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value>
          <ScaleTransform />
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" Background="{StaticResource Accent}" CornerRadius="12">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Background" Value="{StaticResource AccentHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Body" Property="Background" Value="{StaticResource AccentPressed}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Body" Property="BorderBrush" Value="#88FFFFFF" />
                <Setter TargetName="Body" Property="BorderThickness" Value="1.5" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Body" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" Background="{StaticResource Unsafe}" CornerRadius="12">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Body" Property="Opacity" Value="0.78" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" Background="{StaticResource Neutral}" CornerRadius="12">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Background" Value="{StaticResource NeutralHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Body" Property="Background" Value="{StaticResource NeutralPressed}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Secondary}">
      <Setter Property="Height" Value="32" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" Background="{StaticResource Neutral}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Background" Value="{StaticResource NeutralHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Body" Property="Background" Value="{StaticResource NeutralPressed}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" Background="Transparent" CornerRadius="12">
              <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Background" Value="{StaticResource Hover}" />
                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{StaticResource Ink}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Body" Property="Background" Value="{StaticResource Pressed}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WindowButton" TargetType="Button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" Background="Transparent" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Background" Value="{StaticResource Hover}" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Body" Property="Background" Value="{StaticResource Pressed}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A check box drawn as V2pn draws its switches' boxes: rounded, the accent when on. -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" VerticalAlignment="Top" Margin="0,1,0,0"
                      Background="Transparent" BorderBrush="#4A4A57" BorderThickness="1.5">
                <Path x:Name="Mark" Data="M5,10.5 L8.5,14 L15,6.5" Stroke="White" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0" Margin="-1.5" />
              </Border>
              <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="#6A6A78" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Mark" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ink}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
