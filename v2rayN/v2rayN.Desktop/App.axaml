<Application
    x:Class="v2rayN.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:loc="using:v2rayN.Desktop"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:semi="https://irihi.tech/semi"
    xmlns:service="clr-namespace:ServiceLib;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Name="V2pn"
    x:DataType="vms:StatusBarViewModel"
    RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Assets/GlobalResources.axaml" />
                <ResourceInclude Source="Assets/V2pnTheme.axaml" />
                <ResourceInclude Source="Assets/V2pnControls.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="AppFontFamily">avares://V2pn/Assets/Fonts#Inter, avares://V2pn/Assets/Fonts#Noto Sans SC</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <semi:SemiTheme />
        <semi:AvaloniaEditSemiTheme />
        <StyleInclude Source="avares://Semi.Avalonia.DataGrid/Index.axaml" />
        <dialogHost:DialogHostStyles />
        <StyleInclude Source="Assets/GlobalStyles.axaml" />
        <StyleInclude Source="Assets/V2pnStyles.axaml" />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon
                Command="{Binding NotifyLeftClickCmd}"
                Icon="/Assets/NotifyIcon1.ico"
                ToolTipText="{Binding RunningServerToolTipText, FallbackValue={x:Static service:Global.AppName}}">
                <TrayIcon.Menu>
                    <!--  V2pn: the proxy states and actions carry the names the window and settings use.  -->
                    <NativeMenu>
                        <NativeMenuItem
                            Command="{Binding ShowWindowCmd}"
                            Header="{x:Static resx:ResUI.TbDisplayGUI}"
                            IsVisible="{Binding BlIsNonWindows}" />
                        <NativeMenuItem
                            Command="{Binding NotifyLeftClickCmd}"
                            Header="{x:Static resx:ResUI.menuShowOrHideMainWindow}"
                            IsVisible="{Binding BlIsNonWindows}" />
                        <NativeMenuItem Command="{Binding CopyProxyCmdToClipboardCmd}" Header="{x:Static resx:ResUI.menuCopyProxyCmdToClipboard}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem
                            Command="{Binding SystemProxyClearCmd}"
                            Header="{x:Static loc:L.TrayDisconnected}"
                            IsChecked="{Binding BlSystemProxyClear}"
                            ToggleType="Radio" />
                        <NativeMenuItem
                            Command="{Binding SystemProxySetCmd}"
                            Header="{x:Static loc:L.ProxyMethodSystem}"
                            IsChecked="{Binding BlSystemProxySet}"
                            ToggleType="Radio" />
                        <NativeMenuItem
                            Command="{Binding SystemProxyNothingCmd}"
                            Header="{x:Static loc:L.ProxyModeKeep}"
                            IsChecked="{Binding BlSystemProxyNothing}"
                            ToggleType="Radio" />
                        <NativeMenuItem
                            Command="{Binding SystemProxyPacCmd}"
                            Header="{x:Static loc:L.ProxyMethodPac}"
                            IsChecked="{Binding BlSystemProxyPac}"
                            IsVisible="{Binding BlSystemProxyPacVisible}"
                            ToggleType="Radio" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Click="MenuAddServerViaClipboardClick" Header="{x:Static loc:L.WelcomePaste}" />
                        <NativeMenuItem Command="{Binding SubUpdateCmd}" Header="{x:Static loc:L.UpdateAll}" />
                        <NativeMenuItem Command="{Binding SubUpdateViaProxyCmd}" Header="{x:Static loc:L.TraySubUpdateViaVpn}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Click="MenuExit_Click" Header="{x:Static loc:L.MenuQuit}" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
