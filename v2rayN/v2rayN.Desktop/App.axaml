<Application
    x:Class="v2rayN.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:loc="using:v2rayN.Desktop"
    xmlns:semi="https://irihi.tech/semi"
    xmlns:service="clr-namespace:ServiceLib;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Name="V2pn"
    x:DataType="vms:StatusBarViewModel"
    RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Assets/GlobalResources.axaml" />
                <ResourceInclude Source="Assets/V2pnTheme.axaml" />
                <ResourceInclude Source="Assets/V2pnControls.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="AppFontFamily">avares://V2pn/Assets/Fonts#Inter</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <semi:SemiTheme />
        <semi:AvaloniaEditSemiTheme />
        <StyleInclude Source="avares://Semi.Avalonia.DataGrid/Index.axaml" />
        <dialogHost:DialogHostStyles />
        <StyleInclude Source="Assets/GlobalStyles.axaml" />
        <StyleInclude Source="Assets/V2pnStyles.axaml" />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon
                Command="{Binding NotifyLeftClickCmd}"
                Icon="/Assets/NotifyIcon1.ico"
                ToolTipText="{Binding TrayToolTipText, FallbackValue={x:Static service:Global.AppName}}">
                <TrayIcon.Menu>
                    <!--
                        V2pn: the state and the everyday actions first, in the window's words; the window sets the
                        texts and checks (MainWindow RefreshTray). The proxy items keep v2rayN's four system-proxy
                        states, named as kinds of the "Proxy" mode.
                        On Windows the tray panel (Views/TrayPanel, Common/TrayMenuPlacement) takes the menu's place;
                        Linux shows this menu.
                    -->
                    <NativeMenu>
                        <NativeMenuItem Header="{Binding TrayStatusText, TargetNullValue={x:Static service:Global.AppName}}" IsEnabled="False" />
                        <NativeMenuItem Command="{Binding ShowWindowCmd}" Header="{x:Static loc:L.TrayOpen}" />
                        <NativeMenuItem
                            Command="{Binding NotifyLeftClickCmd}"
                            Header="{x:Static loc:L.TrayShowHide}"
                            IsVisible="{Binding BlIsNonWindows}" />
                        <NativeMenuItem Click="MenuToggleConnectionClick" Header="{Binding TrayConnectText, TargetNullValue={x:Static loc:L.Connect}}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem
                            Command="{Binding SystemProxyClearCmd}"
                            Header="{x:Static loc:L.TrayDisconnected}"
                            IsChecked="{Binding BlSystemProxyClear}"
                            ToggleType="Radio" />
                        <NativeMenuItem
                            Command="{Binding SystemProxySetCmd}"
                            Header="{x:Static loc:L.TrayProxySystem}"
                            IsChecked="{Binding BlSystemProxySet}"
                            ToggleType="Radio" />
                        <NativeMenuItem
                            Command="{Binding SystemProxyNothingCmd}"
                            Header="{x:Static loc:L.TrayProxyKeep}"
                            IsChecked="{Binding BlSystemProxyNothing}"
                            ToggleType="Radio" />
                        <NativeMenuItem
                            Command="{Binding SystemProxyPacCmd}"
                            Header="{x:Static loc:L.TrayProxyPac}"
                            IsChecked="{Binding BlSystemProxyPac}"
                            IsVisible="{Binding BlSystemProxyPacVisible}"
                            ToggleType="Radio" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem
                            Click="MenuRouteRussiaClick"
                            Header="{x:Static loc:L.RouteRussiaDirect}"
                            IsChecked="{Binding BlTrayRouteRussia}"
                            ToggleType="Radio" />
                        <NativeMenuItem
                            Click="MenuRouteBlockedClick"
                            Header="{x:Static loc:L.RouteBlockedOnly}"
                            IsChecked="{Binding BlTrayRouteBlocked}"
                            ToggleType="Radio" />
                        <NativeMenuItem
                            Click="MenuRouteAllClick"
                            Header="{x:Static loc:L.RouteAll}"
                            IsChecked="{Binding BlTrayRouteAll}"
                            ToggleType="Radio" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Click="MenuAddServerViaClipboardClick" Header="{x:Static loc:L.WelcomePaste}" />
                        <NativeMenuItem Command="{Binding SubUpdateCmd}" Header="{x:Static loc:L.UpdateAll}" />
                        <NativeMenuItem Command="{Binding SubUpdateViaProxyCmd}" Header="{x:Static loc:L.TraySubUpdateViaVpn}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Command="{Binding CopyProxyCmdToClipboardCmd}" Header="{x:Static loc:L.TrayCopyProxyCmd}" />
                        <NativeMenuItem Click="MenuExit_Click" Header="{x:Static loc:L.MenuQuit}" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
