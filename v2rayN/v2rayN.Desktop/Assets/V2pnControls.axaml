<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Buttons: one template, look chosen by class (primary / accent / subtle / ghost / icon).  -->
    <ControlTheme x:Key="V2Button" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource V2CardBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
        <Setter Property="BorderBrush" Value="{DynamicResource V2Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusControl}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    Padding="{TemplateBinding Padding}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Foreground="{TemplateBinding Foreground}"
                    RecognizesAccessKey="True" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource V2CardMutedBackground}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="^.primary">
            <Setter Property="Background" Value="{DynamicResource V2PrimaryFill}" />
            <Setter Property="Foreground" Value="{DynamicResource V2OnPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="^.primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource V2PrimaryShadow}" />
        </Style>
        <Style Selector="^.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource V2PrimaryFillHover}" />
        </Style>

        <Style Selector="^.accent">
            <Setter Property="Background" Value="{DynamicResource V2AccentFill}" />
            <Setter Property="Foreground" Value="{DynamicResource V2OnAccent}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="^.accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource V2AccentShadow}" />
        </Style>
        <Style Selector="^.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource V2AccentFillHover}" />
        </Style>
        <!--  Disabled solid buttons go grey and flat; a faded accent with its glow read as "loading".
              After the .accent and .primary blocks, so these win.  -->
        <Style Selector="^.accent:disabled, ^.primary:disabled">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{DynamicResource V2Neutral}" />
            <Setter Property="Foreground" Value="{DynamicResource V2Faint}" />
        </Style>
        <Style Selector="^.accent:disabled /template/ ContentPresenter#PART_ContentPresenter, ^.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="none" />
        </Style>

        <Style Selector="^.disconnect">
            <Setter Property="Background" Value="{DynamicResource V2NeutralFill}" />
            <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="^.disconnect /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource V2NeutralShadow}" />
        </Style>
        <Style Selector="^.disconnect:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource V2NeutralFillHover}" />
        </Style>

        <!--  Secondary buttons are raised white keys (light) or lifted slate (dark), not flat grey.  -->
        <Style Selector="^.subtle">
            <Setter Property="Background" Value="{DynamicResource V2NeutralFill}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="^.subtle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource V2NeutralShadow}" />
        </Style>
        <Style Selector="^.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource V2NeutralFillHover}" />
        </Style>

        <Style Selector="^.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="^.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource V2Hover}" />
        </Style>

        <Style Selector="^.icon">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="^.small">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="^.tiny">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
        </Style>
        <Style Selector="^.tiny:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
        </Style>
        <Style Selector="^.tiny.testing">
            <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
            <Setter Property="Background" Value="{DynamicResource V2Hover}" />
        </Style>
        <!--  A tiny call to action keeps the accent's text colour; muted text would sink into the fill.  -->
        <Style Selector="^.accent.tiny">
            <Setter Property="Foreground" Value="{DynamicResource V2OnAccent}" />
        </Style>
        <Style Selector="^.accent.tiny:disabled">
            <Setter Property="Foreground" Value="{DynamicResource V2Faint}" />
        </Style>
        <Style Selector="^.small.icon">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource V2FocusShadow}" />
        </Style>
    </ControlTheme>

    <!--  Sidebar navigation entries: the selected one lifts into a white chip.  -->
    <ControlTheme x:Key="V2NavItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="PART_Chip"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Chip">
            <Setter Property="Background" Value="{DynamicResource V2Hover}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Chip">
            <Setter Property="Background" Value="{DynamicResource V2ChipFill}" />
            <Setter Property="BoxShadow" Value="{DynamicResource V2ChipShadow}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Chip">
            <Setter Property="BoxShadow" Value="{DynamicResource V2FocusShadow}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="V2NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource V2NavItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  Server rows.  -->
    <ControlTheme x:Key="V2RowItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="6,1" />
        <Setter Property="MinHeight" Value="54" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="PART_Row"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Row">
            <Setter Property="Background" Value="{DynamicResource V2Hover}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Row">
            <Setter Property="Background" Value="{DynamicResource V2RowSelected}" />
            <Setter Property="BorderBrush" Value="{DynamicResource V2RowSelectedBorder}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Row">
            <Setter Property="BoxShadow" Value="{DynamicResource V2FocusShadow}" />
        </Style>
    </ControlTheme>

    <!--  Segmented control (system proxy mode).  -->
    <ControlTheme x:Key="V2SegmentItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="PART_Chip"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
        </Style>
        <!--  The selected chip is drawn by the segmented control's sliding thumb (see SegmentThumb).  -->
        <Style Selector="^:focus-visible /template/ Border#PART_Chip">
            <Setter Property="BoxShadow" Value="{DynamicResource V2FocusShadow}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="V2Segmented" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource V2CardMutedBackground}" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusSegment}" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource V2SegmentItem}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Panel>
                        <!--  A Canvas measures as nothing: the thumb, sized to the selected item, must not keep the
                              control at an old height when the items get lower (Appearance → Tabs).  -->
                        <Canvas>
                            <Border
                                Name="PART_Thumb"
                                Background="{DynamicResource V2Selected}"
                                BoxShadow="{DynamicResource V2NavShadow}"
                                IsHitTestVisible="False"
                                IsVisible="False" />
                        </Canvas>
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  Sidebar rows: full-width, quiet until hovered; the active server keeps a soft fill.  -->
    <ControlTheme x:Key="V2SideRow" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusRow}" />
        <Setter Property="Padding" Value="10,0,6,0" />
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <!--  The theme keeps BorderThickness 0, so only rows that ask for an outline (route options) get one.  -->
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    Padding="{TemplateBinding Padding}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Content="{TemplateBinding Content}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Foreground="{TemplateBinding Foreground}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource V2Hover}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource V2Pressed}" />
        </Style>
        <Style Selector="^.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource V2ChipFill}" />
            <Setter Property="BoxShadow" Value="{DynamicResource V2ChipShadow}" />
        </Style>
        <Style Selector="^.indent">
            <Setter Property="Padding" Value="22,0,6,0" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource V2FocusShadow}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="V2PlainItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    CornerRadius="{DynamicResource V2RadiusRow}" />
            </ControlTemplate>
        </Setter>
        <!--  Arrow keys move through the list items; the focused one gets the ring and a soft fill.  -->
        <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource V2FocusShadow}" />
            <Setter Property="Background" Value="{DynamicResource V2Hover}" />
        </Style>
    </ControlTheme>

    <!--  Feature tiles on the map.  -->
    <ControlTheme x:Key="V2RailTile" TargetType="Button">
        <Setter Property="Width" Value="88" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="4,8" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusFloatingInner}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    Padding="{TemplateBinding Padding}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Background="{TemplateBinding Background}"
                    Content="{TemplateBinding Content}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Foreground="{TemplateBinding Foreground}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource V2Hover}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource V2Pressed}" />
        </Style>
        <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource V2FocusShadow}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="V2RailToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="88" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="4,8" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusFloatingInner}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    Padding="{TemplateBinding Padding}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Background="{TemplateBinding Background}"
                    Content="{TemplateBinding Content}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Foreground="{TemplateBinding Foreground}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource V2Hover}" />
        </Style>
        <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource V2SafeSoft}" />
        </Style>
        <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource V2FocusShadow}" />
        </Style>
    </ControlTheme>

    <!--  Window caption buttons (the app draws its own title bar).  -->
    <ControlTheme x:Key="V2Caption" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Background="{TemplateBinding Background}"
                    Content="{TemplateBinding Content}"
                    Foreground="{TemplateBinding Foreground}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource V2Hover}" />
        </Style>
        <Style Selector="^.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!--  Pressed feedback like the native caption buttons.  -->
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource V2Pressed}" />
        </Style>
        <Style Selector="^.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#A32A1E" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource V2FocusShadow}" />
        </Style>
    </ControlTheme>

    <!--
        Dialog tabs: pills on a soft track, the selected one lifted like the sidebar tabs.
        The page itself sits in a raised card, so every tabbed dialog gets the same frame.
    -->
    <ControlTheme x:Key="V2TabItem" TargetType="TabItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="PART_Chip"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        Padding="{TemplateBinding Padding}"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Header}"
                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                        Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_Chip">
            <Setter Property="Background" Value="{DynamicResource V2Hover}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Chip">
            <Setter Property="Background" Value="{DynamicResource V2ChipFill}" />
            <Setter Property="BoxShadow" Value="{DynamicResource V2ChipShadow}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Chip">
            <Setter Property="BoxShadow" Value="{DynamicResource V2FocusShadow}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="V2TabControl" TargetType="TabControl">
        <Setter Property="ItemContainerTheme" Value="{StaticResource V2TabItem}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <Border
                        Name="PART_TabStrip"
                        Margin="0,0,0,12"
                        Padding="4"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource V2TabTrack}"
                        CornerRadius="14"
                        DockPanel.Dock="Top">
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>
                    <Border Classes="formcard">
                        <ContentPresenter
                            Name="PART_SelectedContentHost"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </Border>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--  Toasts. Semi's card bounces in for 450 ms and flies 800 px away for 750 ms; V2pn's settles in
          260 ms (ease-out, short rise) and leaves in 180 ms with a small slide. The still variant is used
          when Windows animations are off: it only has to raise IsClosed.  -->
    <ControlTheme x:Key="V2ToastMotion" TargetType="NotificationCard">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="{DynamicResource NotificationCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NotificationCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource NotificationCardCornerRadius}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="NotificationCard">
                <LayoutTransformControl Name="PART_LayoutTransformControl" UseRenderTransform="True">
                    <Border
                        Margin="{DynamicResource NotificationCardMargin}"
                        Padding="{DynamicResource NotificationCardPadding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BoxShadow="{DynamicResource NotificationCardBoxShadows}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentControl
                            Name="PART_Content"
                            MinWidth="{DynamicResource NotificationCardMinWidth}"
                            Content="{TemplateBinding Content}">
                            <ContentControl.DataTemplates>
                                <DataTemplate DataType="x:String">
                                    <TextBlock Classes="toastmsg" Text="{Binding}" />
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>
                    </Border>
                </LayoutTransformControl>
            </ControlTemplate>
        </Setter>
        <ControlTheme.Animations>
            <Animation Easing="0.32,0.72,0,1" FillMode="Forward" Duration="0:0:0.26">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="12" />
                    <Setter Property="ScaleTransform.ScaleX" Value="0.97" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.97" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                    <Setter Property="ScaleTransform.ScaleX" Value="1" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
            </Animation>
        </ControlTheme.Animations>
        <Style Selector="^[IsClosing=true]">
            <Style.Animations>
                <Animation Easing="CubicEaseIn" FillMode="Forward" Duration="0:0:0.18">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="24" />
                        <Setter Property="IsClosed" Value="True" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="V2ToastStill" TargetType="NotificationCard">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="{DynamicResource NotificationCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NotificationCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource NotificationCardCornerRadius}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="NotificationCard">
                <LayoutTransformControl Name="PART_LayoutTransformControl" UseRenderTransform="True">
                    <Border
                        Margin="{DynamicResource NotificationCardMargin}"
                        Padding="{DynamicResource NotificationCardPadding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BoxShadow="{DynamicResource NotificationCardBoxShadows}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentControl
                            Name="PART_Content"
                            MinWidth="{DynamicResource NotificationCardMinWidth}"
                            Content="{TemplateBinding Content}">
                            <ContentControl.DataTemplates>
                                <DataTemplate DataType="x:String">
                                    <TextBlock Classes="toastmsg" Text="{Binding}" />
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>
                    </Border>
                </LayoutTransformControl>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[IsClosing=true]">
            <Style.Animations>
                <Animation FillMode="Forward" Duration="0:0:0.01">
                    <KeyFrame Cue="100%">
                        <Setter Property="IsClosed" Value="True" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

    <!--  Switch: a 44x26 track with an even 3 px inset around a 20 px knob. Replaces Semi's (an 18 px
          knob in a 24 px track looked squashed). ToggleSwitch moves PART_MovingKnobs by the width of
          PART_SwitchKnob, so that canvas is exactly the knob's travel (38 inner - 20 knob = 18).
          The knob slide and the track fade live in V2pnMotion.axaml, so they stop when motion is off;
          set here, in the template, they would outrank that file and always run.  -->
    <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ToggleSwitch">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border
                        Name="PART_Track"
                        Width="44"
                        Height="26"
                        Padding="3"
                        Background="{DynamicResource ToggleSwitchContainerUnCheckedDefaultBackground}"
                        BoxShadow="{DynamicResource V2SwitchTrackShadow}"
                        CornerRadius="13"
                        TemplatedControl.IsTemplateFocusTarget="True">
                        <Canvas
                            Name="PART_SwitchKnob"
                            Width="18"
                            Height="20"
                            HorizontalAlignment="Left">
                            <Panel Name="PART_MovingKnobs" Width="20" Height="20">
                                <Border
                                    Name="PART_Knob"
                                    Background="White"
                                    BoxShadow="{DynamicResource ToggleSwitchIndicatorBoxShadow}"
                                    CornerRadius="10" />
                            </Panel>
                        </Canvas>
                    </Border>
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        VerticalAlignment="Center"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Track">
            <Setter Property="Background" Value="{DynamicResource ToggleSwitchContainerUnCheckedPointeroverBackground}" />
        </Style>
        <Style Selector="^:checked /template/ Border#PART_Track">
            <Setter Property="Background" Value="{DynamicResource ToggleSwitchContainerCheckedDefaultBackground}" />
        </Style>
        <Style Selector="^:checked:pointerover /template/ Border#PART_Track">
            <Setter Property="Background" Value="{DynamicResource ToggleSwitchContainerCheckedPointeroverBackground}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Knob">
            <Setter Property="Opacity" Value="0.92" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Track">
            <Setter Property="BoxShadow" Value="{DynamicResource V2FocusShadow}" />
        </Style>
    </ControlTheme>

    <!--  A server in a list you pick from: quiet until hovered, a soft fill and a ticked box once picked.  -->
    <ControlTheme x:Key="V2PickItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusRow}" />
        <Setter Property="Padding" Value="10,0,8,0" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    Padding="{TemplateBinding Padding}"
                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource V2Hover}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource V2RowSelected}" />
            <Setter Property="BorderBrush" Value="{DynamicResource V2RowSelectedBorder}" />
        </Style>
        <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource V2FocusShadow}" />
        </Style>
    </ControlTheme>

    <!--  One of a few choices in a wrapping row of pills (the subscriptions above a server list).  -->
    <ControlTheme x:Key="V2ChipItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="{DynamicResource V2NeutralFill}" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    Padding="{TemplateBinding Padding}"
                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                    Background="{TemplateBinding Background}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Foreground="{TemplateBinding Foreground}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource V2NeutralFillHover}" />
            <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource V2AccentFill}" />
            <Setter Property="Foreground" Value="{DynamicResource V2OnAccent}" />
        </Style>
        <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="{DynamicResource V2FocusShadow}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
