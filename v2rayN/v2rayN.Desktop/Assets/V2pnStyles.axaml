<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:common="using:v2rayN.Desktop.Common"
    xmlns:views="using:v2rayN.Desktop.Views">

    <!--  Surfaces  -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource V2CardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource V2Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusCard}" />
        <Setter Property="BoxShadow" Value="{DynamicResource V2CardShadow}" />
    </Style>
    <Style Selector="Border.well">
        <Setter Property="Background" Value="{DynamicResource V2CardMutedBackground}" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusRow}" />
    </Style>
    <Style Selector="Border.hairline">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource V2Border}" />
    </Style>

    <!--  Type  -->
    <Style Selector="TextBlock.display">
        <Setter Property="FontFamily" Value="{DynamicResource V2DisplayFont}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
        <Setter Property="LetterSpacing" Value="-0.4" />
    </Style>
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="LineHeight" Value="40" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="LineHeight" Value="28" />
    </Style>
    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="19" />
    </Style>
    <!--  The connection header (country or server name), with .display.  -->
    <Style Selector="TextBlock.hdr">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.4" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
    </Style>
    <!--  V2Faint is about 3:1: for icons, chevrons, placeholders and disabled text, never for copy someone reads.  -->
    <Style Selector="TextBlock.faint">
        <Setter Property="Foreground" Value="{DynamicResource V2Faint}" />
    </Style>
    <Style Selector="TextBlock.small">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.num">
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>

    <!--  Latency pill. Tier classes are set from the delay value.  -->
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusPill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinWidth" Value="62" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource V2PingNoneSoft}" />
    </Style>
    <Style Selector="Border.pill TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource V2PingNone}" />
    </Style>
    <Style Selector="Border.pill.good">
        <Setter Property="Background" Value="{DynamicResource V2PingGoodSoft}" />
    </Style>
    <Style Selector="Border.pill.good TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource V2PingGood}" />
    </Style>
    <Style Selector="Border.pill.mid">
        <Setter Property="Background" Value="{DynamicResource V2PingMidSoft}" />
    </Style>
    <Style Selector="Border.pill.mid TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource V2PingMid}" />
    </Style>
    <Style Selector="Border.pill.bad">
        <Setter Property="Background" Value="{DynamicResource V2PingBadSoft}" />
    </Style>
    <Style Selector="Border.pill.bad TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource V2PingBad}" />
    </Style>

    <Style Selector="Ellipse.dot">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="{DynamicResource V2PingNone}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.dot.good">
        <Setter Property="Fill" Value="{DynamicResource V2PingGood}" />
    </Style>
    <Style Selector="Ellipse.dot.mid">
        <Setter Property="Fill" Value="{DynamicResource V2PingMid}" />
    </Style>
    <Style Selector="Ellipse.dot.bad">
        <Setter Property="Fill" Value="{DynamicResource V2PingBad}" />
    </Style>
    <Style Selector="Ellipse.dot.live">
        <Setter Property="Fill" Value="{DynamicResource V2Accent}" />
    </Style>

    <!--  Small labelled tags (protocol, transport, "active").  -->
    <Style Selector="Border.tag">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource V2CardMutedBackground}" />
    </Style>
    <Style Selector="Border.tag TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
    </Style>
    <Style Selector="Border.tag.live">
        <Setter Property="Background" Value="{DynamicResource V2AccentSoft}" />
    </Style>
    <Style Selector="Border.tag.live TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource V2Accent}" />
    </Style>
    <Style Selector="Border.tag.folder">
        <Setter Property="Background" Value="{DynamicResource V2FolderSoft}" />
    </Style>
    <Style Selector="Border.tag.folder TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource V2Folder}" />
    </Style>

    <!--  Protocol monogram tile at the start of each row.  -->
    <Style Selector="Border.mono">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{DynamicResource V2CardMutedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource V2Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.mono TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.3" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.mono.live">
        <Setter Property="Background" Value="{DynamicResource V2AccentSoft}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.mono.live TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource V2Accent}" />
    </Style>

    <!--  Star toggle  -->
    <Style Selector="Button.star PathIcon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource V2Faint}" />
    </Style>
    <Style Selector="Button.star:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource V2Star}" />
    </Style>
    <Style Selector="Button.star.on PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource V2Star}" />
    </Style>

    <Style Selector="PathIcon.i14">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="PathIcon.i16">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="Button PathIcon">
        <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="ListBoxItem PathIcon.nav">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
    </Style>
    <Style Selector="ListBoxItem:selected PathIcon.nav">
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
    </Style>

    <!--  Settings navigation: links to the windows of their own, shaped like the nav entries above them.  -->
    <Style Selector="TextBlock.navgroup">
        <Setter Property="Margin" Value="10,0,0,6" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource V2Faint}" />
    </Style>
    <Style Selector="Button.navlink">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
    </Style>
    <Style Selector="Button.navlink:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource V2Hover}" />
    </Style>
    <Style Selector="Button.navlink PathIcon.nav">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
    </Style>
    <Style Selector="Button.navlink PathIcon.navopen">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource V2Faint}" />
    </Style>
    <Style Selector="Button.navlink:pointerover PathIcon.navopen, Button.navlink:focus-visible PathIcon.navopen">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!--  Search field  -->
    <Style Selector="TextBox.search">
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusControl}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="{DynamicResource V2CardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource V2Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  Floating cards over the map  -->
    <Style Selector="Border.floating">
        <Setter Property="Background" Value="{DynamicResource V2FloatingFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource V2PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusFloating}" />
        <Setter Property="BoxShadow" Value="{DynamicResource V2RaisedShadow}" />
    </Style>

    <Style Selector="TextBlock.ping">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="Foreground" Value="{DynamicResource V2PingNone}" />
    </Style>
    <Style Selector="TextBlock.ping.good">
        <Setter Property="Foreground" Value="{DynamicResource V2PingGood}" />
    </Style>
    <Style Selector="TextBlock.ping.mid">
        <Setter Property="Foreground" Value="{DynamicResource V2PingMid}" />
    </Style>
    <Style Selector="TextBlock.ping.bad">
        <Setter Property="Foreground" Value="{DynamicResource V2PingBad}" />
    </Style>

    <Style Selector="PathIcon.chevron">
        <Setter Property="Foreground" Value="{DynamicResource V2Faint}" />
        <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>
    <Style Selector="PathIcon.chevron.open">
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>

    <Style Selector="Button.kebab">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.siderow:pointerover Button.kebab">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="PathIcon.rail">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
    </Style>
    <Style Selector="ToggleButton:checked PathIcon.rail">
        <Setter Property="Foreground" Value="{DynamicResource V2Safe}" />
    </Style>
    <Style Selector="TextBlock.rail">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        The v2rayN dialogs (settings, server editor, routing, DNS, subscriptions) keep their
        layouts; these give them the V2pn surface and make the confirm action the solid one.
    -->
    <Style Selector=":is(Window)">
        <Setter Property="Background" Value="{DynamicResource V2DialogBackground}" />
    </Style>

    <!--  Section card: forms, tab pages and tables sit on a raised, rounded surface.  -->
    <Style Selector="Border.formcard">
        <Setter Property="Background" Value="{DynamicResource V2ChipFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource V2PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusCard}" />
        <Setter Property="BoxShadow" Value="{DynamicResource V2CardShadow}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector=":is(Window).dialog > DockPanel > Border.formcard, :is(Window).dialog > DockPanel > TabControl">
        <Setter Property="Margin" Value="16,14,16,14" />
    </Style>
    <Style Selector=":is(Window).dialog > dialogHost|DialogHost > DockPanel > Border.formcard">
        <Setter Property="Margin" Value="16,14,16,14" />
    </Style>
    <!--  Tables fill their card edge to edge; the card clips them to its corners.  -->
    <Style Selector="Border.formcard.table">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!--  The card is the table's frame; the grid's own border would draw a second one.  -->
    <Style Selector=":is(Window).dialog DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <!--  Room for two-line cells (long subscription URLs) and an easier click target.  -->
        <Setter Property="RowHeight" Value="44" />
    </Style>

    <!--  Form text: labels in ink, the explanatory third column muted and smaller.  -->
    <!--  Tab pages are logical children of the TabItem, not of the card in its template, so these key off the dialog.  -->
    <Style Selector=":is(Window).dialog TextBlock[TextWrapping=Wrap]:not(.message), UserControl Border.formcard TextBlock[TextWrapping=Wrap]">
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="17" />
    </Style>

    <!--  Menus used as toolbars above tables: each top-level item is a raised key.  -->
    <Style Selector=":is(Window).dialog Menu">
        <Setter Property="Margin" Value="16,14,16,2" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector=":is(Window).dialog Menu > MenuItem">
        <Setter Property="Background" Value="{DynamicResource V2NeutralFill}" />
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector=":is(Window).dialog Menu > MenuItem:pointerover /template/ Border">
        <Setter Property="Background" Value="{DynamicResource V2NeutralFillHover}" />
    </Style>


    <!--  Buttons inside dialog forms: raised neutral keys, like the main window's secondary actions.  -->
    <!--  Not the Settings navigation links: they are nav entries, flat like the list above them. Not
          "plain" ones either: row actions (up, down, remove) keep their own V2Button look.  -->
    <Style Selector=":is(Window).dialog Button:not(.IconButton):not(.navlink):not(.plain), UserControl Border.formcard Button:not(.IconButton)">
        <Setter Property="Theme" Value="{StaticResource V2Button}" />
        <Setter Property="Background" Value="{DynamicResource V2NeutralFill}" />
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector=":is(Window).dialog Button:not(.IconButton):not(.navlink):not(.plain) /template/ ContentPresenter#PART_ContentPresenter, UserControl Border.formcard Button:not(.IconButton) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource V2NeutralShadow}" />
    </Style>
    <Style Selector=":is(Window).dialog Button:not(.IconButton):not(.navlink):not(.plain):pointerover /template/ ContentPresenter#PART_ContentPresenter, UserControl Border.formcard Button:not(.IconButton):pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource V2NeutralFillHover}" />
    </Style>

    <!--  Footer: a quiet strip with the actions on the right, primary last-but-glossy.  -->
    <Style Selector="Border.dialogfooter">
        <Setter Property="Background" Value="{DynamicResource V2FooterBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource V2PanelBorder}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="Border.dialogfooter StackPanel.footer">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="Border.dialogfooter Button">
        <Setter Property="Theme" Value="{StaticResource V2Button}" />
        <Setter Property="MinWidth" Value="110" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{DynamicResource V2NeutralFill}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.dialogfooter Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource V2NeutralShadow}" />
    </Style>
    <Style Selector="Border.dialogfooter Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource V2NeutralFillHover}" />
    </Style>
    <Style Selector="Border.dialogfooter Button.primary">
        <Setter Property="Background" Value="{DynamicResource V2PrimaryFill}" />
        <Setter Property="Foreground" Value="{DynamicResource V2OnPrimary}" />
    </Style>
    <Style Selector="Border.dialogfooter Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource V2PrimaryShadow}" />
    </Style>
    <Style Selector="Border.dialogfooter Button[IsDefault=True]">
        <Setter Property="Background" Value="{DynamicResource V2PrimaryFill}" />
        <Setter Property="Foreground" Value="{DynamicResource V2OnPrimary}" />
    </Style>
    <Style Selector="Border.dialogfooter Button[IsDefault=True] /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource V2PrimaryShadow}" />
    </Style>
    <Style Selector="Border.dialogfooter Button[IsDefault=True]:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource V2PrimaryFillHover}" />
    </Style>
    <!--  A destructive answer ("Delete") reads as one: red under every accent, not the glossy primary.  -->
    <Style Selector="Border.dialogfooter Button.danger, Border.dialogfooter Button.danger[IsDefault=True]">
        <Setter Property="Background" Value="{DynamicResource V2DangerFill}" />
        <Setter Property="Foreground" Value="{DynamicResource V2OnDanger}" />
    </Style>
    <Style Selector="Border.dialogfooter Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource V2DangerFillHover}" />
    </Style>

    <!--  Sidebar rows: secondary actions appear on hover or keyboard focus; a set favorite stays visible.  -->
    <Style Selector="Button.siderow Button.reveal">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.siderow:pointerover Button.reveal, Button.siderow Button.reveal:focus-visible, Button.siderow Button.reveal.on">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.siderow:pointerover Button.reveal:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!--  Server picker and group members (ProfilesSelectWindow, AddGroupServerWindow).  -->
    <Style Selector="ListBox.chips">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource V2ChipItem}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="Border.pickcheck">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="{DynamicResource V2BorderStrong}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pickcheck > Path">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource V2OnAccent}" />
        <Setter Property="StrokeThickness" Value="2.4" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.pickcheck">
        <Setter Property="Background" Value="{DynamicResource V2AccentFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource V2AccentFill}" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.pickcheck > Path">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <!--  Choosing one server needs no boxes: the row's fill says which.  -->
    <Style Selector="ListBox.single Border.pickcheck">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.memberrow">
        <Setter Property="Padding" Value="14,8,8,8" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource V2Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.memberrow.first">
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.memberrow Button.plain">
        <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Border.memberrow:pointerover Button.plain, Border.memberrow Button.plain:focus-visible">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.memberrow Button.plain:disabled">
        <Setter Property="Opacity" Value="0.2" />
    </Style>
    <Style Selector="Border.membernum">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{DynamicResource V2NeutralFill}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.membernum > TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Ellipse.badge">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="0,0,-3,-3" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Fill" Value="{DynamicResource V2Safe}" />
        <Setter Property="Stroke" Value="{DynamicResource V2SidebarBackground}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <Style Selector="Border.mono.sm">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Border.mono.sm TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="LetterSpacing" Value="0" />
    </Style>

    <Style Selector="PathIcon.i12">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <!--  Busy indicator: an arc that turns, only while it is shown (like the map pin halo in V2pnMotion.axaml).  -->
    <Style Selector="Path.spinner">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Data" Value="{StaticResource V2SpinnerArc}" />
        <Setter Property="Stroke" Value="{DynamicResource V2Muted}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="Path.spinner[IsVisible=True]">
        <Style.Animations>
            <Animation IterationCount="Infinite" Duration="0:0:0.9">
                <Animation.Easing>
                    <common:StepEasing Steps="24" />
                </Animation.Easing>
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Button Path.spinner">
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    </Style>

    <!--  Compact rows (Appearance → Rows): more servers fit on screen.  -->
    <Style Selector=":is(Window).dense Button.siderow">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Button.siderow StackPanel.rowactions">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.siderow:pointerover StackPanel.rowactions">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Button.siderow:pointerover Panel.rowinfo">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <!--  Hover-only actions stay out of the Tab order; the keyboard reaches them through the row's context menu.  -->
    <Style Selector="Button.siderow StackPanel.rowactions Button, Button.siderow Button.reveal">
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <!--  Result of a connection check.  -->
    <Style Selector="Border.check">
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusPill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.check TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="Border.check.ok">
        <Setter Property="Background" Value="{DynamicResource V2SafeSoft}" />
    </Style>
    <Style Selector="Border.check.ok TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource V2Safe}" />
    </Style>
    <Style Selector="Border.check.ok PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource V2Safe}" />
    </Style>
    <!--  A failed check is amber, the same as the "server not responding" pill: red means unprotected.  -->
    <Style Selector="Border.check.fail">
        <Setter Property="Background" Value="{DynamicResource V2PingMidSoft}" />
    </Style>
    <Style Selector="Border.check.fail TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource V2PingMid}" />
    </Style>
    <Style Selector="Border.check.fail PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource V2PingMid}" />
    </Style>

    <!--  Protection state pill in the connection header.  -->
    <Style Selector="Border.state">
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusPill}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #14FFFFFF" />
        <Setter Property="Background" Value="{DynamicResource V2Hover}" />
    </Style>
    <Style Selector="Border.state TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.6" />
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
    </Style>
    <Style Selector="Border.state Ellipse.statedot">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource V2Muted}" />
    </Style>
    <Style Selector="Border.state.safe">
        <Setter Property="Background" Value="{DynamicResource V2SafeSoft}" />
    </Style>
    <Style Selector="Border.state.safe TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource V2Safe}" />
    </Style>
    <Style Selector="Border.state.safe Ellipse.statedot">
        <Setter Property="Fill" Value="{DynamicResource V2Safe}" />
    </Style>
    <Style Selector="Border.state.unsafe">
        <Setter Property="Background" Value="{DynamicResource V2UnsafeSoft}" />
    </Style>
    <Style Selector="Border.state.unsafe TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource V2Unsafe}" />
    </Style>
    <Style Selector="Border.state.unsafe Ellipse.statedot">
        <Setter Property="Fill" Value="{DynamicResource V2Unsafe}" />
    </Style>
    <Style Selector="Border.state.warn">
        <Setter Property="Background" Value="{DynamicResource V2PingMidSoft}" />
    </Style>
    <Style Selector="Border.state.warn TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource V2PingMid}" />
    </Style>
    <Style Selector="Border.state.warn Ellipse.statedot">
        <Setter Property="Fill" Value="{DynamicResource V2PingMid}" />
    </Style>
    <Style Selector="Border.state.checking Path.spinner">
        <Setter Property="Stroke" Value="{DynamicResource V2InkSoft}" />
    </Style>

    <!--  Countries with servers on the map.  -->
    <Style Selector="Ellipse.mapdot">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="Fill" Value="{DynamicResource V2MapDot}" />
        <Setter Property="Stroke" Value="{DynamicResource V2MapOcean}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!--  Each dot sits in a 24 px hit area (MapView), so it is easy to point at; hovering the area lights the dot.  -->
    <Style Selector="Panel.mapdothit:pointerover > Ellipse.mapdot">
        <Setter Property="Fill" Value="{DynamicResource V2Ink}" />
        <Setter Property="RenderTransform" Value="scale(1.5)" />
    </Style>

    <!--  Sidebar rows are mouse targets; keyboard focus stays on the list item around them.  -->
    <Style Selector="ListBox Button.siderow">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!--  Secondary pages (log, Clash): padded, a toolbar of raised keys, content in a card.  -->
    <Style Selector="DockPanel.page">
        <Setter Property="Margin" Value="16,12,16,16" />
    </Style>
    <Style Selector="WrapPanel.toolbar">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="ItemSpacing" Value="8" />
        <Setter Property="LineSpacing" Value="8" />
    </Style>
    <Style Selector="WrapPanel.toolbar > :is(Control)">
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="WrapPanel.toolbar Button">
        <Setter Property="Theme" Value="{StaticResource V2Button}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource V2NeutralFill}" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="WrapPanel.toolbar Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource V2NeutralShadow}" />
    </Style>
    <Style Selector="WrapPanel.toolbar Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource V2NeutralFillHover}" />
    </Style>
    <Style Selector="DockPanel.page > Border.formcard">
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="DockPanel.page DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--
        Settings kit: a navigation column, pages with a title, and rounded groups of rows.
        A row is a title with an optional hint on the left and its control on the right
        (or below, for wide inputs: Border.srow.stack).
    -->
    <Style Selector="Border.settingsnav">
        <Setter Property="Background" Value="{DynamicResource V2SidebarFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource V2PanelBorder}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style Selector="TextBlock.spagetitle">
        <Setter Property="FontFamily" Value="{DynamicResource V2DisplayFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
    </Style>
    <Style Selector="TextBlock.spagehint">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
        <Setter Property="Margin" Value="0,4,0,2" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!--  One page padding for every dialog: a whole page of groups (spagebody), or the title and hint
          above a table, tabs or editor (spagehead). Tables and tab controls in dialogs sit at 16 px, and
          the tab pages pad their content by 12, so everything below the title also starts at 28.  -->
    <Style Selector="StackPanel.spagebody">
        <Setter Property="Margin" Value="28,20,28,28" />
        <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="StackPanel.spagehead">
        <Setter Property="Margin" Value="28,20,28,4" />
        <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="TextBlock.sgrouplabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
        <Setter Property="Margin" Value="4,22,0,8" />
    </Style>
    <Style Selector="TextBlock.sgroupnote">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
        <Setter Property="Margin" Value="4,8,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!--  A JSON editor with its caption: the same card as a settings group, the caption above it.  -->
    <Style Selector="HeaderedContentControl.editor">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <TextBlock
                        Margin="4,0,0,8"
                        DockPanel.Dock="Top"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource V2Muted}"
                        Text="{TemplateBinding Header}" />
                    <Border
                        Padding="4,8"
                        Background="{DynamicResource V2ChipFill}"
                        BorderBrush="{DynamicResource V2PanelBorder}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        CornerRadius="{DynamicResource V2RadiusRow}">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Border.sgroupcard">
        <Setter Property="Background" Value="{DynamicResource V2ChipFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource V2PanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusTile}" />
        <Setter Property="BoxShadow" Value="{DynamicResource V2CardShadow}" />
    </Style>
    <Style Selector="Border.srow">
        <Setter Property="Padding" Value="16,11" />
        <Setter Property="MinHeight" Value="54" />
        <Setter Property="BorderBrush" Value="{DynamicResource V2Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <!--  No hairline above the first row a card shows. nth-child counts hidden rows too, so the settings
          dialogs tag the first visible row (SettingsKit.MarkFirst); nth-child stays for the pages that
          never hide a row and don't run the kit.  -->
    <Style Selector="Border.srow:nth-child(1), Border.srow.first">
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.srow > Grid">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.srowtitle">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.srowhint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.srowhint.warn">
        <Setter Property="Foreground" Value="{DynamicResource V2Unsafe}" />
    </Style>
    <Style Selector="Border.srow StackPanel.srowtext">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,24,0" />
    </Style>
    <Style Selector="Border.srow ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.srow ComboBox, Border.srow TextBox, Border.srow NumericUpDown">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel.srowctl > TextBox, Panel.srowctl > ComboBox, Panel.srowctl > NumericUpDown, Panel.srowctl > StackPanel > TextBox, Panel.srowctl > StackPanel > ComboBox">
        <Setter Property="Width" Value="280" />
    </Style>
    <Style Selector="Border.srow.stack TextBox, Border.srow.stack ComboBox">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <!--  Tab pages that already hold settings groups don't need the page card around them.  -->
    <Style Selector="TabControl.plain /template/ Border.formcard">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BoxShadow" Value="none" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.srow.hidden, Border.srow.collapsed, Border.srow.nomatch, StackPanel.sgroup.nomatch, StackPanel.spage.nomatch">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!--  Connection bar under the Connect button: mode segments and the routing chip.  -->
    <Style Selector="Border.modebar">
        <Setter Property="Padding" Value="5" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusBar}" />
    </Style>
    <Style Selector="ListBox.mode">
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusBarInner}" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="ListBox.mode > ListBoxItem">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusSegment}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ListBox.mode > ListBoxItem:selected PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource V2Safe}" />
    </Style>
    <Style Selector="Border.vsep">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="2,8" />
        <Setter Property="Background" Value="{DynamicResource V2Border}" />
    </Style>
    <Style Selector="Button.routechip">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="12,0,10,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusBarInner}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <!--  Captions over the two halves of the connection bar.  -->
    <Style Selector="TextBlock.barcaption">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
        <Setter Property="Margin" Value="8,2,0,0" />
    </Style>
    <Style Selector="PathIcon.adminlock">
        <Setter Property="Foreground" Value="{DynamicResource V2Faint}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!--  Connect: a power glyph next to the label; when connected the glyph takes the verdict's colour
          (green when protected, amber when the server doesn't answer or only the local port is on).  -->
    <Style Selector="Button.connectbtn PathIcon">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
    </Style>
    <Style Selector="Button.connectbtn.disconnect.safe PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource V2Safe}" />
    </Style>
    <Style Selector="Button.connectbtn.disconnect.warn PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource V2PingMid}" />
    </Style>
    <Style Selector="Border.adminbadge">
        <Setter Property="Background" Value="{DynamicResource V2PingMidSoft}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.adminbadge > TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource V2PingMid}" />
    </Style>
    <Style Selector="Border.recommend">
        <Setter Property="Background" Value="{DynamicResource V2SafeSoft}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.recommend > TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource V2Safe}" />
    </Style>
    <!--  Route presets sit straight on the menu, with no well or grey chip behind the picked one: an
          accent icon tile and a filled radio mark the choice, and only hover tints a row.  -->
    <Style Selector="Border.routegroup">
        <Setter Property="Margin" Value="-4,0" />
    </Style>
    <Style Selector="Button.routeoption">
        <Setter Property="Padding" Value="8,10,12,10" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.routeoption.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
    </Style>
    <Style Selector="Button.routeoption.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource V2Hover}" />
    </Style>
    <!--  A 32 px icon column shared by the presets, the extras and the settings row, so labels line up.  -->
    <Style Selector="Border.routeicon">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusIconTile}" />
        <Setter Property="Background" Value="{DynamicResource V2Selected}" />
    </Style>
    <Style Selector="Border.routeicon > PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
    </Style>
    <Style Selector="Button.routeoption.active Border.routeicon">
        <Setter Property="Background" Value="{DynamicResource V2AccentSoft}" />
    </Style>
    <Style Selector="Button.routeoption.active Border.routeicon > PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource V2Accent}" />
    </Style>
    <Style Selector="Border.routeicon.plain">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel.routeradio">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.routering">
        <Setter Property="Stroke" Value="{DynamicResource V2Faint}" />
        <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="Button.routeoption.active Ellipse.routering">
        <Setter Property="Stroke" Value="{DynamicResource V2Accent}" />
    </Style>
    <Style Selector="Ellipse.routedot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource V2Accent}" />
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.routeoption.active Ellipse.routedot">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <!--  Extras and the settings row sit outside the well; their margin puts the icon column under the presets'.  -->
    <Style Selector="Grid.routeextra">
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>
    <Style Selector="Button.routelink">
        <Setter Property="Padding" Value="8,0,12,0" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="-4,0" />
    </Style>
    <Style Selector="PathIcon.routechevron">
        <Setter Property="Foreground" Value="{DynamicResource V2Faint}" />
    </Style>
    <Style Selector="TextBlock.routetitle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
    </Style>
    <Style Selector="TextBlock.routehint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
    </Style>
    <Style Selector="Border.routebusy">
        <Setter Property="Background" Value="{DynamicResource V2CardMutedBackground}" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusRow}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.routebusy TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
    </Style>
    <Style Selector="Border.routebusy PathIcon.routefail">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{DynamicResource V2PingMid}" />
    </Style>
    <!--  A heading one step below the 13/Medium option titles it introduces.  -->
    <Style Selector="TextBlock.sectionlabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
    </Style>

    <!--  Menus: icon column, quiet icons that light up with the row, section headers, destructive rows.  -->
    <Style Selector="MenuItem">
        <Setter Property="CornerRadius" Value="{DynamicResource MenuItemCornerRadius}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="MenuItem PathIcon.mi">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
    </Style>
    <Style Selector="MenuItem:pointerover PathIcon.mi, MenuItem:selected PathIcon.mi, MenuItem:open PathIcon.mi">
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
    </Style>
    <Style Selector="MenuItem.danger">
        <Setter Property="Foreground" Value="{DynamicResource V2Unsafe}" />
    </Style>
    <Style Selector="MenuItem.danger PathIcon.mi, MenuItem.danger:pointerover PathIcon.mi">
        <Setter Property="Foreground" Value="{DynamicResource V2Unsafe}" />
    </Style>
    <Style Selector="MenuItem.menuheader">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="10,8,10,3" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
    </Style>
    <Style Selector="MenuItem.menuheader /template/ PathIcon#PART_ExpandIcon">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="MenuItem.menuheader:disabled /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
    </Style>
    <!--  Two-line items: a title and a muted description (settings menu).  -->
    <Style Selector="MenuItem TextBlock.mititle">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="MenuItem TextBlock.midesc">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>

    <!--  Toasts: the card comes from Semi (keeps its enter/exit animation); V2pn supplies the content.  -->
    <Style Selector="NotificationCard">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource NotificationCardBorderBrush}" />
    </Style>
    <Style Selector="NotificationCard /template/ PathIcon#NotificationIcon">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.toastbadge">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="TextBlock.toasttitle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
    </Style>
    <Style Selector="TextBlock.toastmsg">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
    </Style>

    <!--  Rich menu rows: a coloured icon tile, a title and a short description.  -->
    <!--  Rich items (title + hint) carry a plain icon like every other menu, slightly larger.  -->
    <Style Selector="MenuItem.rich /template/ Viewbox#PART_IconPresenter">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="4,0,8,0" />
    </Style>
    <Style Selector="MenuItem.rich PathIcon.mi">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="MenuItem.rich">
        <Setter Property="Padding" Value="8,6,12,6" />
    </Style>
    <Style Selector="Border.mitile">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #40FFFFFF, 0 1 2 0 #33000000" />
    </Style>
    <Style Selector="Border.mitile > PathIcon">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="MenuItem.rich.danger /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource V2Unsafe}" />
    </Style>

    <!--  Sidebar view switch.  -->
    <Style Selector="ListBox.sidetabs">
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusBarInner}" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="ListBox.sidetabs > ListBoxItem">
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusSegment}" />
        <Setter Property="Padding" Value="6,0" />
    </Style>
    <Style Selector="ListBox.sidetabs > ListBoxItem TextBlock">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="ListBox.sidetabs > ListBoxItem:selected PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
    </Style>

    <!--  Tooltips match the menus: same surface, rounder, a little roomier.  -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource MenuFlyoutBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MenuFlyoutBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="320" />
    </Style>

    <!--  Subscriptions list: monogram tile, freshness dot, chevron that gives way to actions on hover.  -->
    <Style Selector="Button.subrow">
        <Setter Property="MinHeight" Value="56" />
    </Style>
    <Style Selector="Border.subtile">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusIconTile}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BoxShadow" Value="inset 0 1 0 0 #40FFFFFF, 0 1 2 0 #33000000" />
    </Style>
    <Style Selector="Border.subtile TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.subtile Path.spinner">
        <Setter Property="Stroke" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.fresh">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource V2PingNone}" />
    </Style>
    <Style Selector="Ellipse.fresh.ok">
        <Setter Property="Fill" Value="{DynamicResource V2Safe}" />
    </Style>
    <Style Selector="Ellipse.fresh.old">
        <Setter Property="Fill" Value="{DynamicResource V2PingMid}" />
    </Style>
    <!--  The last update brought nothing: the provider's site was unreachable or the link is wrong.  -->
    <Style Selector="Ellipse.fresh.failed">
        <Setter Property="Fill" Value="{DynamicResource V2PingBad}" />
    </Style>
    <Style Selector="TextBlock.subinfo.warn">
        <Setter Property="Foreground" Value="{DynamicResource V2PingMid}" />
    </Style>
    <!--  Sidebar section headers. With the subscription actions the 32 px buttons set the height themselves:
          negative margins used to squeeze them in, and the row below then covered their lower edge.  -->
    <Style Selector="Grid.sidehead">
        <Setter Property="Margin" Value="8,10,0,4" />
    </Style>
    <Style Selector="Grid.sidehead.subactions">
        <Setter Property="Margin" Value="8,6,0,0" />
    </Style>

    <!--  The chevron sits over the ⋮ button's centre; hit-testable, it took the click and opened the subscription.  -->
    <Style Selector="PathIcon.subchevron">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Margin" Value="4,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource V2Faint}" />
    </Style>
    <Style Selector="Button.subrow:pointerover PathIcon.subchevron">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.subrow Button.reveal">
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.subrow:pointerover Button.reveal">
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <!--  What the provider reports about a subscription: used traffic as a thin meter, and the expiry.
          Amber when it is running out, red when it has.  -->
    <Style Selector="Button.subrow.usage">
        <Setter Property="Padding" Value="10,9,6,10" />
    </Style>
    <Style Selector="StackPanel.subusage">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Spacing" Value="5" />
    </Style>
    <Style Selector="TextBlock.usage">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
    </Style>
    <Style Selector="TextBlock.usage.warn">
        <Setter Property="Foreground" Value="{DynamicResource V2PingMid}" />
    </Style>
    <Style Selector="TextBlock.usage.bad">
        <Setter Property="Foreground" Value="{DynamicResource V2PingBad}" />
    </Style>
    <Style Selector="views|UsageBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Fill" Value="{DynamicResource V2Folder}" />
        <Setter Property="Track" Value="{DynamicResource V2PingNoneSoft}" />
    </Style>
    <Style Selector="views|UsageBar.warn">
        <Setter Property="Fill" Value="{DynamicResource V2PingMid}" />
    </Style>
    <Style Selector="views|UsageBar.bad">
        <Setter Property="Fill" Value="{DynamicResource V2PingBad}" />
    </Style>
    <Style Selector="TextBlock.usagevalue">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFeatures" Value="+tnum" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
    </Style>
    <Style Selector="TextBlock.usagevalue.warn">
        <Setter Property="Foreground" Value="{DynamicResource V2PingMid}" />
    </Style>
    <Style Selector="TextBlock.usagevalue.bad">
        <Setter Property="Foreground" Value="{DynamicResource V2PingBad}" />
    </Style>
    <Style Selector="SelectableTextBlock.announce">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
    </Style>

    <!--  Settings: icon column on everyday rows, the simple/advanced switch under the navigation.  -->
    <Style Selector="Border.srowicon">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusIconTile}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource V2Hover}" />
    </Style>
    <Style Selector="Border.srowicon > PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
    </Style>
    <!--  Keeps an icon-less row's title on the same line as its neighbours in a card that mixes both.  -->
    <Style Selector="Border.srowicon.blank">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.advswitch">
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Padding" Value="12,10,8,10" />
        <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusRow}" />
        <Setter Property="Background" Value="{DynamicResource V2Hover}" />
    </Style>
    <Style Selector="Border.advswitch ToggleSwitch">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.advtitle">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
    </Style>
    <Style Selector="TextBlock.advhint">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource V2Faint}" />
    </Style>
    <Style Selector="Border.srow.advhidden, StackPanel.sgroup.advhidden, ListBoxItem.advhidden">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Button.morefields">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
    </Style>
    <Style Selector="Button.morefields:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource V2Hover}" />
    </Style>

    <!--  Focus: the input keeps its blue border and gets a soft halo, like the buttons' focus ring.  -->
    <Style Selector="TextBox:focus /template/ Border#PART_ContentPresenterBorder, TextBox:focus-within /template/ Border#PART_ContentPresenterBorder">
        <Setter Property="BoxShadow" Value="{DynamicResource V2InputFocusShadow}" />
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background, ComboBox:dropdownopen /template/ Border#Background">
        <Setter Property="BoxShadow" Value="{DynamicResource V2InputFocusShadow}" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="4,1" />
    </Style>

    <!--  A tab control with a single page doesn't need its strip.  -->
    <Style Selector="TabControl.single /template/ Border#PART_TabStrip">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!--  Caption buttons dim while the window is in the background, like a native title bar.  -->
    <Style Selector=":is(Window).inactive Button.caption">
        <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
    </Style>

    <!--  Keep this block last. Dialog, footer, form and toolbar buttons set their own BoxShadow on the
          presenter above, which outranks the V2Button theme's focus ring; restating the ring here, after
          them, keeps it visible when tabbing. New styles go above this block.  -->
    <Style Selector=":is(Window).dialog Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter, Border.dialogfooter Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter, UserControl Border.formcard Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter, WrapPanel.toolbar Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource V2FocusShadow}" />
    </Style>
</Styles>
