<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        V2pn tokens. Colours live in theme dictionaries so the whole app, the main window and
        the v2rayN dialogs alike, follows the theme picked in Appearance. Reference them with
        DynamicResource; a StaticResource would freeze the colour of the theme at load time.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="V2WindowBackground" Color="#0D0D10" />
            <SolidColorBrush x:Key="V2SidebarBackground" Color="#1C1C23" />
            <SolidColorBrush x:Key="V2ContentBackground" Color="#0E0E11" />
            <SolidColorBrush x:Key="V2CardBackground" Color="#1E1E25" />
            <SolidColorBrush x:Key="V2CardFloating" Color="#EB1E1E25" />
            <SolidColorBrush x:Key="V2CardMutedBackground" Color="#26262F" />
            <SolidColorBrush x:Key="V2Border" Color="#2A2A33" />
            <SolidColorBrush x:Key="V2BorderStrong" Color="#353541" />
            <SolidColorBrush x:Key="V2Hover" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="V2Pressed" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="V2Selected" Color="#16FFFFFF" />
            <SolidColorBrush x:Key="V2RowSelected" Color="#1F2A3D" />
            <SolidColorBrush x:Key="V2RowSelectedBorder" Color="#2C3F5E" />
            <SolidColorBrush x:Key="V2Ink" Color="#ECECF1" />
            <SolidColorBrush x:Key="V2InkSoft" Color="#C9C9D3" />
            <SolidColorBrush x:Key="V2Muted" Color="#9B9BA8" />
            <SolidColorBrush x:Key="V2Faint" Color="#8A8A96" />
            <SolidColorBrush x:Key="V2Accent" Color="#FF3D1F" />
            <SolidColorBrush x:Key="V2AccentHover" Color="#FF5A3F" />
            <SolidColorBrush x:Key="V2AccentSoft" Color="#33FF3D1F" />
            <SolidColorBrush x:Key="V2OnAccent" Color="#0B0B0D" />
            <SolidColorBrush x:Key="V2Primary" Color="#ECECF1" />
            <SolidColorBrush x:Key="V2PrimaryHover" Color="#FFFFFF" />
            <SolidColorBrush x:Key="V2OnPrimary" Color="#16161B" />
            <SolidColorBrush x:Key="V2Neutral" Color="#33343F" />
            <SolidColorBrush x:Key="V2NeutralHover" Color="#3D3E4A" />
            <SolidColorBrush x:Key="V2PinCore" Color="#FFFFFF" />
            <!--  Behind in-window dialogs. DialogHost fades its overlay to about half, so this reads as a
                  ~50 % dim over the dark map; Semi's grey wash barely changed it.  -->
            <SolidColorBrush x:Key="V2Scrim" Color="#E6000000" />
            <SolidColorBrush x:Key="V2Safe" Color="#3DD68C" />
            <SolidColorBrush x:Key="V2SafeSoft" Color="#263DD68C" />
            <SolidColorBrush x:Key="V2Unsafe" Color="#FF5A3D" />
            <SolidColorBrush x:Key="V2UnsafeSoft" Color="#26FF5A3D" />
            <SolidColorBrush x:Key="V2Folder" Color="#5C9DF0" />
            <SolidColorBrush x:Key="V2FolderSoft" Color="#1E2B3E" />
            <SolidColorBrush x:Key="V2Star" Color="#F2B14E" />
            <SolidColorBrush x:Key="V2PingGood" Color="#3DD68C" />
            <SolidColorBrush x:Key="V2PingGoodSoft" Color="#1F3DD68C" />
            <SolidColorBrush x:Key="V2PingMid" Color="#F2B84B" />
            <SolidColorBrush x:Key="V2PingMidSoft" Color="#1FF2B84B" />
            <SolidColorBrush x:Key="V2PingBad" Color="#FF5A3D" />
            <SolidColorBrush x:Key="V2PingBadSoft" Color="#1FFF5A3D" />
            <SolidColorBrush x:Key="V2PingNone" Color="#6C6C78" />
            <SolidColorBrush x:Key="V2PingNoneSoft" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="V2MapOcean" Color="#0E0E11" />
            <SolidColorBrush x:Key="V2MapLand" Color="#24242C" />
            <SolidColorBrush x:Key="V2MapBorder" Color="#34343F" />
            <SolidColorBrush x:Key="V2MapDot" Color="#8A8A99" />
            <SolidColorBrush x:Key="V2MapActiveSafe" Color="#2A4A3A" />
            <SolidColorBrush x:Key="V2MapActiveUnsafe" Color="#4A2A22" />
            <SolidColorBrush x:Key="V2MapActiveLocal" Color="#463D27" />
            <BoxShadows x:Key="V2CardShadow">inset 0 1 0 0 #0FFFFFFF, 0 1 2 0 #4D000000, 0 6 16 -4 #59000000, 0 20 40 -14 #73000000</BoxShadows>
            <BoxShadows x:Key="V2RaisedShadow">inset 0 1 0 0 #14FFFFFF, 0 2 4 0 #4D000000, 0 12 28 -8 #73000000, 0 32 64 -20 #8C000000</BoxShadows>
            <BoxShadows x:Key="V2NavShadow">inset 0 1 0 0 #14FFFFFF, 0 1 2 0 #66000000, 0 4 10 -3 #4D000000</BoxShadows>
            <BoxShadows x:Key="V2FocusShadow">0 0 0 4 #7AB2FF, 0 0 0 2 #16171B</BoxShadows>
            <LinearGradientBrush x:Key="V2StageFade" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#000E0E11" />
                <GradientStop Offset="1" Color="#E60E0E11" />
            </LinearGradientBrush>
            <!--  Top-of-stage wash in the colour of the connection verdict (V2Safe / V2PingMid / V2Unsafe).
                  The tints end at alpha 02, not 00: over the cached map layer the fully transparent end
                  left holes with zero alpha under the mode bar.  -->
            <LinearGradientBrush x:Key="V2StateTintSafe" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#383DD68C" />
                <GradientStop Offset="1" Color="#023DD68C" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2StateTintWarn" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#38F2B84B" />
                <GradientStop Offset="1" Color="#02F2B84B" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2StateTintUnsafe" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#38FF5A3D" />
                <GradientStop Offset="1" Color="#02FF5A3D" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2SidebarFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#1F1F27" />
                <GradientStop Offset="1" Color="#19191F" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2ChipFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#2E2E38" />
                <GradientStop Offset="1" Color="#26262F" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2FloatingFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#F2272731" />
                <GradientStop Offset="1" Color="#EE1C1C24" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2AccentFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF5236" />
                <GradientStop Offset="1" Color="#EF3518" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2AccentFillHover" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF6447" />
                <GradientStop Offset="1" Color="#F7401F" />
            </LinearGradientBrush>
            <!--  Destructive buttons: red whatever the accent (not in Appearance.AccentKeys), dark label.  -->
            <LinearGradientBrush x:Key="V2DangerFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#E5484D" />
                <GradientStop Offset="1" Color="#DE4449" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2DangerFillHover" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#EE5A5F" />
                <GradientStop Offset="1" Color="#E64D52" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="V2OnDanger" Color="#0B0B0D" />
            <LinearGradientBrush x:Key="V2NeutralFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#3B3C48" />
                <GradientStop Offset="1" Color="#2E2F3A" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2NeutralFillHover" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#44454F" />
                <GradientStop Offset="1" Color="#363743" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2PrimaryFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFFFFF" />
                <GradientStop Offset="1" Color="#DCDCE3" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2PrimaryFillHover" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFFFFF" />
                <GradientStop Offset="1" Color="#E9E9EF" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="V2PanelBorder" Color="#24242C" />
            <SolidColorBrush x:Key="V2DialogBackground" Color="#18181D" />
            <SolidColorBrush x:Key="V2TabTrack" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="V2FooterBackground" Color="#14141A" />
            <BoxShadows x:Key="V2FlagRing">0 0 0 1 #40000000</BoxShadows>
            <BoxShadows x:Key="V2DefaultButtonShadow">inset 0 1 0 0 #33FFFFFF, 0 1 2 0 #66000000, 0 8 18 -8 #994F8FEA</BoxShadows>
            <BoxShadows x:Key="V2PanelShadow">0 1 1 0 #40000000, 0 10 28 -8 #73000000</BoxShadows>
            <BoxShadows x:Key="V2ChipShadow">inset 0 1 0 0 #14FFFFFF, 0 1 2 0 #66000000, 0 4 10 -3 #4D000000</BoxShadows>
            <BoxShadows x:Key="V2AccentShadow">inset 0 1 0 0 #59FFFFFF, inset 0 -1 0 0 #33000000, 0 1 2 0 #66000000, 0 10 22 -8 #B3FF3D1F</BoxShadows>
            <BoxShadows x:Key="V2NeutralShadow">inset 0 1 0 0 #1FFFFFFF, 0 1 2 0 #66000000, 0 6 14 -6 #73000000</BoxShadows>
            <BoxShadows x:Key="V2PrimaryShadow">inset 0 -1 0 0 #26000000, 0 1 2 0 #66000000, 0 6 14 -6 #73000000</BoxShadows>
            <!--  Semi menus and toasts in the V2pn palette  -->
            <SolidColorBrush x:Key="MenuFlyoutBackground" Color="#1F1F27" />
            <SolidColorBrush x:Key="MenuFlyoutBorderBrush" Color="#34343F" />
            <BoxShadows x:Key="MenuFlyoutBorderBoxShadow">inset 0 1 0 0 #12FFFFFF, 0 2 4 0 #4D000000, 0 14 30 -8 #8C000000</BoxShadows>
            <SolidColorBrush x:Key="MenuItemPointeroverBackground" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="MenuItemPressedBackground" Color="#21FFFFFF" />
            <SolidColorBrush x:Key="MenuItemSeparatorBackground" Color="#2C2C36" />
            <SolidColorBrush x:Key="MenuItemForeground" Color="#E4E4EA" />
            <SolidColorBrush x:Key="MenuItemExpandIconForeground" Color="#6C6C78" />
            <SolidColorBrush x:Key="MenuItemInputGestureTextForeground" Color="#8A8A96" />
            <SolidColorBrush x:Key="NotificationCardBackground" Color="#1F1F27" />
            <SolidColorBrush x:Key="NotificationCardBorderBrush" Color="#34343F" />
            <BoxShadows x:Key="NotificationCardBoxShadows">inset 0 1 0 0 #12FFFFFF, 0 2 4 0 #4D000000, 0 16 36 -10 #99000000</BoxShadows>
            <SolidColorBrush x:Key="V2ToastInfo" Color="#5C9DF0" />
            <SolidColorBrush x:Key="V2ToastInfoSoft" Color="#245C9DF0" />
            <!--  Inputs and switches: inset wells with a hairline border, blue focus; switches take the accent when on.  -->
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#17171D" />
            <SolidColorBrush x:Key="TextBoxDefaultBorderBrush" Color="#30303A" />
            <SolidColorBrush x:Key="TextBoxPointeroverBackground" Color="#1A1A21" />
            <SolidColorBrush x:Key="TextBoxPointeroverBorderBrush" Color="#41414D" />
            <SolidColorBrush x:Key="TextBoxPressedBackground" Color="#17171D" />
            <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="#5C9DF0" />
            <SolidColorBrush x:Key="TextBoxPlaceholderForeground" Color="#858591" />
            <SolidColorBrush x:Key="TextBoxSelectionBackground" Color="#66FF3D1F" />
            <SolidColorBrush x:Key="ComboBoxSelectorBackground" Color="#17171D" />
            <SolidColorBrush x:Key="ComboBoxSelectorBorderBrush" Color="#30303A" />
            <SolidColorBrush x:Key="ComboBoxSelectorPointeroverBackground" Color="#1A1A21" />
            <SolidColorBrush x:Key="ComboBoxSelectorPointeroverBorderBrush" Color="#41414D" />
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBackground" Color="#1A1A21" />
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBorderBrush" Color="#5C9DF0" />
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBackground" Color="#1A1A21" />
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBorderBrush" Color="#5C9DF0" />
            <SolidColorBrush x:Key="ComboBoxPopupBackground" Color="#1F1F27" />
            <SolidColorBrush x:Key="ComboBoxPopupBorderBrush" Color="#34343F" />
            <BoxShadows x:Key="ComboBoxPopupBoxShadow">inset 0 1 0 0 #12FFFFFF, 0 2 4 0 #4D000000, 0 14 30 -8 #8C000000</BoxShadows>
            <SolidColorBrush x:Key="ComboBoxItemPointeroverBackground" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxItemFocusBackground" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxItemSelectedBackground" Color="#26FF3D1F" />
            <SolidColorBrush x:Key="ComboBoxItemSelectedForeground" Color="#ECECF1" />
            <SolidColorBrush x:Key="ToggleSwitchContainerUnCheckedDefaultBackground" Color="#42424E" />
            <SolidColorBrush x:Key="ToggleSwitchContainerUnCheckedPointeroverBackground" Color="#4C4C59" />
            <SolidColorBrush x:Key="ToggleSwitchContainerUnCheckedPressedBackground" Color="#474754" />
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedDefaultBackground" Color="#FF3D1F" />
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPointeroverBackground" Color="#FF5A3F" />
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPressedBackground" Color="#E0331A" />
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedDisabledBackground" Color="#66FF3D1F" />
            <BoxShadows x:Key="ToggleSwitchIndicatorBoxShadow">0 1 1 0 #40000000, 0 2 6 0 #4D000000</BoxShadows>
            <BoxShadows x:Key="V2SwitchTrackShadow">inset 0 1 2 0 #4D000000</BoxShadows>
            <BoxShadows x:Key="V2InputFocusShadow">0 0 0 3 #335C9DF0</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="V2WindowBackground" Color="#E3E4E9" />
            <SolidColorBrush x:Key="V2SidebarBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="V2ContentBackground" Color="#ECEEF3" />
            <SolidColorBrush x:Key="V2CardBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="V2CardFloating" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="V2CardMutedBackground" Color="#F0F1F5" />
            <SolidColorBrush x:Key="V2Border" Color="#1816161B" />
            <SolidColorBrush x:Key="V2BorderStrong" Color="#2616161B" />
            <SolidColorBrush x:Key="V2Hover" Color="#0A16161B" />
            <SolidColorBrush x:Key="V2Pressed" Color="#1416161B" />
            <SolidColorBrush x:Key="V2Selected" Color="#0F16161B" />
            <SolidColorBrush x:Key="V2RowSelected" Color="#E5EDFB" />
            <SolidColorBrush x:Key="V2RowSelectedBorder" Color="#B7CCF2" />
            <SolidColorBrush x:Key="V2Ink" Color="#16161B" />
            <SolidColorBrush x:Key="V2InkSoft" Color="#34343F" />
            <SolidColorBrush x:Key="V2Muted" Color="#666673" />
            <SolidColorBrush x:Key="V2Faint" Color="#777783" />
            <SolidColorBrush x:Key="V2Accent" Color="#E8391B" />
            <SolidColorBrush x:Key="V2AccentHover" Color="#D4300F" />
            <SolidColorBrush x:Key="V2AccentSoft" Color="#1FE8391B" />
            <SolidColorBrush x:Key="V2OnAccent" Color="#0B0B0D" />
            <SolidColorBrush x:Key="V2Primary" Color="#16161B" />
            <SolidColorBrush x:Key="V2PrimaryHover" Color="#2C2C35" />
            <SolidColorBrush x:Key="V2OnPrimary" Color="#FFFFFF" />
            <SolidColorBrush x:Key="V2Neutral" Color="#E4E6EC" />
            <SolidColorBrush x:Key="V2NeutralHover" Color="#D8DBE3" />
            <SolidColorBrush x:Key="V2PinCore" Color="#FFFFFF" />
            <SolidColorBrush x:Key="V2Scrim" Color="#9916161B" />
            <!--  Status colours are read as 11-12 px text (pill, check chip, ping), so they are dark enough
                  for 4.5:1 on their Soft fill over the map; the tints and map fills below keep lighter tones.  -->
            <SolidColorBrush x:Key="V2Safe" Color="#046B39" />
            <SolidColorBrush x:Key="V2SafeSoft" Color="#22046B39" />
            <SolidColorBrush x:Key="V2Unsafe" Color="#AE250D" />
            <SolidColorBrush x:Key="V2UnsafeSoft" Color="#22AE250D" />
            <SolidColorBrush x:Key="V2Folder" Color="#3A7BD5" />
            <SolidColorBrush x:Key="V2FolderSoft" Color="#E3ECFA" />
            <SolidColorBrush x:Key="V2Star" Color="#A86400" />
            <SolidColorBrush x:Key="V2PingGood" Color="#046B39" />
            <SolidColorBrush x:Key="V2PingGoodSoft" Color="#1F046B39" />
            <SolidColorBrush x:Key="V2PingMid" Color="#834F00" />
            <SolidColorBrush x:Key="V2PingMidSoft" Color="#1F834F00" />
            <SolidColorBrush x:Key="V2PingBad" Color="#AE250D" />
            <SolidColorBrush x:Key="V2PingBadSoft" Color="#1FAE250D" />
            <SolidColorBrush x:Key="V2PingNone" Color="#8E8E9A" />
            <SolidColorBrush x:Key="V2PingNoneSoft" Color="#0F16161B" />
            <SolidColorBrush x:Key="V2MapOcean" Color="#E6E9F0" />
            <SolidColorBrush x:Key="V2MapLand" Color="#FAFBFC" />
            <SolidColorBrush x:Key="V2MapBorder" Color="#CDD2DC" />
            <SolidColorBrush x:Key="V2MapDot" Color="#7C8293" />
            <SolidColorBrush x:Key="V2MapActiveSafe" Color="#C9EEDB" />
            <SolidColorBrush x:Key="V2MapActiveUnsafe" Color="#F8D3CF" />
            <SolidColorBrush x:Key="V2MapActiveLocal" Color="#F5E6C4" />
            <BoxShadows x:Key="V2CardShadow">inset 0 1 0 0 #FFFFFFFF, 0 1 2 0 #0F16161B, 0 6 16 -4 #1716161B, 0 20 40 -14 #2416161B</BoxShadows>
            <BoxShadows x:Key="V2RaisedShadow">inset 0 1 0 0 #FFFFFFFF, 0 2 4 0 #1216161B, 0 12 28 -8 #2416161B, 0 32 64 -20 #3316161B</BoxShadows>
            <BoxShadows x:Key="V2NavShadow">inset 0 1 0 0 #FFFFFFFF, 0 0 0 1 #1416161B, 0 1 2 0 #1416161B, 0 4 10 -3 #1A16161B</BoxShadows>
            <BoxShadows x:Key="V2FocusShadow">0 0 0 4 #2F6FD0, 0 0 0 2 #FFFFFF</BoxShadows>
            <LinearGradientBrush x:Key="V2StageFade" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#00ECEEF3" />
                <GradientStop Offset="1" Color="#E6ECEEF3" />
            </LinearGradientBrush>
            <!--  Same hues as the light V2Safe / V2PingMid / V2Unsafe, in the brighter fill tones: a wash, not text.  -->
            <LinearGradientBrush x:Key="V2StateTintSafe" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#2617A463" />
                <GradientStop Offset="1" Color="#0217A463" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2StateTintWarn" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#26C98510" />
                <GradientStop Offset="1" Color="#02C98510" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2StateTintUnsafe" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#26E8391B" />
                <GradientStop Offset="1" Color="#02E8391B" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2SidebarFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#F9F9FB" />
                <GradientStop Offset="1" Color="#F0F1F4" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2ChipFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFFFFF" />
                <GradientStop Offset="1" Color="#FAFAFB" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2FloatingFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#F7FFFFFF" />
                <GradientStop Offset="1" Color="#EFF8F9FB" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2AccentFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF5236" />
                <GradientStop Offset="1" Color="#EF3518" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2AccentFillHover" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FF6447" />
                <GradientStop Offset="1" Color="#F7401F" />
            </LinearGradientBrush>
            <!--  Destructive buttons: red whatever the accent (not in Appearance.AccentKeys), white label.  -->
            <LinearGradientBrush x:Key="V2DangerFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#C62A2F" />
                <GradientStop Offset="1" Color="#B82328" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2DangerFillHover" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#CC3237" />
                <GradientStop Offset="1" Color="#C62A2F" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="V2OnDanger" Color="#FFFFFF" />
            <LinearGradientBrush x:Key="V2NeutralFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFFFFF" />
                <GradientStop Offset="1" Color="#F0F1F4" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2NeutralFillHover" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#FFFFFF" />
                <GradientStop Offset="1" Color="#E8EAEE" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2PrimaryFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#3A3A44" />
                <GradientStop Offset="1" Color="#131317" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="V2PrimaryFillHover" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#4A4A54" />
                <GradientStop Offset="1" Color="#1F1F25" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="V2PanelBorder" Color="#1216161B" />
            <SolidColorBrush x:Key="V2DialogBackground" Color="#F7F8FA" />
            <SolidColorBrush x:Key="V2TabTrack" Color="#0F16161B" />
            <SolidColorBrush x:Key="V2FooterBackground" Color="#EFF0F3" />
            <BoxShadows x:Key="V2FlagRing">0 0 0 1 #1F16161B</BoxShadows>
            <BoxShadows x:Key="V2DefaultButtonShadow">inset 0 1 0 0 #40FFFFFF, 0 1 2 0 #26000000, 0 8 18 -8 #803A7BD5</BoxShadows>
            <BoxShadows x:Key="V2PanelShadow">0 1 2 0 #0F16161B, 0 10 28 -10 #2416161B</BoxShadows>
            <BoxShadows x:Key="V2ChipShadow">inset 0 1 0 0 #FFFFFFFF, 0 0 0 1 #1416161B, 0 1 2 0 #1416161B, 0 4 10 -3 #1A16161B</BoxShadows>
            <BoxShadows x:Key="V2AccentShadow">inset 0 1 0 0 #66FFFFFF, inset 0 -1 0 0 #26000000, 0 1 2 0 #33EF3518, 0 10 20 -8 #A6FF3D1F</BoxShadows>
            <BoxShadows x:Key="V2NeutralShadow">inset 0 1 0 0 #FFFFFFFF, 0 0 0 1 #1A16161B, 0 1 2 0 #1416161B, 0 5 12 -5 #2416161B</BoxShadows>
            <BoxShadows x:Key="V2PrimaryShadow">inset 0 1 0 0 #40FFFFFF, 0 1 2 0 #4016161B, 0 8 16 -6 #5916161B</BoxShadows>
            <!--  Semi menus and toasts in the V2pn palette  -->
            <SolidColorBrush x:Key="MenuFlyoutBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutBorderBrush" Color="#1416161B" />
            <BoxShadows x:Key="MenuFlyoutBorderBoxShadow">0 2 4 0 #1416161B, 0 14 30 -8 #2E16161B</BoxShadows>
            <SolidColorBrush x:Key="MenuItemPointeroverBackground" Color="#0D16161B" />
            <SolidColorBrush x:Key="MenuItemPressedBackground" Color="#1716161B" />
            <SolidColorBrush x:Key="MenuItemSeparatorBackground" Color="#1416161B" />
            <SolidColorBrush x:Key="MenuItemForeground" Color="#16161B" />
            <SolidColorBrush x:Key="MenuItemExpandIconForeground" Color="#8E8E9A" />
            <SolidColorBrush x:Key="MenuItemInputGestureTextForeground" Color="#8E8E9A" />
            <SolidColorBrush x:Key="NotificationCardBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NotificationCardBorderBrush" Color="#1416161B" />
            <BoxShadows x:Key="NotificationCardBoxShadows">0 2 4 0 #1416161B, 0 16 36 -10 #3316161B</BoxShadows>
            <SolidColorBrush x:Key="V2ToastInfo" Color="#3A7BD5" />
            <SolidColorBrush x:Key="V2ToastInfoSoft" Color="#1A3A7BD5" />
            <!--  Inputs and switches: inset wells with a hairline border, blue focus; switches take the accent when on.  -->
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#F5F6F8" />
            <SolidColorBrush x:Key="TextBoxDefaultBorderBrush" Color="#2116161B" />
            <SolidColorBrush x:Key="TextBoxPointeroverBackground" Color="#F1F2F5" />
            <SolidColorBrush x:Key="TextBoxPointeroverBorderBrush" Color="#3316161B" />
            <SolidColorBrush x:Key="TextBoxPressedBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="#3A7BD5" />
            <SolidColorBrush x:Key="TextBoxPlaceholderForeground" Color="#73737F" />
            <SolidColorBrush x:Key="TextBoxSelectionBackground" Color="#55E8391B" />
            <SolidColorBrush x:Key="ComboBoxSelectorBackground" Color="#F5F6F8" />
            <SolidColorBrush x:Key="ComboBoxSelectorBorderBrush" Color="#2116161B" />
            <SolidColorBrush x:Key="ComboBoxSelectorPointeroverBackground" Color="#F1F2F5" />
            <SolidColorBrush x:Key="ComboBoxSelectorPointeroverBorderBrush" Color="#3316161B" />
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBorderBrush" Color="#3A7BD5" />
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBorderBrush" Color="#3A7BD5" />
            <SolidColorBrush x:Key="ComboBoxPopupBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxPopupBorderBrush" Color="#1416161B" />
            <BoxShadows x:Key="ComboBoxPopupBoxShadow">0 2 4 0 #1416161B, 0 14 30 -8 #2E16161B</BoxShadows>
            <SolidColorBrush x:Key="ComboBoxItemPointeroverBackground" Color="#0D16161B" />
            <SolidColorBrush x:Key="ComboBoxItemFocusBackground" Color="#0D16161B" />
            <SolidColorBrush x:Key="ComboBoxItemSelectedBackground" Color="#1AE8391B" />
            <SolidColorBrush x:Key="ComboBoxItemSelectedForeground" Color="#16161B" />
            <SolidColorBrush x:Key="ToggleSwitchContainerUnCheckedDefaultBackground" Color="#D9DBE1" />
            <SolidColorBrush x:Key="ToggleSwitchContainerUnCheckedPointeroverBackground" Color="#CFD2D9" />
            <SolidColorBrush x:Key="ToggleSwitchContainerUnCheckedPressedBackground" Color="#C3C6CE" />
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedDefaultBackground" Color="#E8391B" />
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPointeroverBackground" Color="#F04A2D" />
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPressedBackground" Color="#C82F15" />
            <SolidColorBrush x:Key="ToggleSwitchContainerCheckedDisabledBackground" Color="#66E8391B" />
            <BoxShadows x:Key="ToggleSwitchIndicatorBoxShadow">0 1 2 0 #3316161B, 0 2 6 0 #1F16161B</BoxShadows>
            <BoxShadows x:Key="V2SwitchTrackShadow">inset 0 1 2 0 #1A16161B</BoxShadows>
            <BoxShadows x:Key="V2InputFocusShadow">0 0 0 3 #2B3A7BD5</BoxShadows>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <FontFamily x:Key="V2UiFont">avares://V2pn/Assets/Fonts#Inter</FontFamily>
    <FontFamily x:Key="V2DisplayFont">avares://V2pn/Assets/Fonts#Inter</FontFamily>
    <!--  Radii nest: inner = outer - padding (panel 18 with 6 padding -> rows 12; floating 16 with 6 -> rail tiles 10).  -->
    <!--  Icon tiles of the settings menu: one hue per kind of setting, white glyph, same in both themes.  -->
    <LinearGradientBrush x:Key="V2TileGray" StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Offset="0" Color="#9A9AA6" /><GradientStop Offset="1" Color="#73737F" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="V2TileGreen" StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Offset="0" Color="#4CD99A" /><GradientStop Offset="1" Color="#22B36F" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="V2TileBlue" StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Offset="0" Color="#6AA8F5" /><GradientStop Offset="1" Color="#3D7FE0" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="V2TilePurple" StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Offset="0" Color="#B39AFB" /><GradientStop Offset="1" Color="#8B6CF0" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="V2TileAmber" StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Offset="0" Color="#F7C266" /><GradientStop Offset="1" Color="#EAA23A" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="V2TileRed" StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Offset="0" Color="#F2766C" /><GradientStop Offset="1" Color="#DF4B41" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="V2TileTeal" StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Offset="0" Color="#4FCBD6" /><GradientStop Offset="1" Color="#22A6B3" /></LinearGradientBrush>
    <!--  Inputs: 36 px tall, 10 px corners (rows inside 18 px cards), switches keep Semi's geometry.  -->
    <x:Double x:Key="TextBoxDefaultHeight">36</x:Double>
    <x:Double x:Key="ComboBoxDefaultHeight">36</x:Double>
    <CornerRadius x:Key="TextBoxDefaultCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ComboBoxSelectorCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ComboBoxPopupBoxCornerRadius">12</CornerRadius>
    <Thickness x:Key="ComboBoxPopupBorderPadding">4</Thickness>
    <CornerRadius x:Key="V2RadiusPanel">18</CornerRadius>
    <!--  The stage clips the map one pixel inside its border.  -->
    <CornerRadius x:Key="V2RadiusPanelInner">17</CornerRadius>
    <!--  Semi menus and toasts: rounder, roomier, rows inset inside the panel (14 - 6 = 8).  -->
    <CornerRadius x:Key="MenuFlyoutCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="MenuItemCornerRadius">8</CornerRadius>
    <Thickness x:Key="MenuFlyoutPadding">6</Thickness>
    <Thickness x:Key="MenuItemPadding">10,7,12,7</Thickness>
    <Thickness x:Key="MenuItemIconMargin">0,0,11,0</Thickness>
    <Thickness x:Key="MenuItemSeparatorMargin">6,5</Thickness>
    <x:Double x:Key="MenuFlyoutMinWidth">220</x:Double>
    <x:Double x:Key="MenuFlyoutMaxHeight">560</x:Double>
    <CornerRadius x:Key="NotificationCardCornerRadius">16</CornerRadius>
    <Thickness x:Key="NotificationCardPadding">14,12,16,12</Thickness>
    <x:Double x:Key="NotificationCardMinWidth">300</x:Double>
    <!--  V2pn toasts draw their own icon badge; Semi's type icon takes no space.  -->
    <x:Double x:Key="NotificationCardIconWidth">0</x:Double>
    <x:Double x:Key="NotificationCardIconHeight">0</x:Double>
    <Thickness x:Key="NotificationCardIconMargin">0</Thickness>
    <!--  Floating cards sit 16 px inside the stage (17 px clip), so they are no rounder than its corner.  -->
    <CornerRadius x:Key="V2RadiusFloating">16</CornerRadius>
    <!--  The feature rail's tiles inside a floating card with 6 px padding (16 - 6).  -->
    <CornerRadius x:Key="V2RadiusFloatingInner">10</CornerRadius>
    <CornerRadius x:Key="V2RadiusCard">18</CornerRadius>
    <CornerRadius x:Key="V2RadiusTile">14</CornerRadius>
    <CornerRadius x:Key="V2RadiusRow">12</CornerRadius>
    <CornerRadius x:Key="V2RadiusControl">12</CornerRadius>
    <CornerRadius x:Key="V2RadiusPill">999</CornerRadius>
    <!--  The connection bar (outer 18, segments and route chip 13 inside its 5 px padding), segmented
          items and the icon tiles of subscription and settings rows. All follow the Corners setting.  -->
    <CornerRadius x:Key="V2RadiusBar">18</CornerRadius>
    <CornerRadius x:Key="V2RadiusBarInner">13</CornerRadius>
    <CornerRadius x:Key="V2RadiusSegment">10</CornerRadius>
    <CornerRadius x:Key="V2RadiusIconTile">10</CornerRadius>
    <StreamGeometry x:Key="V2SpinnerArc">M6,1 A5,5 0 1 1 1,6</StreamGeometry>
    <!--  The fork: one stroke wide (32), 3.25 x 3.5 strokes, every diagonal 45 degrees. Same drawing as the app icon.  -->
    <StreamGeometry x:Key="V2BrandFork">M0,0 L32,0 L32,40 L72,0 L104,0 L104,32 L85.255,32 L64,53.255 L64,112 L32,112 L32,72 L0,40 Z</StreamGeometry>
    <StreamGeometry x:Key="V2FolderBack">M0,2.5 C0,1.4 0.9,0.5 2,0.5 L5.6,0.5 C6.1,0.5 6.6,0.7 7,1.1 L8,2 L14,2 C15.1,2 16,2.9 16,4 L16,11.5 C16,12.6 15.1,13.5 14,13.5 L2,13.5 C0.9,13.5 0,12.6 0,11.5 Z</StreamGeometry>
    <StreamGeometry x:Key="V2FolderFront">M0,5.5 C0,4.4 0.9,3.5 2,3.5 L14,3.5 C15.1,3.5 16,4.4 16,5.5 L16,11.5 C16,12.6 15.1,13.5 14,13.5 L2,13.5 C0.9,13.5 0,12.6 0,11.5 Z</StreamGeometry>
</ResourceDictionary>
