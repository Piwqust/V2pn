<Window
    x:Class="v2rayN.Desktop.Views.AddServerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:v2rayN.Desktop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:v2rayN.Desktop.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static loc:L.SvTitlePlain}"
    Width="800"
    Height="640"
    x:DataType="vms:AddServerViewModel"
    Design.DataContext="{x:Static dd:DesignData.AddServer}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Styles>
        <!--  Rows inside a switchable set (transport, TLS, Reality) are never first in their card: keep the divider.  -->
        <Style Selector="StackPanel.srowset > Border.srow">
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
    </Window.Styles>
    <DockPanel>
        <Border Classes="dialogfooter" DockPanel.Dock="Bottom">
            <StackPanel Classes="footer">
            <Button
                x:Name="btnSave"
                MinWidth="100"
                Content="{x:Static loc:L.Save}"
                IsDefault="True" />
            <Button
                x:Name="btnCancel"
                MinWidth="100"
                Content="{x:Static loc:L.Cancel}"
                IsCancel="True" />
        </StackPanel>
        </Border>
        <ScrollViewer x:Name="svForm" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Classes="spagebody">
                <TextBlock x:Name="tbPageTitle" Classes="spagetitle" Text="{x:Static loc:L.SvTitlePlain}" />
                <TextBlock Classes="spagehint" Text="{x:Static loc:L.SvHint}" />

                <!--  Server  -->
                <StackPanel Classes="sgroup">
                    <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.SvGrpServer}" />
                    <Border Classes="sgroupcard">
                        <StackPanel>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconEditStroked}" /></Border>
                                    <StackPanel Grid.Column="1" Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvName}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvNameHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="txtRemarks" PlaceholderText="{x:Static loc:L.SvNamePlaceholder}" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconGlobeStroke}" /></Border>
                                    <StackPanel Grid.Column="1" Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvAddress}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvAddressHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="txtAddress" PlaceholderText="example.com" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconHash}" /></Border>
                                    <StackPanel Grid.Column="1" Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvPort}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvPortHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="txtPort" PlaceholderText="443" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvCore}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvCoreHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <ComboBox x:Name="cmbCoreType" />
                                    </Panel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Sign-in: one group per protocol, the code-behind shows the one that fits.  -->
                <StackPanel Classes="sgroup" x:Name="gridVMess" IsVisible="False">
                    <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.SvGrpAccess}" />
                    <Border Classes="sgroupcard">
                        <StackPanel>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconKey}" /></Border>
                                    <StackPanel Grid.Column="1" Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvUuid}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvUuidHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox x:Name="txtId" PlaceholderText="b831381d-6324-4d53-ad4f-8cda48b30811" />
                                            <Button x:Name="btnGUID" Content="{x:Static loc:L.SvGenerate}" />
                                        </StackPanel>
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvAlterId}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvAlterIdHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox x:Name="txtAlterId" PlaceholderText="0" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvVmessSecurity}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvVmessSecurityHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <ComboBox x:Name="cmbSecurity" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvMux}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvMuxHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <ToggleSwitch x:Name="togmuxEnabled" />
                                    </Panel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Classes="sgroup" x:Name="gridSs" IsVisible="False">
                    <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.SvGrpAccess}" />
                    <Border Classes="sgroupcard">
                        <StackPanel>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconLock}" /></Border>
                                    <StackPanel Grid.Column="1" Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvPassword}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvPasswordHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="txtId3" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconShieldStroked}" /></Border>
                                    <StackPanel Grid.Column="1" Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvSsMethod}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvSsMethodHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                        <ComboBox x:Name="cmbSecurity3" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvUot}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvUotHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <ToggleSwitch x:Name="togUotEnabled3" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvMux}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvMuxHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <ToggleSwitch x:Name="togmuxEnabled3" />
                                    </Panel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Classes="sgroup" x:Name="gridSocks" IsVisible="False">
                    <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.SvGrpAccess}" />
                    <Border Classes="sgroupcard">
                        <StackPanel>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconUser}" /></Border>
                                    <StackPanel Grid.Column="1" Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvUser}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvUserHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="txtSecurity4" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconLock}" /></Border>
                                    <StackPanel Grid.Column="1" Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvPassword}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvPasswordHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="txtId4" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow stack adv">
                                <StackPanel Spacing="10">
                                    <StackPanel>
                                        <TextBlock Classes="srowtitle" x:Name="tbHttpHeaders" IsVisible="False" Text="{x:Static loc:L.SvHttpHeaders}" ToolTip.Tip="{x:Static loc:L.SvHttpHeadersTip}" />
                                    </StackPanel>
                                    <views:JsonEditor x:Name="txtHttpHeadersJson" MinHeight="100" IsVisible="False" ToolTip.Tip="{x:Static loc:L.SvHttpHeadersTip}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Classes="sgroup" x:Name="gridVLESS" IsVisible="False">
                    <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.SvGrpAccess}" />
                    <Border Classes="sgroupcard">
                        <StackPanel>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconKey}" /></Border>
                                    <StackPanel Grid.Column="1" Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvUuid}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvUuidHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox x:Name="txtId5" PlaceholderText="b831381d-6324-4d53-ad4f-8cda48b30811" />
                                            <Button x:Name="btnGUID5" Content="{x:Static loc:L.SvGenerate}" />
                                        </StackPanel>
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvFlow}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvFlowHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <ComboBox x:Name="cmbFlow5" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvVlessEnc}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvVlessEncHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox x:Name="txtSecurity5" PlaceholderText="none" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvMux}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvMuxHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <ToggleSwitch x:Name="togmuxEnabled5" />
                                    </Panel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Classes="sgroup" x:Name="gridTrojan" IsVisible="False">
                    <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.SvGrpAccess}" />
                    <Border Classes="sgroupcard">
                        <StackPanel>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconLock}" /></Border>
                                    <StackPanel Grid.Column="1" Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvPassword}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvPasswordHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="txtId6" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvFlow}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvFlowHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <ComboBox x:Name="cmbFlow6" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvMux}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvMuxHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <ToggleSwitch x:Name="togmuxEnabled6" />
                                    </Panel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Classes="sgroup" x:Name="gridHysteria2" IsVisible="False">
                    <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.SvGrpAccess}" />
                    <Border Classes="sgroupcard">
                        <StackPanel>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconLock}" /></Border>
                                    <StackPanel Grid.Column="1" Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvPassword}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvPasswordHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="txtId7" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvHy2Extra}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvHy2ExtraHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <Button Classes="ghost small icon" Theme="{StaticResource V2Button}">
                                            <Button.Content>
                                                <PathIcon Data="{StaticResource SemiIconMore}">
                                                    <PathIcon.RenderTransform>
                                                        <RotateTransform Angle="90" />
                                                    </PathIcon.RenderTransform>
                                                </PathIcon>
                                            </Button.Content>
                                            <Button.Flyout>
                                                <Flyout>
                                                    <StackPanel>
                                                        <TextBlock Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="{x:Static loc:L.SvHy2Obfs}" />
                                                        <TextBox x:Name="txtPath7" Width="400" Margin="{StaticResource Margin4}" />
                                                        <TextBlock Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="{x:Static loc:L.SvHy2Gecko}" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBox x:Name="txtMinGeckoPacketSize" Width="90" Margin="{StaticResource Margin4}" PlaceholderText="{x:Static loc:L.SvMin}" />
                                                            <TextBox x:Name="txtMaxGeckoPacketSize" Width="90" Margin="{StaticResource Margin4}" PlaceholderText="{x:Static loc:L.SvMax}" />
                                                        </StackPanel>
                                                        <TextBlock Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="{x:Static loc:L.SvHy2Realm}" />
                                                        <TextBox x:Name="txtHy2RealmUrl" Width="400" Margin="{StaticResource Margin4}" />
                                                        <TextBlock Width="400" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="{x:Static loc:L.SvHy2RealmHint}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvPorts}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvPortsHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox x:Name="txtPorts7" PlaceholderText="1000-2000,3000,4000" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvHopInt}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvHopIntHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox x:Name="txtHopInt7" PlaceholderText="30" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvBandwidth}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvBandwidthHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox x:Name="txtUpMbps7" Width="90" PlaceholderText="↑ 50" />
                                            <TextBox x:Name="txtDownMbps7" Width="90" PlaceholderText="↓ 200" />
                                        </StackPanel>
                                    </Panel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Classes="sgroup" x:Name="gridTuic" IsVisible="False">
                    <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.SvGrpAccess}" />
                    <Border Classes="sgroupcard">
                        <StackPanel>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconKey}" /></Border>
                                    <StackPanel Grid.Column="1" Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvUuid}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvUuidHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="txtId8" PlaceholderText="b831381d-6324-4d53-ad4f-8cda48b30811" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconLock}" /></Border>
                                    <StackPanel Grid.Column="1" Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvPassword}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvPasswordHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="txtSecurity8" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvCongestion}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvCongestionHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <ComboBox x:Name="cmbCongestionControl8" />
                                    </Panel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Classes="sgroup" x:Name="gridWireguard" IsVisible="False">
                    <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.SvGrpAccess}" />
                    <Border Classes="sgroupcard">
                        <StackPanel>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconKey}" /></Border>
                                    <StackPanel Grid.Column="1" Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvWgPrivateKey}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvWgPrivateKeyHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="txtId9" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconKeyStroked}" /></Border>
                                    <StackPanel Grid.Column="1" Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvWgPublicKey}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvWgPublicKeyHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="txtPublicKey9" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvWgPsk}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvWgPskHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox x:Name="txtPreSharedKey9" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvWgReserved}" />
