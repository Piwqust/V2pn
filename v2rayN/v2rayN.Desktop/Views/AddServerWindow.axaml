                                <Border Classes="srow stack adv">
                                    <StackPanel Spacing="10">
                                        <StackPanel>
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvXdriveExtra}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Expander IsExpanded="False">
                                            <Expander.Header>
                                                <TextBlock FontWeight="Normal" Text="{x:Static loc:L.SvXdriveExtraTip}" />
                                            </Expander.Header>
                                            <views:JsonEditor x:Name="txtExtraXdrive" HorizontalAlignment="Stretch" />
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!--  Shown when the server's core cannot carry the chosen transport (sing-box: kcp, xhttp, XDRIVE).  -->
                    <TextBlock x:Name="txtTransportCoreNote" Classes="sgroupnote" IsVisible="False" />
                </StackPanel>

                <StackPanel Classes="sgroup" x:Name="gridFinalmask">
                    <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.SvGrpMask}" />
                    <Border Classes="sgroupcard">
                        <StackPanel>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvFinalmask}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvFinalmaskHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <Button Classes="ghost small icon" Theme="{StaticResource V2Button}">
                                            <Button.Content>
                                                <PathIcon Data="{StaticResource SemiIconMore}">
                                                    <PathIcon.RenderTransform>
                                                        <RotateTransform Angle="90" />
                                                    </PathIcon.RenderTransform>
                                                </PathIcon>
                                            </Button.Content>
                                            <Button.Flyout>
                                                <Flyout>
                                                    <StackPanel>
                                                        <views:JsonEditor x:Name="txtFinalmask" Width="400" MinHeight="100" Margin="{StaticResource Margin4}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Panel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  TLS / Reality: the code-behind switches the sets by the chosen protection.  -->
                <StackPanel Classes="sgroup" x:Name="gridTls">
                    <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.SvGrpSecurity}" />
                    <Border Classes="sgroupcard">
                        <StackPanel>
                            <Border Classes="srow adv">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvTls}" />
                                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvTlsHint}" />
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <ComboBox x:Name="cmbStreamSecurity" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <StackPanel Classes="srowset" x:Name="gridTlsMore" IsVisible="False">
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvSni}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvSniHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <TextBox x:Name="txtSNI" PlaceholderText="example.com" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvFingerprint}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvFingerprintHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBox x:Name="cmbFingerprint" IsEditable="True" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvAlpn}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvAlpnHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBox x:Name="cmbAlpn" IsEditable="True" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvInsecure}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvInsecureHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <ToggleSwitch x:Name="togAllowInsecure" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvEch}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvEchHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <TextBox x:Name="txtEchConfigList" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvVerifyName}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvVerifyNameHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <TextBox x:Name="txtVerifyPeerCertByName" PlaceholderText="example.com" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvPinning}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvPinningHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="labCertPinning" Margin="{StaticResource Margin8}" VerticalAlignment="Center" />
                                                <Button Margin="{StaticResource MarginLr4}" HorizontalAlignment="Left" VerticalAlignment="Center" Classes="ghost small icon" Theme="{StaticResource V2Button}">
                                                    <Button.Content>
                                                        <PathIcon Data="{StaticResource SemiIconMore}">
                                                            <PathIcon.RenderTransform>
                                                                <RotateTransform Angle="90" />
                                                            </PathIcon.RenderTransform>
                                                        </PathIcon>
                                                    </Button.Content>
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel>
                                                                <TextBlock Width="400" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="{x:Static loc:L.SvPinningTip}" TextWrapping="Wrap" />
                                                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                                    <Button x:Name="btnFetchCert" Margin="{StaticResource Margin4}" Content="{x:Static loc:L.SvFetchCert}" />
                                                                    <Button x:Name="btnFetchCertChain" Margin="{StaticResource Margin4}" Content="{x:Static loc:L.SvFetchCertChain}" />
                                                                </StackPanel>
                                                                <TextBlock Width="400" Margin="{StaticResource Margin4}" VerticalAlignment="Center" TextWrapping="Wrap">
                                                                    <Run Text="{x:Static loc:L.SvCertSha}" />
                                                                    <Run FontWeight="SemiBold" Text="{x:Static loc:L.SvXrayOnly}" />
                                                                </TextBlock>
                                                                <TextBox x:Name="txtCertSha256Pinning" Width="400" Margin="{StaticResource Margin4}" HorizontalAlignment="Left" />
                                                                <TextBlock Width="400" Margin="{StaticResource Margin4}" VerticalAlignment="Center" Text="{x:Static loc:L.SvFullCert}" TextWrapping="Wrap" />
                                                                <TextBox x:Name="txtCert" Width="400" Margin="{StaticResource Margin4}" AcceptsReturn="True" Classes="TextArea" TextWrapping="NoWrap" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </Panel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel Classes="srowset" x:Name="gridRealityMore" IsVisible="False">
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvSni}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvSniHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <TextBox x:Name="txtSNI2" PlaceholderText="www.microsoft.com" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvFingerprint}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvFingerprintHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBox x:Name="cmbFingerprint2" IsEditable="True" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvRealityKey}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvRealityKeyHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <TextBox x:Name="txtPublicKey" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvShortId}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvShortIdHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <TextBox x:Name="txtShortId" PlaceholderText="6ba85179e30d4fc2" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvSpiderX}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvSpiderXHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <TextBox x:Name="txtSpiderX" PlaceholderText="/" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SvMldsa}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.SvMldsaHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <TextBox x:Name="txtMldsa65Verify" />
                                        </Panel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Button x:Name="btnMoreFields" Classes="morefields" Theme="{StaticResource V2Button}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
