<UserControl
    x:Class="v2rayN.Desktop.Views.CheckUpdateView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:v2rayN.Desktop"
    xmlns:views="using:v2rayN.Desktop.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="640"
    d:DesignWidth="660"
    x:DataType="vms:CheckUpdateViewModel"
    Design.DataContext="{x:Static dd:DesignData.CheckUpdate}"
    mc:Ignorable="d">

    <DockPanel Width="660">
        <Border Classes="dialogfooter" DockPanel.Dock="Bottom">
            <DockPanel>
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ToggleSwitch
                        x:Name="togEnableUpdateViaProxy"
                        MinWidth="0"
                        OffContent=""
                        OnContent="" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="muted"
                        Text="{x:Static loc:L.TlUpdViaVpn}" />
                </StackPanel>
                <StackPanel Classes="footer">
                    <Button x:Name="btnCheckOnly" Content="{x:Static loc:L.TlUpdCheck}" />
                    <Button x:Name="btnCheckUpdate" Content="{x:Static loc:L.TlUpdUpdate}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  The dialog also closes on a click outside it; the button makes that discoverable.  -->
        <Grid Margin="28,22,18,0" ColumnDefinitions="*,Auto" DockPanel.Dock="Top">
            <TextBlock Classes="spagetitle" Text="{x:Static loc:L.TlUpdTitle}" />
            <Button
                x:Name="btnCloseDialog"
                Grid.Column="1"
                VerticalAlignment="Top"
                AutomationProperties.Name="{x:Static loc:L.Close}"
                Classes="ghost icon"
                Theme="{StaticResource V2Button}"
                ToolTip.Tip="{x:Static loc:L.Close}">
                <PathIcon Classes="i14" Data="{StaticResource SemiIconClose}" />
            </Button>
        </Grid>

        <!--  V2pn itself: version, what is happening, one action.  -->
        <Border
            x:Name="cardApp"
            Margin="28,14,28,0"
            Classes="formcard"
            DockPanel.Dock="Top">
            <StackPanel Margin="8,8,8,6" Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border
                        Width="44"
                        Height="44"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource V2NeutralFill}"
                        CornerRadius="12">
                        <Image
                            Width="26"
                            Height="26"
                            Source="/Assets/V2pn.ico" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock x:Name="txtAppVersion" Classes="srowtitle" />
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path
                                x:Name="spinApp"
                                Classes="spinner"
                                IsVisible="False" />
                            <TextBlock
                                x:Name="txtAppState"
                                Classes="srowhint"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            x:Name="txtAppBase"
                            Classes="muted small" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="btnWhatsNew"
                            Classes="subtle"
                            Content="{x:Static loc:L.UpdWhatsNew}"
                            IsVisible="False"
                            Theme="{StaticResource V2Button}" />
                        <Button
                            x:Name="btnAppAction"
                            MinWidth="150"
                            Theme="{StaticResource V2Button}" />
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource V2PanelBorder}" />
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Classes="srowtext">
                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.UpdAuto}" />
                        <TextBlock Classes="srowhint" Text="{x:Static loc:L.UpdAutoHint}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="togAutoUpdate"
                        Grid.Column="1"
                        MinWidth="0"
                        VerticalAlignment="Center"
                        OffContent=""
                        OnContent="" />
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Margin="28,18,28,0" DockPanel.Dock="Top" Spacing="2">
            <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.UpdComponents}" />
            <TextBlock Classes="muted small" Text="{x:Static loc:L.UpdComponentsHint}" />
        </StackPanel>

        <Border
            Margin="28,8,28,20"
            Classes="formcard">

            <ListBox
                x:Name="lstCheckUpdates"
                BorderThickness="0"
                ItemsSource="{Binding CheckUpdateModels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4" ColumnDefinitions="Auto,*,Auto">
                            <ToggleSwitch
                                x:Name="togAutoRefresh"
                                Grid.Column="0"
                                MinWidth="0"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsSelected}"
                                OffContent=""
                                OnContent="" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Classes="srowtitle" Text="{Binding CoreTypeForStorage, Converter={x:Static views:CheckUpdateView.PartName}}" />
                                <TextBlock
                                    Classes="srowhint"
                                    IsVisible="{Binding Remarks, Converter={x:Static views:CheckUpdateView.HasNews}}"
                                    Text="{Binding Remarks, Converter={x:Static views:CheckUpdateView.Plain}}"
                                    TextWrapping="WrapWithOverflow" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                IsVisible="{Binding ShowCheckPreRelease}"
                                Orientation="Horizontal"
                                Spacing="6">
                                <ToggleSwitch
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsCheckPreRelease}"
                                    OffContent=""
                                    OnContent="" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="muted small"
                                    Text="{x:Static loc:L.TlUpdBeta}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
