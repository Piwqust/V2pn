<UserControl
    x:Class="v2rayN.Desktop.Views.ClashProxiesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:dto="clr-namespace:ServiceLib.Models.Dto;assembly=ServiceLib"
    xmlns:loc="using:v2rayN.Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:v2rayN.Desktop.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="560"
    d:DesignWidth="900"
    x:DataType="vms:ClashProxiesViewModel"
    Design.DataContext="{x:Static dd:DesignData.ClashProxies}"
    mc:Ignorable="d">
    <!--
        Proxy groups as a list beside the chosen group's proxies, like the subscriptions and rule sets.
        v2rayN had tag tiles in a wrap panel and combo boxes for the mode and the order.
    -->
    <UserControl.Styles>
        <Style Selector="TextBlock.navsec">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource V2Faint}" />
            <Setter Property="Margin" Value="10,2,10,6" />
        </Style>
        <!--  "Use" shows on the row under the pointer or the selected one; a group that picks by itself has none.  -->
        <Style Selector="ListBoxItem Button.use">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ListBoxItem:pointerover Button.use, ListBoxItem:selected Button.use, ListBoxItem Button.use:focus-visible">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBox.auto Button.use">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Ellipse.activedot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Ellipse.activedot.on">
            <Setter Property="Fill" Value="{DynamicResource V2Accent}" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="28,20,28,24">

        <!--  ── Mode ──  -->
        <Grid ColumnDefinitions="Auto,*" DockPanel.Dock="Top">
            <TextBlock
                VerticalAlignment="Center"
                Classes="muted"
                Text="{x:Static loc:L.PxMode}" />
            <ListBox
                x:Name="lstRuleMode"
                Grid.Column="1"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Static loc:L.PxMode}"
                Theme="{StaticResource V2Segmented}" />
        </Grid>

        <Panel x:Name="panelBody" Margin="0,18,0,0">
            <Grid x:Name="gridBody" ColumnDefinitions="260,16,*">

                <!--  ── Groups ──  -->
                <Border
                    x:Name="cardGroups"
                    Padding="8,12"
                    Classes="card">
                    <DockPanel>
                        <!--  Reload and auto refresh act on every group, so they sit under the list of groups.  -->
                        <StackPanel
                            Margin="2,10,2,0"
                            DockPanel.Dock="Bottom"
                            Spacing="10">
                            <Grid Margin="8,0,0,0" ColumnDefinitions="*,Auto">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="muted"
                                    Text="{x:Static loc:L.LiveAutoRefresh}"
                                    TextTrimming="CharacterEllipsis" />
                                <ToggleSwitch
                                    x:Name="togAutoRefresh"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Static loc:L.LiveAutoRefresh}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Button
                                x:Name="menuProxiesReload"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{x:Static loc:L.PxReload}"
                                Theme="{StaticResource V2Button}"
                                ToolTip.Tip="{x:Static loc:L.PxReloadTip}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Classes="i14" Data="{StaticResource SemiIconRefresh}" />
                                    <TextBlock Text="{x:Static loc:L.PxReload}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border
                            Classes="hairline"
                            Margin="0,10,0,0"
                            DockPanel.Dock="Bottom" />
                        <TextBlock
                            Classes="navsec"
                            DockPanel.Dock="Top"
                            Text="{x:Static loc:L.PxGroups}" />
                        <ListBox
                            x:Name="lstProxyGroups"
                            AutomationProperties.Name="{x:Static loc:L.PxGroups}"
                            Theme="{StaticResource V2NavList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="dto:ClashProxyModel">
                                    <StackPanel Margin="0,7" Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock
                                                FontWeight="Medium"
                                                Text="{Binding Name, Converter={x:Static views:ClashProxiesView.GroupName}}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Border
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Classes="tag">
                                                <TextBlock Text="{Binding Type, Converter={x:Static views:ClashProxiesView.GroupType}}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock
                                            Classes="muted small"
                                            Text="{Binding Now}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!--  ── The chosen group ──  -->
                <Border
                    x:Name="cardDetails"
                    Grid.Column="2"
                    Classes="card"
                    ClipToBounds="True">
                    <DockPanel>
                        <Grid
                            Margin="20,16,16,0"
                            ColumnDefinitions="*,Auto"
                            DockPanel.Dock="Top">
                            <StackPanel Spacing="3">
                                <TextBlock
                                    x:Name="txtGroupName"
                                    Classes="display h3"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="txtGroupHint"
                                    Classes="muted small"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="menuGroupProxiesDelaytest"
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{x:Static loc:L.TestPing}"
                                Classes="primary"
                                Theme="{StaticResource V2Button}"
                                ToolTip.Tip="{x:Static loc:L.PxTestGroupTip}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Classes="i14" Data="{StaticResource SemiIconBolt}" />
                                    <TextBlock Text="{x:Static loc:L.TestPing}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListBox
                            x:Name="lstSorting"
                            Margin="20,14,16,8"
                            AutomationProperties.Name="{x:Static loc:L.PxSortPing}"
                            Classes="chips"
                            DockPanel.Dock="Top">
                            <ListBoxItem Content="{x:Static loc:L.PxSortPing}" />
                            <ListBoxItem Content="{x:Static loc:L.PxSortName}" />
                            <ListBoxItem Content="{x:Static loc:L.PxSortDefault}" />
                        </ListBox>
                        <Border Classes="hairline" DockPanel.Dock="Top" />

                        <Panel>
                            <ListBox
                                x:Name="lstProxyDetails"
                                Padding="0,6"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerTheme="{StaticResource V2RowItem}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            x:Name="menuProxiesSelectActivity"
                                            Header="{x:Static loc:L.PxUse}"
                                            InputGesture="Enter" />
                                        <MenuItem x:Name="menuProxyDelaytest" Header="{x:Static loc:L.TestPing}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="dto:ClashProxyModel">
                                        <Grid Height="48" ColumnDefinitions="22,*,Auto,92">
                                            <Ellipse Classes="activedot" Classes.on="{Binding IsActive}" />
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="4,0,12,0"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Classes="title"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <Border Classes="tag live" IsVisible="{Binding IsActive}">
                                                        <TextBlock Text="{x:Static loc:L.PxInUse}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                    Classes="muted small"
                                                    Text="{Binding Type}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" IsVisible="{Binding !IsActive}">
                                                <Button
                                                    Margin="0,0,8,0"
                                                    AutomationProperties.Name="{x:Static loc:L.PxUse}"
                                                    Classes="ghost small use"
                                                    Click="RowUse_Click"
                                                    Content="{x:Static loc:L.PxUse}"
                                                    Theme="{StaticResource V2Button}"
                                                    ToolTip.Tip="{x:Static loc:L.PxUseTip}" />
                                            </Panel>
                                            <Button
                                                Grid.Column="3"
                                                Padding="0"
                                                HorizontalAlignment="Right"
                                                AutomationProperties.Name="{x:Static loc:L.TestPing}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="RowPing_Click"
                                                Theme="{StaticResource V2Button}"
                                                ToolTip.Tip="{x:Static loc:L.TestPing}">
                                                <Border
                                                    Classes="pill"
                                                    Classes.bad="{Binding DelayName, Converter={x:Static views:ClashProxiesView.IsBad}}"
                                                    Classes.good="{Binding DelayName, Converter={x:Static views:ClashProxiesView.IsGood}}"
                                                    Classes.mid="{Binding DelayName, Converter={x:Static views:ClashProxiesView.IsMid}}">
                                                    <TextBlock Text="{Binding DelayName, Converter={x:Static views:ClashProxiesView.PingText}}" />
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock
                                x:Name="txtGroupEmpty"
                                Margin="24,40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Classes="muted"
                                IsVisible="False"
                                Text="{x:Static loc:L.PxGroupEmpty}" />
                        </Panel>
                    </DockPanel>
                </Border>
            </Grid>

            <!--  Empty state: no groups at all  -->
            <StackPanel
                x:Name="panelEmpty"
                MaxWidth="420"
                Margin="24,64"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsVisible="False"
                Spacing="10">
                <TextBlock
                    HorizontalAlignment="Center"
                    Classes="display h2"
                    Text="{x:Static loc:L.PxEmptyTitle}" />
                <TextBlock
                    x:Name="txtEmptyHint"
                    HorizontalAlignment="Center"
                    Classes="muted"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="btnEmptyReload"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Theme="{StaticResource V2Button}"
                    ToolTip.Tip="{x:Static loc:L.PxReloadTip}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Classes="i14" Data="{StaticResource SemiIconRefresh}" />
                        <TextBlock Text="{x:Static loc:L.PxReload}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Panel>
    </DockPanel>
</UserControl>
