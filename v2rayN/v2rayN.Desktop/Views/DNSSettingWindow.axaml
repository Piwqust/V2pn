<Window
    x:Class="v2rayN.Desktop.Views.DNSSettingWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:v2rayN.Desktop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:local="using:v2rayN.Desktop.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.menuDNSSetting}"
    Width="940"
    Height="680"
    x:DataType="vms:DNSSettingViewModel"
    Design.DataContext="{x:Static dd:DesignData.DNSSetting}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel>
        <Border Classes="dialogfooter" DockPanel.Dock="Bottom">
            <StackPanel Classes="footer">
            <Button
                x:Name="btnSave"
                MinWidth="100"
                Content="{x:Static loc:L.Save}"
                IsDefault="True" />
            <Button
                x:Name="btnCancel"
                MinWidth="100"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="True" />
        </StackPanel>
        </Border>

        <TabControl Classes="plain" HorizontalContentAlignment="Stretch">
            <TabItem Header="{x:Static loc:L.DnTabMain}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,12,12,20" Spacing="6">
                        <TextBlock Classes="spagetitle" Text="{x:Static loc:L.DnTitle}" />
                        <TextBlock Classes="spagehint" Text="{x:Static loc:L.DnHint}" />
                        <TextBlock
                            x:Name="txtBasicDNSSettingsInvalid"
                            Classes="spagehint"
                            Foreground="{DynamicResource V2PingMid}"
                            Text="{x:Static resx:ResUI.TbCustomDNSEnabledPageInvalid}" />

                        <StackPanel x:Name="gridBasicDNSSettings">
                            <StackPanel Classes="sgroup">
                                <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.DnGrpSites}" />
                                <Border Classes="sgroupcard">
                                    <StackPanel>
                                        <Border Classes="srow">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconGlobeStroke}" /></Border>
                                                <StackPanel Grid.Column="1" Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnDirect}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnDirectHint}" />
                                                </StackPanel>
                                                <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                                    <ComboBox x:Name="cmbDirectDNS" IsEditable="True" PlaceholderText="77.88.8.8" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="srow">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconShieldStroked}" /></Border>
                                                <StackPanel Grid.Column="1" Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnRemote}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnRemoteHint}" />
                                                </StackPanel>
                                                <Panel Classes="srowctl" Grid.Column="2" VerticalAlignment="Center">
                                                    <ComboBox x:Name="cmbRemoteDNS" IsEditable="True" PlaceholderText="https://dns.google/dns-query" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="srow adv">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnBootstrap}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnBootstrapHint}" />
                                                </StackPanel>
                                                <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                                    <ComboBox x:Name="cmbBootstrapDNS" IsEditable="True" PlaceholderText="77.88.8.8" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Classes="sgroup">
                                <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.DnGrpSpeed}" />
                                <Border Classes="sgroupcard">
                                    <StackPanel>
                                        <Border Classes="srow">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconBolt}" /></Border>
                                                <StackPanel Grid.Column="1" Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnFakeIp}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnFakeIpHint}" />
                                                </StackPanel>
                                                <Panel Grid.Column="2" VerticalAlignment="Center">
                                                    <ToggleSwitch x:Name="togFakeIP" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="srow adv">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnFakeIpRange}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnFakeIpRangeHint}" />
                                                </StackPanel>
                                                <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                                    <ComboBox x:Name="cmbFakeIPRange" IsEditable="True" PlaceholderText="198.18.0.0/15" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="srow adv">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnFakeIpv6}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnFakeIpv6Hint}" />
                                                </StackPanel>
                                                <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid x:Name="gridFakeIPv6" ColumnDefinitions="Auto,Auto">
                                                        <ToggleSwitch x:Name="togFakeIPv6" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                        <ComboBox x:Name="cmbFakeIPv6Range" Grid.Column="1" Width="220" VerticalAlignment="Center" IsEditable="True" />
                                                    </Grid>
                                                </Panel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="srow adv">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnParallel}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnParallelHint}" />
                                                </StackPanel>
                                                <Panel Grid.Column="1" VerticalAlignment="Center">
                                                    <ToggleSwitch x:Name="togParallelQuery" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="srow adv">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnStale}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnStaleHint}" />
                                                </StackPanel>
                                                <Panel Grid.Column="1" VerticalAlignment="Center">
                                                    <ToggleSwitch x:Name="togServeStale" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="srow adv">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnHappy}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnHappyHint}" />
                                                </StackPanel>
                                                <Panel Grid.Column="1" VerticalAlignment="Center">
                                                    <ToggleSwitch x:Name="togEnableHappyEyeballs" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Classes="sgroup">
                                <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.DnGrpLookup}" />
                                <Border Classes="sgroupcard">
                                    <StackPanel>
                                        <Border Classes="srow adv">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnLookupDirect}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnLookupDirectHint}" />
                                                </StackPanel>
                                                <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                                    <ComboBox x:Name="cmbDirectDNSStrategy" PlaceholderText="{x:Static loc:L.DnDefault}" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="srow adv">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnLookupProxy}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnLookupProxyHint}" />
                                                </StackPanel>
                                                <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                                    <ComboBox x:Name="cmbRemoteDNSStrategy" PlaceholderText="{x:Static loc:L.DnDefault}" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="srow adv">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnLookupDial}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnLookupDialHint}" />
                                                </StackPanel>
                                                <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                                    <ComboBox x:Name="cmbProxyDialDNSStrategy" PlaceholderText="{x:Static loc:L.DnDefault}" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="gridAdvancedDNSSettings">
                            <!--  The same warning as at the top; it belongs to the expert part, so it hides with it.  -->
                            <Border Classes="srow adv" MinHeight="0" Padding="0" BorderThickness="0">
                                <TextBlock
                                    x:Name="txtAdvancedDNSSettingsInvalid"
                                    Classes="spagehint"
                                    Margin="0,22,0,0"
                                    Foreground="{DynamicResource V2PingMid}"
                                    Text="{x:Static resx:ResUI.TbCustomDNSEnabledPageInvalid}" />
                            </Border>

                            <StackPanel Classes="sgroup">
                                <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.DnGrpFilters}" />
                                <Border Classes="sgroupcard">
                                    <StackPanel>
                                        <Border Classes="srow adv">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnBlockHttps}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnBlockHttpsHint}" />
                                                </StackPanel>
                                                <Panel Grid.Column="1" VerticalAlignment="Center">
                                                    <ToggleSwitch x:Name="togBlockBindingQuery" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="srow adv">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnBlockIpv6}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnBlockIpv6Hint}" />
                                                </StackPanel>
                                                <Panel Grid.Column="1" VerticalAlignment="Center">
                                                    <ToggleSwitch x:Name="togBlockAAAAQuery" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="srow adv">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnExpected}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnExpectedHint}" />
                                                </StackPanel>
                                                <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                                    <ComboBox x:Name="cmbDirectExpectedIPs" IsEditable="True" PlaceholderText="geoip:ru" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Classes="sgroup">
                                <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.DnGrpHosts}" />
                                <Border Classes="sgroupcard">
                                    <StackPanel>
                                        <Border Classes="srow adv">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnSysHosts}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnSysHostsHint}" />
                                                </StackPanel>
                                                <Panel Grid.Column="1" VerticalAlignment="Center">
                                                    <ToggleSwitch x:Name="togUseSystemHosts" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="srow adv">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Classes="srowtext">
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnCommonHosts}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnCommonHostsHint}" />
                                                </StackPanel>
                                                <Panel Grid.Column="1" VerticalAlignment="Center">
                                                    <ToggleSwitch x:Name="togAddCommonHosts" />
                                                </Panel>
                                            </Grid>
                                        </Border>
                                        <Border Classes="srow stack adv">
                                            <StackPanel Spacing="10">
                                                <StackPanel>
                                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnHosts}" />
                                                    <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnHostsHint}" />
                                                </StackPanel>
                                                <TextBox
                                                    x:Name="txtHosts"
                                                    MinHeight="96"
                                                    AcceptsReturn="True"
                                                    PlaceholderText="example.com 1.2.3.4"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="btnMoreFields" Classes="morefields" Theme="{StaticResource V2Button}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static loc:L.DnTabRay}">
                <DockPanel Margin="12,12,12,8">
                    <StackPanel Classes="sgroup" DockPanel.Dock="Top">
                        <Border Classes="sgroupcard">
                            <StackPanel>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnUseRay}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnUseHint}" />
                                        </StackPanel>
                                        <Panel Grid.Column="1" VerticalAlignment="Center">
                                            <ToggleSwitch x:Name="togRayCustomDNSEnableCompatible" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnReady}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnReadyHint}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                            <HyperlinkButton VerticalAlignment="Center" Classes="WithIcon" Click="linkDnsObjectDoc_Click">
                                                <TextBlock Text="{x:Static loc:L.DnFormatDoc}" />
                                            </HyperlinkButton>
                                            <Button x:Name="btnImportDefConfig4V2rayCompatible" Content="{x:Static loc:L.DnInsert}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <WrapPanel Margin="0,4,0,0" DockPanel.Dock="Bottom" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="{StaticResource Margin4}"
                                VerticalAlignment="Center"
                                Text="{x:Static loc:L.DnSysHosts}" />
                            <ToggleSwitch
                                x:Name="togUseSystemHostsCompatible"
                                Margin="{StaticResource Margin4}"
                                HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="{StaticResource Margin4}"
                                VerticalAlignment="Center"
                                Text="{x:Static loc:L.DnDirectLookup}" />
                            <ComboBox
                                x:Name="cmbdomainStrategy4FreedomCompatible"
                                Width="150"
                                Margin="{StaticResource Margin4}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="{StaticResource Margin4}"
                                VerticalAlignment="Center"
                                Text="{x:Static loc:L.DnServerDns}" />
                            <ComboBox
                                x:Name="cmbdomainDNSAddressCompatible"
                                Width="150"
                                Margin="{StaticResource Margin4}"
                                IsEditable="True" />
                        </StackPanel>
                    </WrapPanel>

                    <Grid Margin="0,12,0,0" ColumnDefinitions="*,10,*">

                        <HeaderedContentControl
                            Grid.Column="0"
                            Classes="editor"
                            Header="{x:Static loc:L.DnProxyMode}">
                            <local:JsonEditor Name="txtnormalDNSCompatible" VerticalAlignment="Stretch" />
                        </HeaderedContentControl>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

                        <HeaderedContentControl
                            Grid.Column="2"
                            Classes="editor"
                            Header="{x:Static loc:L.DnTunMode}">
                            <local:JsonEditor Name="txttunDNSCompatible" VerticalAlignment="Stretch" />
                        </HeaderedContentControl>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="{x:Static loc:L.DnTabSingbox}">
                <DockPanel Margin="12,12,12,8">
                    <StackPanel Classes="sgroup" DockPanel.Dock="Top">
                        <Border Classes="sgroupcard">
                            <StackPanel>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnUseSingbox}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnUseHint}" />
                                        </StackPanel>
                                        <Panel Grid.Column="1" VerticalAlignment="Center">
                                            <ToggleSwitch x:Name="togSBCustomDNSEnableCompatible" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.DnReady}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.DnReadyHint}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                            <HyperlinkButton VerticalAlignment="Center" Classes="WithIcon" Click="linkDnsSingboxObjectDoc_Click">
                                                <TextBlock Text="{x:Static loc:L.DnFormatDoc}" />
                                            </HyperlinkButton>
                                            <Button x:Name="btnImportDefConfig4SingboxCompatible" Content="{x:Static loc:L.DnInsert}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <WrapPanel Margin="0,4,0,0" DockPanel.Dock="Bottom" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="{StaticResource Margin4}"
                                VerticalAlignment="Center"
                                Text="{x:Static loc:L.DnDefaultLookup}" />
                            <ComboBox
                                x:Name="cmbdomainStrategy4OutCompatible"
                                Width="150"
                                Margin="{StaticResource Margin4}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="{StaticResource Margin4}"
                                VerticalAlignment="Center"
                                Text="{x:Static loc:L.DnServerDns}" />
                            <ComboBox
                                x:Name="cmbdomainDNSAddress2Compatible"
                                Width="150"
                                Margin="{StaticResource Margin4}"
                                IsEditable="True" />
                        </StackPanel>
                    </WrapPanel>

                    <Grid Margin="0,12,0,0" ColumnDefinitions="*,10,*">

                        <HeaderedContentControl
                            Grid.Column="0"
                            Classes="editor"
                            Header="{x:Static loc:L.DnProxyMode}">
                            <local:JsonEditor Name="txtnormalDNS2Compatible" VerticalAlignment="Stretch" />
                        </HeaderedContentControl>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

                        <HeaderedContentControl
                            Grid.Column="2"
                            Classes="editor"
                            Header="{x:Static loc:L.DnTunMode}">
                            <local:JsonEditor Name="txttunDNS2Compatible" VerticalAlignment="Stretch" />
                        </HeaderedContentControl>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
