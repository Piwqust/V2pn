<UserControl
    x:Class="v2rayN.Desktop.Views.JsonEditor"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:v2rayN.Desktop"
    xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <ae:TextEditor
        Name="Editor"
        FontFamily="Cascadia Code,Consolas,Monospace"
        ShowLineNumbers="True">
        <ae:TextEditor.ContextMenu>
            <ContextMenu>
                <MenuItem Click="FormatJson_Click" Header="{x:Static loc:L.EdFormat}" />
                <Separator />
                <MenuItem Click="Copy_Click" Header="{x:Static loc:L.EdCopy}" />
                <MenuItem Click="Paste_Click" Header="{x:Static loc:L.EdPaste}" />
                <MenuItem Click="SelectAll_Click" Header="{x:Static loc:L.EdSelectAll}" />
            </ContextMenu>
        </ae:TextEditor.ContextMenu>
    </ae:TextEditor>
</UserControl>
