<Window
    x:Class="v2rayN.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:conv="using:v2rayN.Desktop.Converters"
    xmlns:common="using:v2rayN.Desktop.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:ent="clr-namespace:ServiceLib.Models.Entities;assembly=ServiceLib"
    xmlns:loc="using:v2rayN.Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:side="using:v2rayN.Desktop.ViewModels"
    xmlns:views="using:v2rayN.Desktop.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="V2pn"
    Width="1280"
    Height="800"
    MinWidth="1000"
    MinHeight="640"
    x:DataType="vms:MainWindowViewModel"
    Background="{DynamicResource V2WindowBackground}"
    Design.DataContext="{x:Static dd:DesignData.MainWindow}"
    ExtendClientAreaTitleBarHeightHint="40"
    ExtendClientAreaToDecorationsHint="True"
    WindowDecorations="BorderOnly"
    Icon="/Assets/NotifyIcon1.ico"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <dialogHost:DialogHost CloseOnClickAway="True" DisableOpeningAnimation="True">
        <Grid RowDefinitions="40,*">

            <!--  ───────── Title bar ─────────  -->
            <Grid
                Grid.Row="0"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                Background="Transparent"
                ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                <Button
                    x:Name="btnAppMenu"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    AutomationProperties.Name="{x:Static loc:L.AppMenu}"
                    Margin="8,0,2,0"
                    Classes="ghost icon"
                    Theme="{StaticResource V2Button}"
                    ToolTip.Tip="{x:Static loc:L.AppMenu}">
                    <PathIcon Classes="i16" Data="{StaticResource SemiIconMenu}" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Classes="menuheader" Header="{x:Static loc:L.MenuGrpView}" IsEnabled="False" />
                            <MenuItem x:Name="menuPageLog" Header="{x:Static loc:L.MenuLog}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconTerminal}" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="menuPageTable" Header="{x:Static loc:L.MenuTable}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconListView}" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="menuPageProxies" Header="{x:Static loc:L.MenuClashProxies}" IsVisible="{Binding ShowClashUI}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconServerStroked}" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="menuPageConnections" Header="{x:Static loc:L.MenuClashConnections}" IsVisible="{Binding ShowClashUI}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconActivity}" /></MenuItem.Icon></MenuItem>
                            <Separator />
                            <MenuItem Classes="menuheader" Header="{x:Static loc:L.Subscriptions}" IsEnabled="False" />
                            <MenuItem x:Name="menuSubUpdate" Header="{x:Static loc:L.UpdateAll}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconRefresh}" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="menuSubUpdateViaProxy" Header="{x:Static loc:L.MenuSubUpdateViaVpn}" ToolTip.Tip="{x:Static loc:L.MenuSubUpdateViaVpnDesc}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconRefresh2}" /></MenuItem.Icon></MenuItem>
                            <MenuItem Header="{x:Static loc:L.MenuMore}" IsVisible="False"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconMoreStroked}" /></MenuItem.Icon><MenuItem x:Name="menuSubGroupUpdate" Header="{x:Static resx:ResUI.menuSubGroupUpdate}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconRefresh}" /></MenuItem.Icon></MenuItem><MenuItem x:Name="menuSubGroupUpdateViaProxy" Header="{x:Static resx:ResUI.menuSubGroupUpdateViaProxy}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconRefresh2}" /></MenuItem.Icon></MenuItem></MenuItem>
                            <MenuItem x:Name="menuSubSetting" Header="{x:Static loc:L.MenuSubManage}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconFolderStroked}" /></MenuItem.Icon></MenuItem>
                            <Separator />
                            <MenuItem x:Name="menuReload" Header="{x:Static loc:L.MenuRestartConnection}" InputGesture="F5"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconRotate}" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="menuCheckUpdate" Header="{x:Static loc:L.UpdCheckNow}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconDownloadStroked}" /></MenuItem.Icon></MenuItem>
                            <!--  v2rayN's sponsor link stays in the tree for its code-behind but is not V2pn's to show.  -->
                            <MenuItem x:Name="menuHelp" Header="{x:Static loc:L.Help}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconHelpCircleStroked}" /></MenuItem.Icon><MenuItem x:Name="menuPromotion" Header="{x:Static resx:ResUI.menuPromotion}" IsVisible="False" /></MenuItem>
                            <Separator />
                            <MenuItem x:Name="menuClose" Header="{x:Static loc:L.MenuQuit}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconExit}" /></MenuItem.Icon></MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <StackPanel
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Border
                        Width="20"
                        Height="20"
                        Background="{DynamicResource V2AccentFill}"
                        BoxShadow="inset 0 1 0 0 #59FFFFFF"
                        CornerRadius="6">
                        <Path
                            Width="14"
                            Height="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{StaticResource V2BrandWave}"
                            Stretch="Uniform"
                            Stroke="White"
                            StrokeLineCap="Round"
                            StrokeThickness="1.8" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource V2InkSoft}"
                        Text="{x:Static loc:L.AppName}" />
                </StackPanel>
                <Button
                    x:Name="btnNewUpdate"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    Classes="subtle small"
                    IsVisible="False"
                    Theme="{StaticResource V2Button}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="dot live" />
                        <TextBlock x:Name="txtNewUpdate" Text="{x:Static loc:L.NewVersion}" />
                    </StackPanel>
                </Button>
                <ContentControl
                    x:Name="conTheme"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    Grid.Column="4"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{x:Static loc:L.Appearance}" />
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button
                        x:Name="btnMinimize"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    AutomationProperties.Name="{x:Static loc:L.Minimize}"
                        Classes="caption"
                        Theme="{StaticResource V2Caption}">
                        <PathIcon Classes="i14" Data="{StaticResource SemiIconMinus}" />
                    </Button>
                    <Button
                        x:Name="btnMaximize"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    AutomationProperties.Name="{x:Static loc:L.Maximize}"
                        Classes="caption"
                        Theme="{StaticResource V2Caption}">
                        <PathIcon Classes="i14" Data="{StaticResource SemiIconMaximize}" />
                    </Button>
                    <Button
                        x:Name="btnCloseWindow"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    AutomationProperties.Name="{x:Static loc:L.Close}"
                        Classes="caption close"
                        Theme="{StaticResource V2Caption}">
                        <PathIcon Classes="i14" Data="{StaticResource SemiIconClose}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  ───────── Body ─────────  -->
            <Grid
                Grid.Row="1"
                Margin="10,0,10,10"
                ColumnDefinitions="312,*">

                <!--  Sidebar: a raised panel on the window backdrop  -->
                <Border
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Background="{DynamicResource V2SidebarFill}"
                    BorderBrush="{DynamicResource V2PanelBorder}"
                    BorderThickness="1"
                    BoxShadow="{DynamicResource V2PanelShadow}"
                    CornerRadius="{DynamicResource V2RadiusPanel}">
                    <DockPanel>
                        <Grid
                            Margin="12,12,12,8"
                            ColumnDefinitions="*,Auto"
                            DockPanel.Dock="Top">
                            <TextBox
                                x:Name="txtSearch"
                                Classes="search"
                                ToolTip.Tip="Ctrl+F"
                                PlaceholderText="{x:Static loc:L.SearchServers}">
                                <TextBox.InnerLeftContent>
                                    <PathIcon
                                        Width="14"
                                        Height="14"
                                        Margin="10,0,2,0"
                                        Foreground="{DynamicResource V2Muted}"
                                        Data="{StaticResource SemiIconSearch}" />
                                </TextBox.InnerLeftContent>
                                <TextBox.InnerRightContent>
                                    <Button
                                        x:Name="btnClearSearch"
                                        Margin="0,0,4,0"
                                        AutomationProperties.Name="{x:Static loc:L.ClearSearch}"
                                        Classes="ghost small icon"
                                        IsVisible="False"
                                        Theme="{StaticResource V2Button}"
                                        ToolTip.Tip="{x:Static loc:L.ClearSearch}">
                                        <PathIcon Classes="i12" Data="{StaticResource SemiIconClose}" />
                                    </Button>
                                </TextBox.InnerRightContent>
                            </TextBox>
                            <Button
                                x:Name="btnAdd"
                    AutomationProperties.Name="{x:Static loc:L.AddMenu}"
                                Grid.Column="1"
                                Width="36"
                                Height="36"
                                Margin="8,0,0,0"
                                Classes="subtle icon"
                                Theme="{StaticResource V2Button}"
                                ToolTip.Tip="{x:Static loc:L.AddMenu}">
                                <PathIcon Classes="i16" Data="{StaticResource SemiIconPlus}" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Classes="menuheader" Header="{x:Static loc:L.MenuGrpImport}" IsEnabled="False" />
                                        <MenuItem x:Name="menuAddServerViaClipboard" AutomationProperties.Name="{x:Static loc:L.WelcomePaste}" InputGesture="Ctrl+V" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileBlue}"><PathIcon Data="{StaticResource SemiIconCopyAdd}" /></Border></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.WelcomePaste}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuPasteDesc}" /></StackPanel></MenuItem.Header></MenuItem>
                                        <MenuItem x:Name="menuAddSubscription" AutomationProperties.Name="{x:Static loc:L.AddSubscription}" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileGreen}"><PathIcon Data="{StaticResource SemiIconLink}" /></Border></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.AddSubscription}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuSubDesc}" /></StackPanel></MenuItem.Header></MenuItem>
                                        <MenuItem x:Name="menuAddServerViaScan" Header="{x:Static loc:L.MenuScanScreen}" InputGesture="Ctrl+S" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TilePurple}"><PathIcon Data="{StaticResource SemiIconScan}" /></Border></MenuItem.Icon></MenuItem>
                                        <MenuItem x:Name="menuAddServerViaImage" Header="{x:Static loc:L.MenuScanImage}" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileAmber}"><PathIcon Data="{StaticResource SemiIconImage}" /></Border></MenuItem.Icon></MenuItem>
                                        <Separator />
                                        <MenuItem Classes="menuheader" Header="{x:Static loc:L.MenuGrpManual}" IsEnabled="False" />
                                        <MenuItem x:Name="menuAddServerByProtocol" AutomationProperties.Name="{x:Static loc:L.MenuServerByProtocol}" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileGray}"><PathIcon Data="{StaticResource SemiIconServer}" /></Border></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.MenuServerByProtocol}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuServerDesc}" /></StackPanel></MenuItem.Header><MenuItem x:Name="menuAddVlessServer" Header="{x:Static resx:ResUI.menuAddVlessServer}" /><MenuItem x:Name="menuAddVmessServer" Header="{x:Static resx:ResUI.menuAddVmessServer}" /><MenuItem x:Name="menuAddShadowsocksServer" Header="{x:Static resx:ResUI.menuAddShadowsocksServer}" /><MenuItem x:Name="menuAddTrojanServer" Header="{x:Static resx:ResUI.menuAddTrojanServer}" /><MenuItem x:Name="menuAddHysteria2Server" Header="{x:Static resx:ResUI.menuAddHysteria2Server}" /><MenuItem x:Name="menuAddTuicServer" Header="{x:Static resx:ResUI.menuAddTuicServer}" /><MenuItem x:Name="menuAddWireguardServer" Header="{x:Static resx:ResUI.menuAddWireguardServer}" /><MenuItem x:Name="menuAddAnytlsServer" Header="{x:Static resx:ResUI.menuAddAnytlsServer}" /><MenuItem x:Name="menuAddNaiveServer" Header="{x:Static resx:ResUI.menuAddNaiveServer}" /><MenuItem x:Name="menuAddMasqueServer" Header="{x:Static resx:ResUI.menuAddMasqueServer}" /><MenuItem x:Name="menuAddSocksServer" Header="{x:Static resx:ResUI.menuAddSocksServer}" /><MenuItem x:Name="menuAddHttpServer" Header="{x:Static resx:ResUI.menuAddHttpServer}" /></MenuItem>
                                        <MenuItem x:Name="menuAddPolicyGroupServer" AutomationProperties.Name="{x:Static loc:L.MenuPolicyGroup}" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileTeal}"><PathIcon Data="{StaticResource SemiIconBranch}" /></Border></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.MenuPolicyGroup}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuGroupDesc}" /></StackPanel></MenuItem.Header></MenuItem>
                                        <MenuItem x:Name="menuAddProxyChainServer" AutomationProperties.Name="{x:Static loc:L.MenuProxyChain}" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileAmber}"><PathIcon Data="{StaticResource SemiIconChainStroked}" /></Border></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.MenuProxyChain}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuChainDesc}" /></StackPanel></MenuItem.Header></MenuItem>
                                        <MenuItem x:Name="menuAddCustomServer" Header="{x:Static loc:L.MenuCustomConfig}" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileGray}"><PathIcon Data="{StaticResource SemiIconCode}" /></Border></MenuItem.Icon></MenuItem>
                                        <MenuItem x:Name="menuAddCustomOutboundServer" Header="{x:Static loc:L.MenuCustomOutbound}" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileGray}"><PathIcon Data="{StaticResource SemiIconComponent}" /></Border></MenuItem.Icon></MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <!--  Favorites / countries / subscriptions as one compact switch, so the list gets the height.  -->
                        <ListBox
                            x:Name="lstTabs"
                            Margin="10,0,10,6"
                            Classes="sidetabs"
                            DockPanel.Dock="Top"
                            SelectedIndex="0"
                            Theme="{StaticResource V2Segmented}">
                            <ListBoxItem ToolTip.Tip="Ctrl+1">
                                <StackPanel Spacing="3">
                                    <PathIcon Classes="i16" HorizontalAlignment="Center" Data="{StaticResource SemiIconStarStroked}" />
                                    <TextBlock HorizontalAlignment="Center" Text="{x:Static loc:L.TabFavorites}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem ToolTip.Tip="Ctrl+2">
                                <StackPanel Spacing="3">
                                    <PathIcon Classes="i16" HorizontalAlignment="Center" Data="{StaticResource SemiIconGlobeStroke}" />
                                    <TextBlock HorizontalAlignment="Center" Text="{x:Static loc:L.TabCountries}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem ToolTip.Tip="Ctrl+3">
                                <StackPanel Spacing="3">
                                    <PathIcon Classes="i16" HorizontalAlignment="Center" Data="{StaticResource SemiIconFolderStroked}" />
                                    <TextBlock HorizontalAlignment="Center" Text="{x:Static loc:L.TabSubscriptions}" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <ListBox
                            x:Name="lstRows"
                            Padding="6,4,6,10"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerTheme="{StaticResource V2PlainItem}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.DataTemplates>
                                <DataTemplate x:DataType="side:SideHeaderRow">
                                    <Grid Margin="8,10,0,4" ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Classes="muted small"
                                            Text="{Binding Title}" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="0,-4,-2,-4"
                                            IsVisible="{Binding ShowSubActions}"
                                            Orientation="Horizontal"
                                            Spacing="2">
                                            <Button
                                                AutomationProperties.Name="{x:Static loc:L.UpdateAll}"
                                                Classes="ghost small icon"
                                                Click="SideSubsUpdate_Click"
                                                IsEnabled="{Binding !SubsUpdate.IsBusy, FallbackValue=True}"
                                                Theme="{StaticResource V2Button}"
                                                ToolTip.Tip="{x:Static loc:L.UpdateAll}">
                                                <Panel>
                                                    <PathIcon
                                                        Classes="i14"
                                                        Data="{StaticResource SemiIconRefresh}"
                                                        IsVisible="{Binding !SubsUpdate.IsBusy, FallbackValue=True}" />
                                                    <Path Classes="spinner" IsVisible="{Binding SubsUpdate.IsBusy, FallbackValue=False}" />
                                                </Panel>
                                            </Button>
                                            <Button
                                                AutomationProperties.Name="{x:Static loc:L.AddSubscription}"
                                                Classes="ghost small icon"
                                                Click="SideSubsAdd_Click"
                                                Theme="{StaticResource V2Button}"
                                                ToolTip.Tip="{x:Static loc:L.AddSubscription}">
                                                <PathIcon Classes="i14" Data="{StaticResource SemiIconPlus}" />
                                            </Button>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.Name="{Binding Ping.Label, FallbackValue=''}"
                                            Classes="ghost tiny"
                                            Classes.testing="{Binding Ping.IsTesting, FallbackValue=False}"
                                            Click="SidePing_Click"
                                            IsVisible="{Binding ShowPing}"
                                            Theme="{StaticResource V2Button}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <PathIcon
                                                    Classes="i12"
                                                    Data="{StaticResource SemiIconBolt}"
                                                    IsVisible="{Binding !Ping.IsTesting, FallbackValue=True}" />
                                                <Path
                                                    Classes="spinner"
                                                    IsVisible="{Binding Ping.IsTesting, FallbackValue=False}" />
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Ping.Label, FallbackValue=''}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>

                                <DataTemplate x:DataType="side:SideHintRow">
                                    <TextBlock
                                        Margin="8,4,8,8"
                                        Classes="faint small"
                                        Text="{Binding Text}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>

                                <DataTemplate x:DataType="side:SideServerRow">
                                    <Button
                                        AutomationProperties.Name="{Binding Title}"
                                        Classes="siderow"
                                        Classes.active="{Binding IsActive}"
                                        Classes.indent="{Binding Indent}"
                                        Click="SideServer_Click"
                                        ContextRequested="SideServer_ContextRequested"
                                        Theme="{StaticResource V2SideRow}"
                                        ToolTip.Tip="{x:Static loc:L.ClickToConnect}"
                                        ToolTip.ShowDelay="900">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Panel
                                                Width="26"
                                                Height="20"
                                                VerticalAlignment="Center">
                                                <Border
                                                    Width="24"
                                                    Height="18"
                                                    BoxShadow="{DynamicResource V2FlagRing}"
                                                    ClipToBounds="True"
                                                    CornerRadius="4"
                                                    IsVisible="{Binding ShowFlag}">
                                                    <Image Source="{Binding Flag}" Stretch="UniformToFill" />
                                                </Border>
                                                <PathIcon
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="{DynamicResource V2Faint}"
                                                    Data="{StaticResource SemiIconGlobeStroke}"
                                                    IsVisible="{Binding ShowGlobe}" />
                                                <Border Classes="mono sm" IsVisible="{Binding Indent}">
                                                    <TextBlock Text="{Binding Monogram}" />
                                                </Border>
                                                <Ellipse Classes="badge" IsVisible="{Binding IsActive}" />
                                            </Panel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0,8,0"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                                <TextBlock
                                                    Classes="title"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding Model.Remarks}" />
                                                <DockPanel>
                                                    <PathIcon
                                                        Width="10"
                                                        Height="10"
                                                        Margin="0,0,4,0"
                                                        DockPanel.Dock="Left"
                                                        Foreground="{DynamicResource V2Star}"
                                                        Data="{StaticResource SemiIconStar}"
                                                        IsVisible="{Binding Model.IsFavorite}" />
                                                    <TextBlock
                                                        Classes="faint small"
                                                        Text="{Binding Subtitle}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <Panel Classes="rowinfo">
                                                    <Border
                                                        Classes="pill"
                                                        Classes.bad="{Binding Model.Delay, Converter={x:Static conv:V2pnConverters.IsPingBad}}"
                                                        Classes.good="{Binding Model.Delay, Converter={x:Static conv:V2pnConverters.IsPingGood}}"
                                                        Classes.mid="{Binding Model.Delay, Converter={x:Static conv:V2pnConverters.IsPingMid}}"
                                                        IsVisible="{Binding Model.DelayVal, Converter={x:Static conv:V2pnConverters.IsNotTesting}}">
                                                        <TextBlock Text="{Binding Model.Delay, Converter={x:Static conv:V2pnConverters.PingText}}" />
                                                    </Border>
                                                    <Border Classes="pill" IsVisible="{Binding Model.DelayVal, Converter={x:Static conv:V2pnConverters.IsTesting}}">
                                                        <Path
                                                            HorizontalAlignment="Center"
                                                            Classes="spinner"
                                                            IsVisible="{Binding Model.DelayVal, Converter={x:Static conv:V2pnConverters.IsTesting}}" />
                                                    </Border>
                                                </Panel>
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    Classes="rowactions"
                                                    Orientation="Horizontal">
                                                    <Button
                                                        AutomationProperties.Name="{x:Static loc:L.ToggleFavorite}"
                                                        Classes="ghost small icon star"
                                                        Classes.on="{Binding Model.IsFavorite}"
                                                        Click="SideStar_Click"
                                                        Theme="{StaticResource V2Button}"
                                                        ToolTip.Tip="{x:Static loc:L.ToggleFavorite}">
                                                        <Panel>
                                                            <PathIcon Data="{StaticResource SemiIconStar}" IsVisible="{Binding Model.IsFavorite}" />
                                                            <PathIcon Data="{StaticResource SemiIconStarStroked}" IsVisible="{Binding !Model.IsFavorite}" />
                                                        </Panel>
                                                    </Button>
                                                    <Button
                                                        Margin="0,0,-4,0"
                                                        AutomationProperties.Name="{x:Static loc:L.More}"
                                                        Classes="ghost small icon kebab"
                                                        Click="SideServerMenu_Click"
                                                        Theme="{StaticResource V2Button}"
                                                        ToolTip.Tip="{x:Static loc:L.More}">
                                                        <PathIcon Classes="i14" Data="{StaticResource SemiIconMore}">
                                                            <PathIcon.RenderTransform>
                                                                <RotateTransform Angle="90" />
                                                            </PathIcon.RenderTransform>
                                                        </PathIcon>
                                                    </Button>
                                                </StackPanel>
                                            </Panel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>

                                <DataTemplate x:DataType="side:SideCountryRow">
                                    <Button
                                        AutomationProperties.Name="{Binding Name}"
                                        Classes="siderow"
                                        Classes.open="{Binding IsExpanded}"
                                        Click="SideCountry_Click"
                                        ContextRequested="SideCountry_ContextRequested"
                                        Theme="{StaticResource V2SideRow}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                            <Panel
                                                Width="26"
                                                Height="20"
                                                VerticalAlignment="Center">
                                                <Border
                                                    Width="24"
                                                    Height="18"
                                                    BoxShadow="{DynamicResource V2FlagRing}"
                                                    ClipToBounds="True"
                                                    CornerRadius="4"
                                                    IsVisible="{Binding HasFlag}">
                                                    <Image Source="{Binding Flag}" Stretch="UniformToFill" />
                                                </Border>
                                                <PathIcon
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="{DynamicResource V2Faint}"
                                                    Data="{StaticResource SemiIconGlobeStroke}"
                                                    IsVisible="{Binding !HasFlag}" />
                                                <Ellipse Classes="badge" IsVisible="{Binding HasActive}" />
                                            </Panel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0,8,0"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                                <TextBlock
                                                    Classes="title"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Classes="faint small"
                                                    Text="{Binding Info}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="2"
                                                Classes="pill"
                                                Classes.bad="{Binding BestDelay, Converter={x:Static conv:V2pnConverters.IsPingBad}}"
                                                Classes.good="{Binding BestDelay, Converter={x:Static conv:V2pnConverters.IsPingGood}}"
                                                Classes.mid="{Binding BestDelay, Converter={x:Static conv:V2pnConverters.IsPingMid}}">
                                                <TextBlock Text="{Binding BestDelay, Converter={x:Static conv:V2pnConverters.PingText}}" />
                                            </Border>
                                            <Button
                                                Grid.Column="3"
                                                Margin="4,0,0,0"
                                                AutomationProperties.Name="{x:Static loc:L.ConnectFastestIn}"
                                                Classes="ghost small icon reveal"
                                                Click="SideCountryConnect_Click"
                                                IsEnabled="{Binding BestId, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                Theme="{StaticResource V2Button}"
                                                ToolTip.Tip="{x:Static loc:L.ConnectFastestIn}">
                                                <PathIcon Classes="i14" Data="{StaticResource SemiIconBolt}" />
                                            </Button>
                                            <PathIcon
                                                Grid.Column="4"
                                                Width="12"
                                                Height="12"
                                                Margin="6,0,4,0"
                                                Classes.open="{Binding IsExpanded}"
                                                Classes="chevron"
                                                Data="{StaticResource SemiIconChevronDown}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>

                                <DataTemplate x:DataType="side:SideSubRow">
                                    <Button
                                        AutomationProperties.Name="{Binding Sub.Remarks}"
                                        Classes="siderow subrow"
                                        Classes.usage="{Binding HasUsage}"
                                        Click="SideSub_Click"
                                        ContextRequested="SideSub_ContextRequested"
                                        Theme="{StaticResource V2SideRow}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="subtile" Background="{Binding Tint}">
                                                <Panel>
                                                    <TextBlock Text="{Binding Monogram}" IsVisible="{Binding !Busy.IsBusy}" />
                                                    <Path Classes="spinner" IsVisible="{Binding Busy.IsBusy}" />
                                                </Panel>
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0,8,0"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <TextBlock
                                                    Classes="title"
                                                    Text="{Binding Sub.Remarks}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding Sub.Remarks}" />
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Ellipse
                                                        Margin="0,0,6,0"
                                                        Classes="fresh"
                                                        Classes.ok="{Binding IsFresh}"
                                                        Classes.old="{Binding IsStale}"
                                                        ToolTip.Tip="{Binding Freshness}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Classes="faint small"
                                                        Text="{Binding Info}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <!--  What the provider reports: traffic of the plan and how long it lasts.  -->
                                                <StackPanel
                                                    Classes="subusage"
                                                    IsVisible="{Binding HasUsage}"
                                                    ToolTip.Tip="{Binding Usage.Tooltip, FallbackValue=''}">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock
                                                            Classes="usage"
                                                            Classes.bad="{Binding Usage.RowStartBad, FallbackValue=False}"
                                                            Classes.warn="{Binding Usage.RowStartWarn, FallbackValue=False}"
                                                            Text="{Binding Usage.RowStart, FallbackValue=''}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            Classes="usage"
                                                            Classes.bad="{Binding Usage.RowEndBad, FallbackValue=False}"
                                                            Classes.warn="{Binding Usage.RowEndWarn, FallbackValue=False}"
                                                            Text="{Binding Usage.RowEnd, FallbackValue=''}" />
                                                    </Grid>
                                                    <views:UsageBar
                                                        Classes.bad="{Binding Usage.TrafficBad, FallbackValue=False}"
                                                        Classes.warn="{Binding Usage.TrafficWarn, FallbackValue=False}"
                                                        IsVisible="{Binding Usage.ShowBar, FallbackValue=False}"
                                                        Value="{Binding Usage.Fraction, FallbackValue=0}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Margin="0,0,-4,0"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="2">
                                                <Button
                                                    AutomationProperties.Name="{x:Static loc:L.UpdateSubscription}"
                                                    Classes="ghost small icon reveal"
                                                    Click="SideSubUpdate_Click"
                                                    IsEnabled="{Binding !Busy.IsBusy}"
                                                    Theme="{StaticResource V2Button}"
                                                    ToolTip.Tip="{x:Static loc:L.UpdateSubscription}">
                                                    <PathIcon Classes="i14" Data="{StaticResource SemiIconRefresh}" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.Name="{x:Static loc:L.More}"
                                                    Classes="ghost small icon kebab reveal"
                                                    Click="SideSubMenu_Click"
                                                    Theme="{StaticResource V2Button}"
                                                    ToolTip.Tip="{x:Static loc:L.More}">
                                                    <PathIcon Classes="i14" Data="{StaticResource SemiIconMore}">
                                                        <PathIcon.RenderTransform>
                                                            <RotateTransform Angle="90" />
                                                        </PathIcon.RenderTransform>
                                                    </PathIcon>
                                                </Button>
                                                <PathIcon
                                                    Classes="subchevron"
                                                    Data="{StaticResource SemiIconChevronRight}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>

                                <DataTemplate x:DataType="side:SideActionRow">
                                    <Button
                                        AutomationProperties.Name="{Binding Title}"
                                        Classes="siderow"
                                        Click="SideAction_Click"
                                        Theme="{StaticResource V2SideRow}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Panel
                                                Width="26"
                                                Height="26"
                                                VerticalAlignment="Center">
                                                <Border
                                                    Background="{DynamicResource V2SafeSoft}"
                                                    CornerRadius="7"
                                                    IsVisible="{Binding IsFastest}">
                                                    <PathIcon
                                                        Width="13"
                                                        Height="13"
                                                        Foreground="{DynamicResource V2Safe}"
                                                        Data="{StaticResource SemiIconBolt}" />
                                                </Border>
                                                <PathIcon
                                                    Width="14"
                                                    Height="14"
                                                    Foreground="{DynamicResource V2Muted}"
                                                    Data="{StaticResource SemiIconChevronLeft}"
                                                    IsVisible="{Binding IsBack}" />
                                                <PathIcon
                                                    Width="14"
                                                    Height="14"
                                                    Foreground="{DynamicResource V2Muted}"
                                                    Data="{StaticResource SemiIconPlusCircleStroked}"
                                                    IsVisible="{Binding IsAdd}" />
                                                <PathIcon
                                                    Width="14"
                                                    Height="14"
                                                    Foreground="{DynamicResource V2Muted}"
                                                    Data="{StaticResource SemiIconRefresh}"
                                                    IsVisible="{Binding IsRefresh}" />
                                            </Panel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0,8,0"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                                <TextBlock
                                                    Classes="title"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Classes="faint small"
                                                    IsVisible="{Binding Subtitle, Converter={x:Static conv:V2pnConverters.NotEmpty}}"
                                                    Text="{Binding Subtitle}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="2"
                                                AutomationProperties.Name="{x:Static loc:L.UpdateSubscription}"
                                                Classes="ghost small icon"
                                                Click="SideBackUpdate_Click"
                                                IsVisible="{Binding IsBack}"
                                                Theme="{StaticResource V2Button}"
                                                ToolTip.Tip="{x:Static loc:L.UpdateSubscription}">
                                                <PathIcon Classes="i14" Data="{StaticResource SemiIconRefresh}" />
                                            </Button>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.DataTemplates>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!--  Stage: map, header, feature rail, stats. The outer border casts the shadow,
                      the inner one clips the map to the rounded corners.  -->
                <Border
                    Grid.Column="1"
                    BorderBrush="{DynamicResource V2PanelBorder}"
                    BorderThickness="1"
                    BoxShadow="{DynamicResource V2PanelShadow}"
                    CornerRadius="{DynamicResource V2RadiusPanel}">
                    <Border ClipToBounds="True" CornerRadius="17">
                    <Panel>
                        <views:MapView x:Name="mapView" />

                        <Border
                            x:Name="stateTint"
                            Height="300"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False" />
                        <Border
                            Height="260"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource V2StageFade}"
                            IsHitTestVisible="False" />

                        <!--  Connection header  -->
                        <StackPanel
                            Margin="124,26,124,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Spacing="6">
                            <!--  Protection state, the first thing to read on this screen.  -->
                            <Border
                                x:Name="pillState"
                                Margin="0,0,0,4"
                                HorizontalAlignment="Center"
                                Classes="state">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse x:Name="dotState" Classes="statedot" />
                                    <Path
                                        x:Name="spinState"
                                        Classes="spinner"
                                        IsVisible="False" />
                                    <TextBlock x:Name="txtStatePill" />
                                </StackPanel>
                            </Border>
                            <DockPanel HorizontalAlignment="Center">
                                <Border
                                    x:Name="borderHeaderFlag"
                                    Width="40"
                                    Height="30"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Left"
                                    BoxShadow="0 1 2 0 #59000000, 0 4 12 -2 #4D000000"
                                    ClipToBounds="True"
                                    CornerRadius="6">
                                    <Image x:Name="imgHeaderFlag" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock
                                    x:Name="txtHeaderTitle"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource V2Ink}"
                                    TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock
                                x:Name="txtHeaderSubtitle"
                                HorizontalAlignment="Center"
                                Classes="muted"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="btnConnect"
                                Width="232"
                                Height="44"
                                CornerRadius="22"
                                Margin="0,10,0,0"
                                FontSize="14"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                Theme="{StaticResource V2Button}" />

                            <!--  The two decisions behind Connect: how the computer is protected and what goes
                                  through the server. Both work while disconnected too, then they apply on Connect.  -->
                            <Border
                                x:Name="barConnection"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Classes="floating modebar">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ListBox
                                        x:Name="lstMode"
                                        Classes="mode"
                                        Theme="{StaticResource V2Segmented}">
                                        <ListBoxItem x:Name="itemModeProxy">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <PathIcon Classes="i14" Data="{StaticResource SemiIconGlobeStroke}" />
                                                <TextBlock Text="{x:Static loc:L.ModeProxy}" />
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem x:Name="itemModeVpn">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <PathIcon Classes="i14" Data="{StaticResource SemiIconShieldStroked}" />
                                                <TextBlock Text="{x:Static loc:L.ModeVpn}" />
                                                <Border x:Name="badgeAdmin" Classes="adminbadge">
                                                    <TextBlock Text="{x:Static loc:L.AdminShort}" />
                                                </Border>
                                            </StackPanel>
                                        </ListBoxItem>
                                    </ListBox>
                                    <Border Classes="vsep" />
                                    <Button
                                        x:Name="btnRoute"
                                        Classes="ghost routechip"
                                        Theme="{StaticResource V2Button}"
                                        ToolTip.Tip="{x:Static loc:L.RouteTitle}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <PathIcon Classes="i14" Data="{StaticResource SemiIconRoute}" />
                                            <TextBlock
                                                x:Name="txtRoute"
                                                MaxWidth="230"
                                                TextTrimming="CharacterEllipsis" />
                                            <PathIcon Classes="i12" Data="{StaticResource SemiIconChevronDown}" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <StackPanel Width="380" Spacing="12">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Classes="title" Text="{x:Static loc:L.RouteTitle}" />
                                                        <TextBlock
                                                            Classes="faint small"
                                                            Text="{x:Static loc:L.RouteSubtitle}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="4">
                                                        <Button
                                                            x:Name="btnRouteRussia"
                                                            Classes="routeoption"
                                                            Theme="{StaticResource V2SideRow}">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Spacing="2">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock Classes="routetitle" Text="{x:Static loc:L.RouteRussiaDirect}" />
                                                                        <Border Classes="recommend">
                                                                            <TextBlock Text="{x:Static loc:L.Recommended}" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Classes="routehint" Text="{x:Static loc:L.RouteRussiaDirectHint}" />
                                                                </StackPanel>
                                                                <PathIcon
                                                                    x:Name="tickRouteRussia"
                                                                    Grid.Column="1"
                                                                    Classes="routetick"
                                                                    Data="{StaticResource SemiIconTickCircle}" />
                                                            </Grid>
                                                        </Button>
                                                        <Button
                                                            x:Name="btnRouteBlocked"
                                                            Classes="routeoption"
                                                            Theme="{StaticResource V2SideRow}">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Classes="routetitle" Text="{x:Static loc:L.RouteBlockedOnly}" />
                                                                    <TextBlock Classes="routehint" Text="{x:Static loc:L.RouteBlockedOnlyHint}" />
                                                                </StackPanel>
                                                                <PathIcon
                                                                    x:Name="tickRouteBlocked"
                                                                    Grid.Column="1"
                                                                    Classes="routetick"
                                                                    Data="{StaticResource SemiIconTickCircle}" />
                                                            </Grid>
                                                        </Button>
                                                        <Button
                                                            x:Name="btnRouteAll"
                                                            Classes="routeoption"
                                                            Theme="{StaticResource V2SideRow}">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Classes="routetitle" Text="{x:Static loc:L.RouteAll}" />
                                                                    <TextBlock Classes="routehint" Text="{x:Static loc:L.RouteAllHint}" />
                                                                </StackPanel>
                                                                <PathIcon
                                                                    x:Name="tickRouteAll"
                                                                    Grid.Column="1"
                                                                    Classes="routetick"
                                                                    Data="{StaticResource SemiIconTickCircle}" />
                                                            </Grid>
                                                        </Button>
                                                    </StackPanel>

                                                    <Border
                                                        x:Name="borderRouteBusy"
                                                        Classes="routebusy"
                                                        IsVisible="False">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Path Classes="spinner" IsVisible="{Binding #borderRouteBusy.IsVisible}" />
                                                            <TextBlock
                                                                x:Name="txtRouteBusy"
                                                                VerticalAlignment="Center"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="hairline" />
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Classes="routetitle" Text="{x:Static loc:L.BlockAds}" />
                                                            <TextBlock Classes="routehint" Text="{x:Static loc:L.BlockAdsHint}" />
                                                        </StackPanel>
                                                        <ToggleSwitch
                                                            x:Name="togBlockAds"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            OffContent=""
                                                            OnContent="" />
                                                    </Grid>

                                                    <StackPanel x:Name="panelCustomRoutes" Spacing="12">
                                                        <Border Classes="hairline" />
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Classes="routetitle" Text="{x:Static loc:L.RouteCustom}" />
                                                                <TextBlock Classes="routehint" Text="{x:Static loc:L.RouteCustomHint}" />
                                                            </StackPanel>
                                                            <ComboBox
                                                                x:Name="lstCustomRoutes"
                                                                Grid.Column="1"
                                                                Width="170"
                                                                VerticalAlignment="Center"
                                                                PlaceholderText="{x:Static loc:L.RouteCustomPick}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="ent:RoutingItem">
                                                                        <TextBlock Text="{Binding Remarks, Converter={x:Static common:RoutingPresets.NameConverter}}" TextTrimming="CharacterEllipsis" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </Grid>
                                                    </StackPanel>
                                                    <Button
                                                        x:Name="btnRoutingSettings"
                                                        HorizontalAlignment="Stretch"
                                                        Classes="subtle small"
                                                        Content="{x:Static loc:L.RoutingSettings}"
                                                        Theme="{StaticResource V2Button}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!--  First run: nothing to connect to yet, so the stage asks for a server instead.  -->
                        <Border
                            x:Name="cardWelcome"
                            Width="440"
                            Margin="0,40,0,0"
                            Padding="28,26,28,24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Classes="floating"
                            IsVisible="False">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Classes="display h3"
                                        Text="{x:Static loc:L.WelcomeTitle}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Classes="muted"
                                        LineHeight="20"
                                        Text="{x:Static loc:L.WelcomeText}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <Button
                                        x:Name="btnWelcomePaste"
                                        Height="42"
                                        HorizontalAlignment="Stretch"
                                        Classes="accent"
                                        Content="{x:Static loc:L.WelcomePaste}"
                                        Theme="{StaticResource V2Button}" />
                                    <Grid ColumnDefinitions="*,8,*">
                                        <Button
                                            x:Name="btnWelcomeSub"
                                            HorizontalAlignment="Stretch"
                                            Content="{x:Static loc:L.AddSubscription}"
                                            Theme="{StaticResource V2Button}" />
                                        <Button
                                            x:Name="btnWelcomeQr"
                                            Grid.Column="2"
                                            HorizontalAlignment="Stretch"
                                            Content="{x:Static loc:L.WelcomeQr}"
                                            Theme="{StaticResource V2Button}" />
                                    </Grid>
                                </StackPanel>
                                <!--  What goes through the VPN, decided before the first connection. The Russian
                                      mode needs the runetfreedom lists, downloaded only when the person picks it.  -->
                                <Border Classes="hairline" />
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="routetitle" Text="{x:Static loc:L.RouteTitle}" />
                                    <StackPanel Spacing="4">
                                        <Button
                                            x:Name="btnWelcomeRouteRu"
                                            Classes="routeoption"
                                            Theme="{StaticResource V2SideRow}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Classes="routetitle" Text="{x:Static loc:L.RouteRussiaDirect}" />
                                                        <Border Classes="recommend">
                                                            <TextBlock Text="{x:Static loc:L.Recommended}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Classes="routehint" Text="{x:Static loc:L.WelcomeRouteRuHint}" />
                                                </StackPanel>
                                                <PathIcon
                                                    Grid.Column="1"
                                                    Classes="routetick"
                                                    Data="{StaticResource SemiIconTickCircle}" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            x:Name="btnWelcomeRouteAll"
                                            Classes="routeoption"
                                            Theme="{StaticResource V2SideRow}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Classes="routetitle" Text="{x:Static loc:L.RouteAll}" />
                                                    <TextBlock Classes="routehint" Text="{x:Static loc:L.WelcomeRouteAllHint}" />
                                                </StackPanel>
                                                <PathIcon
                                                    Grid.Column="1"
                                                    Classes="routetick"
                                                    Data="{StaticResource SemiIconTickCircle}" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                    <Border
                                        x:Name="borderWelcomeBusy"
                                        Classes="routebusy"
                                        IsVisible="False">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Classes="spinner" IsVisible="{Binding #borderWelcomeBusy.IsVisible}" />
                                            <TextBlock
                                                x:Name="txtWelcomeBusy"
                                                VerticalAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock
                                        Classes="faint small"
                                        Text="{x:Static loc:L.WelcomeRouteLater}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  Feature rail: DNS and settings. Mode and routing live under the Connect button.  -->
                        <Panel
                            x:Name="railHost"
                            Margin="0,16,16,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            DataContext="{Binding StatusBarViewModel}">
                            <Border
                                Padding="6"
                                x:DataType="vms:StatusBarViewModel"
                                Classes="floating">
                                <StackPanel Spacing="4">
                                    <Button
                                        x:Name="btnRailDns"
                                        Classes="rail"
                                        Theme="{StaticResource V2RailTile}"
                                        ToolTip.Tip="{x:Static resx:ResUI.menuDNSSetting}">
                                        <StackPanel Spacing="6">
                                            <PathIcon
                                                HorizontalAlignment="Center"
                                                Classes="rail"
                                                Data="{StaticResource SemiIconServerStroked}" />
                                            <TextBlock Classes="rail" Text="{x:Static loc:L.RailDns}" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Classes="rail"
                                        Theme="{StaticResource V2RailTile}"
                                        ToolTip.Tip="{x:Static resx:ResUI.menuSetting}">
                                        <StackPanel Spacing="6">
                                            <PathIcon
                                                HorizontalAlignment="Center"
                                                Classes="rail"
                                                Data="{StaticResource SemiIconSettingStroked}" />
                                            <TextBlock Classes="rail" Text="{x:Static loc:L.RailSettings}" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <MenuFlyout Placement="LeftEdgeAlignedTop">
                                                <MenuItem Classes="menuheader" Header="{x:Static loc:L.Settings}" IsEnabled="False" />
                                                <MenuItem x:Name="menuOptionSetting" AutomationProperties.Name="{x:Static loc:L.MenuOptions}" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileGray}"><PathIcon Data="{StaticResource SemiIconSetting}" /></Border></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.MenuOptions}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuOptionsDesc}" /></StackPanel></MenuItem.Header></MenuItem>
                                                <MenuItem x:Name="menuRoutingSetting" AutomationProperties.Name="{x:Static loc:L.MenuRouting}" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileGreen}"><PathIcon Data="{StaticResource SemiIconRoute}" /></Border></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.MenuRouting}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuRoutingDesc}" /></StackPanel></MenuItem.Header></MenuItem>
                                                <MenuItem x:Name="menuDNSSetting" AutomationProperties.Name="DNS" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileBlue}"><PathIcon Data="{StaticResource SemiIconServer}" /></Border></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="DNS" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuDnsDesc}" /></StackPanel></MenuItem.Header></MenuItem>
                                                <MenuItem x:Name="menuGlobalHotkeySetting" AutomationProperties.Name="{x:Static loc:L.MenuHotkeys}" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TilePurple}"><PathIcon Data="{StaticResource SemiIconCommand}" /></Border></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.MenuHotkeys}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuHotkeysDesc}" /></StackPanel></MenuItem.Header></MenuItem>
                                                <MenuItem x:Name="menuFullConfigTemplate" AutomationProperties.Name="{x:Static loc:L.MenuTemplate}" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileAmber}"><PathIcon Data="{StaticResource SemiIconCode}" /></Border></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.MenuTemplate}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuTemplateDesc}" /></StackPanel></MenuItem.Header></MenuItem>
                                                <Separator />
                                                <MenuItem Classes="menuheader" Header="{x:Static loc:L.MenuGrpSystem}" IsEnabled="False" />
                                                <MenuItem x:Name="menuRebootAsAdmin" Header="{x:Static loc:L.MenuRestartAdmin}" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileRed}"><PathIcon Data="{StaticResource SemiIconShield}" /></Border></MenuItem.Icon></MenuItem>
                                                <MenuItem x:Name="menuSettingsSetUWP" AutomationProperties.Name="{x:Static loc:L.MenuUwp}" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileBlue}"><PathIcon Data="{StaticResource SemiIconDesktop}" /></Border></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.MenuUwp}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuUwpDesc}" /></StackPanel></MenuItem.Header></MenuItem>
                                                <MenuItem AutomationProperties.Name="{x:Static loc:L.MenuRegion}" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileTeal}"><PathIcon Data="{StaticResource SemiIconGlobe}" /></Border></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.MenuRegion}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuRegionDesc}" /></StackPanel></MenuItem.Header><MenuItem x:Name="menuRegionalPresetsRussia" Header="{x:Static resx:ResUI.menuRegionalPresetsRussia}"></MenuItem><MenuItem x:Name="menuRegionalPresetsIran" Header="{x:Static resx:ResUI.menuRegionalPresetsIran}"></MenuItem><MenuItem x:Name="menuRegionalPresetsDefault" Header="{x:Static resx:ResUI.menuRegionalPresetsDefault}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconGlobeStroke}" /></MenuItem.Icon></MenuItem></MenuItem>
                                                <Separator />
                                                <MenuItem Classes="menuheader" Header="{x:Static loc:L.MenuGrpData}" IsEnabled="False" />
                                                <MenuItem x:Name="menuBackupAndRestore" Header="{x:Static loc:L.MenuBackup}" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileGray}"><PathIcon Data="{StaticResource SemiIconArchive}" /></Border></MenuItem.Icon></MenuItem>
                                                <MenuItem x:Name="menuOpenTheFileLocation" Header="{x:Static loc:L.MenuOpenFolder}" Classes="rich"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileBlue}"><PathIcon Data="{StaticResource SemiIconFolderOpen}" /></Border></MenuItem.Icon></MenuItem>
                                                <MenuItem x:Name="menuClearServerStatistics" Header="{x:Static loc:L.MenuClearStats}" Classes="rich danger"><MenuItem.Icon><Border Classes="mitile" Background="{DynamicResource V2TileRed}"><PathIcon Data="{StaticResource SemiIconDelete}" /></Border></MenuItem.Icon></MenuItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Panel>

                        <!--  Bottom statistics  -->
                        <ContentControl
                            x:Name="contentStatusBarView"
                            Margin="16"
                            VerticalAlignment="Bottom" />

                        <!--  Secondary pages (log, server table, Clash) slide over the map  -->
                        <DockPanel
                            x:Name="pageOverlay"
                            Background="{DynamicResource V2ContentBackground}"
                            IsVisible="False">
                            <Grid
                                Height="48"
                                Margin="12,0,16,0"
                                ColumnDefinitions="Auto,*"
                                DockPanel.Dock="Top">
                                <Button
                                    x:Name="btnPageBack"
                                    Classes="ghost"
                                    Theme="{StaticResource V2Button}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Classes="i14" Data="{StaticResource SemiIconChevronLeft}" />
                                        <TextBlock Text="{x:Static loc:L.Back}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock
                                    x:Name="txtPageTitle"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Classes="title"
                                    FontSize="15" />
                            </Grid>
                            <Border Classes="hairline" DockPanel.Dock="Top" />
                            <ContentControl x:Name="pageHost" />
                        </DockPanel>
                    </Panel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </dialogHost:DialogHost>
</Window>
