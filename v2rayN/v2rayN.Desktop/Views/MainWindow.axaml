<Window
    x:Class="v2rayN.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:conv="using:v2rayN.Desktop.Converters"
    xmlns:common="using:v2rayN.Desktop.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:dialogHost="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:ent="clr-namespace:ServiceLib.Models.Entities;assembly=ServiceLib"
    xmlns:loc="using:v2rayN.Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:side="using:v2rayN.Desktop.ViewModels"
    xmlns:views="using:v2rayN.Desktop.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="V2pn"
    Width="1280"
    Height="800"
    MinWidth="360"
    MinHeight="560"
    x:DataType="vms:MainWindowViewModel"
    Background="{DynamicResource V2WindowBackground}"
    Design.DataContext="{x:Static dd:DesignData.MainWindow}"
    ExtendClientAreaTitleBarHeightHint="40"
    ExtendClientAreaToDecorationsHint="True"
    WindowDecorations="BorderOnly"
    Icon="/Assets/NotifyIcon1.ico"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <dialogHost:DialogHost CloseOnClickAway="True" DisableOpeningAnimation="True">
        <Grid RowDefinitions="40,*">

            <!--  ───────── Title bar ─────────  -->
            <Grid
                Grid.Row="0"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                Background="Transparent"
                ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
                <Button
                    x:Name="btnAppMenu"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    AutomationProperties.Name="{x:Static loc:L.AppMenu}"
                    Margin="8,0,2,0"
                    Classes="ghost icon"
                    Theme="{StaticResource V2Button}"
                    ToolTip.Tip="{x:Static loc:L.AppMenu}">
                    <PathIcon Classes="i16" Data="{StaticResource SemiIconMenu}" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Classes="menuheader" Header="{x:Static loc:L.MenuGrpView}" IsEnabled="False" />
                            <MenuItem x:Name="menuMiniWindow" Header="{x:Static loc:L.MiniWindow}"><MenuItem.Icon><PathIcon x:Name="iconMenuMini" Classes="mi" Data="{StaticResource SemiIconShrink}" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="menuPageLog" Header="{x:Static loc:L.MenuLog}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconTerminal}" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="menuPageTable" Header="{x:Static loc:L.MenuTable}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconListView}" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="menuPageProxies" Header="{x:Static loc:L.MenuClashProxies}" IsVisible="{Binding ShowClashUI}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconServerStroked}" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="menuPageConnections" Header="{x:Static loc:L.MenuClashConnections}" IsVisible="{Binding ShowClashUI}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconActivity}" /></MenuItem.Icon></MenuItem>
                            <Separator />
                            <MenuItem Classes="menuheader" Header="{x:Static loc:L.Subscriptions}" IsEnabled="False" />
                            <MenuItem x:Name="menuSubUpdate" Header="{x:Static loc:L.UpdateAll}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconRefresh}" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="menuSubUpdateViaProxy" Header="{x:Static loc:L.MenuSubUpdateViaVpn}" ToolTip.Tip="{x:Static loc:L.MenuSubUpdateViaVpnDesc}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconRefresh2}" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="menuPingAll" Header="{x:Static loc:L.TestPingAll}" InputGesture="Ctrl+Shift+R"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconPulse}" /></MenuItem.Icon></MenuItem>
                            <MenuItem Header="{x:Static loc:L.MenuMore}" IsVisible="False"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconMoreStroked}" /></MenuItem.Icon><MenuItem x:Name="menuSubGroupUpdate" Header="{x:Static resx:ResUI.menuSubGroupUpdate}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconRefresh}" /></MenuItem.Icon></MenuItem><MenuItem x:Name="menuSubGroupUpdateViaProxy" Header="{x:Static resx:ResUI.menuSubGroupUpdateViaProxy}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconRefresh2}" /></MenuItem.Icon></MenuItem></MenuItem>
                            <MenuItem x:Name="menuSubSetting" Header="{x:Static loc:L.MenuSubManage}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconFolderStroked}" /></MenuItem.Icon></MenuItem>
                            <Separator />
                            <!--  Settings are looked for in the main menu first; they used to be only behind the tile on the map.  -->
                            <MenuItem x:Name="menuSettingsMain" Header="{x:Static loc:L.Settings}" InputGesture="Ctrl+OemComma"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconSetting}" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="menuTools" Header="{x:Static loc:L.MenuTools}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconMoreStroked}" /></MenuItem.Icon>
                                <MenuItem Classes="menuheader" Header="{x:Static loc:L.MenuGrpData}" IsEnabled="False" />
                                <MenuItem x:Name="menuBackupAndRestore" Header="{x:Static loc:L.MenuBackup}" Classes="rich"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconArchive}" /></MenuItem.Icon></MenuItem>
                                <MenuItem x:Name="menuImportV2rayN" Header="{x:Static loc:L.ImportMenu}" Classes="rich"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconDownloadStroked}" /></MenuItem.Icon><MenuItem Header="{x:Static loc:L.ImportMenuSearching}" IsEnabled="False" /></MenuItem>
                                <MenuItem x:Name="menuOpenTheFileLocation" Header="{x:Static loc:L.MenuOpenFolder}" Classes="rich"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconFolderOpen}" /></MenuItem.Icon></MenuItem>
                                <Separator />
                                <MenuItem Classes="menuheader" Header="{x:Static loc:L.MenuGrpSystem}" IsEnabled="False" />
                                <MenuItem x:Name="menuRebootAsAdmin" Header="{x:Static loc:L.MenuRestartAdmin}" Classes="rich"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconShield}" /></MenuItem.Icon></MenuItem>
                                <MenuItem x:Name="menuSettingsSetUWP" AutomationProperties.Name="{x:Static loc:L.MenuUwp}" Classes="rich"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconDesktop}" /></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.MenuUwp}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuUwpDesc}" /></StackPanel></MenuItem.Header></MenuItem>
                                <MenuItem x:Name="menuRegion" AutomationProperties.Name="{x:Static loc:L.MenuRegion}" Classes="rich"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconGlobe}" /></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.MenuRegion}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuRegionDesc}" /></StackPanel></MenuItem.Header><MenuItem x:Name="menuRegionalPresetsRussia" Header="{x:Static resx:ResUI.menuRegionalPresetsRussia}"></MenuItem><MenuItem x:Name="menuRegionalPresetsIran" Header="{x:Static resx:ResUI.menuRegionalPresetsIran}"></MenuItem><MenuItem x:Name="menuRegionalPresetsDefault" Header="{x:Static resx:ResUI.menuRegionalPresetsDefault}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconGlobeStroke}" /></MenuItem.Icon></MenuItem></MenuItem>
                                <Separator />
                                <MenuItem x:Name="menuClearServerStatistics" Header="{x:Static loc:L.MenuClearStats}" Classes="rich danger"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconDelete}" /></MenuItem.Icon></MenuItem>
                            </MenuItem>
                            <MenuItem x:Name="menuReload" Header="{x:Static loc:L.MenuRestartConnection}" InputGesture="F5"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconRotate}" /></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="menuCheckUpdate" Header="{x:Static loc:L.UpdCheckNow}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconDownloadStroked}" /></MenuItem.Icon></MenuItem>
                            <!--  v2rayN's sponsor link stays in the tree for its code-behind but is not V2pn's to show.  -->
                            <MenuItem x:Name="menuHelp" Header="{x:Static loc:L.Help}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconHelpCircleStroked}" /></MenuItem.Icon><MenuItem x:Name="menuPromotion" Header="{x:Static resx:ResUI.menuPromotion}" IsVisible="False" /></MenuItem>
                            <Separator />
                            <MenuItem x:Name="menuClose" Header="{x:Static loc:L.MenuQuit}"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconExit}" /></MenuItem.Icon></MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <!--  The name is also the edition switcher (MainWindow.Edition.cs): plain V2pn and each partner's look.
                      Not clickable until a verified partner exists, so the title bar still drags the window there.  -->
                <Button
                    x:Name="btnEdition"
                    Grid.Column="1"
                    Margin="0,0,0,0"
                    Padding="6,0"
                    VerticalAlignment="Center"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    Classes="ghost"
                    IsHitTestVisible="False"
                    Theme="{StaticResource V2Button}">
                    <StackPanel
                        x:Name="panelBrand"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Path
                            x:Name="pathBrand"
                            Width="17"
                            Height="18"
                            VerticalAlignment="Center"
                            Data="{StaticResource V2BrandFork}"
                            Fill="{DynamicResource V2Accent}"
                            Stretch="Uniform" />
                        <TextBlock
                            x:Name="txtBrand"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource V2InkSoft}"
                            Text="{x:Static loc:L.AppName}" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="btnNewUpdate"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Classes="subtle small"
                    IsVisible="False"
                    Theme="{StaticResource V2Button}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="dot live" />
                        <TextBlock x:Name="txtNewUpdate" Text="{x:Static loc:L.NewVersion}" />
                    </StackPanel>
                </Button>
                <ContentControl
                    x:Name="conTheme"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    Grid.Column="4"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center" />
                <!--  Mini window and back; the icon and the name follow the size it leads to (MainWindow.Mini.cs).  -->
                <Button
                    x:Name="btnMini"
                    chrome:WindowDecorationProperties.ElementRole="User"
                    Grid.Column="5"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static loc:L.MiniWindow}"
                    Classes="ghost icon"
                    Theme="{StaticResource V2Button}"
                    ToolTip.Tip="{x:Static loc:L.MiniWindow}">
                    <PathIcon x:Name="iconMini" Classes="i16" Data="{StaticResource SemiIconShrink}" />
                </Button>
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <Button
                        x:Name="btnMinimize"
                    chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                    AutomationProperties.Name="{x:Static loc:L.Minimize}"
                        Classes="caption"
                        Theme="{StaticResource V2Caption}">
                        <PathIcon Classes="i14" Data="{StaticResource SemiIconMinus}" />
                    </Button>
                    <Button
                        x:Name="btnMaximize"
                    chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                    AutomationProperties.Name="{x:Static loc:L.Maximize}"
                        Classes="caption"
                        Theme="{StaticResource V2Caption}">
                        <PathIcon x:Name="iconMaximize" Classes="i14" Data="{StaticResource SemiIconMaximize}" />
                    </Button>
                    <Button
                        x:Name="btnCloseWindow"
                    chrome:WindowDecorationProperties.ElementRole="CloseButton"
                    AutomationProperties.Name="{x:Static loc:L.Close}"
                        Classes="caption close"
                        Theme="{StaticResource V2Caption}">
                        <PathIcon Classes="i14" Data="{StaticResource SemiIconClose}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  ───────── Body ─────────  -->
            <!--  Sidebar side and width follow the Appearance page (MainWindow.Appearance.cs).  -->
            <Grid
                x:Name="gridBody"
                Grid.Row="1"
                Margin="10,0,10,10"
                ColumnDefinitions="312,*">

                <!--  Sidebar: a raised panel on the window backdrop  -->
                <Border
                    x:Name="borderSidebar"
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Background="{DynamicResource V2SidebarFill}"
                    BorderBrush="{DynamicResource V2PanelBorder}"
                    BorderThickness="1"
                    BoxShadow="{DynamicResource V2PanelShadow}"
                    CornerRadius="{DynamicResource V2RadiusPanel}">
                    <DockPanel>
                        <Grid
                            Margin="12,12,12,8"
                            ColumnDefinitions="*,Auto"
                            DockPanel.Dock="Top">
                            <TextBox
                                x:Name="txtSearch"
                                AutomationProperties.AcceleratorKey="Ctrl+F"
                                AutomationProperties.Name="{x:Static loc:L.SearchServers}"
                                Classes="search"
                                ToolTip.Tip="Ctrl+F"
                                PlaceholderText="{x:Static loc:L.SearchServers}">
                                <TextBox.InnerLeftContent>
                                    <PathIcon
                                        Width="14"
                                        Height="14"
                                        Margin="10,0,2,0"
                                        Foreground="{DynamicResource V2Muted}"
                                        Data="{StaticResource SemiIconSearch}" />
                                </TextBox.InnerLeftContent>
                                <TextBox.InnerRightContent>
                                    <Button
                                        x:Name="btnClearSearch"
                                        Margin="0,0,4,0"
                                        AutomationProperties.Name="{x:Static loc:L.ClearSearch}"
                                        Classes="ghost small icon"
                                        IsVisible="False"
                                        Theme="{StaticResource V2Button}"
                                        ToolTip.Tip="{x:Static loc:L.ClearSearch}">
                                        <PathIcon Classes="i12" Data="{StaticResource SemiIconClose}" />
                                    </Button>
                                </TextBox.InnerRightContent>
                            </TextBox>
                            <Button
                                x:Name="btnAdd"
                    AutomationProperties.Name="{x:Static loc:L.AddMenu}"
                                Grid.Column="1"
                                Width="36"
                                Height="36"
                                Margin="8,0,0,0"
                                Classes="subtle icon"
                                Theme="{StaticResource V2Button}"
                                ToolTip.Tip="{x:Static loc:L.AddMenu}">
                                <PathIcon Classes="i16" Data="{StaticResource SemiIconPlus}" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Classes="menuheader" Header="{x:Static loc:L.MenuGrpImport}" IsEnabled="False" />
                                        <MenuItem x:Name="menuAddServerViaClipboard" AutomationProperties.Name="{x:Static loc:L.WelcomePaste}" InputGesture="Ctrl+V" Classes="rich"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconCopyAdd}" /></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.WelcomePaste}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuPasteDesc}" /></StackPanel></MenuItem.Header></MenuItem>
                                        <MenuItem x:Name="menuAddSubscription" AutomationProperties.Name="{x:Static loc:L.AddSubscription}" Classes="rich"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconLink}" /></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.AddSubscription}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuSubDesc}" /></StackPanel></MenuItem.Header></MenuItem>
                                        <MenuItem x:Name="menuAddServerViaScan" Header="{x:Static loc:L.MenuScanScreen}" InputGesture="Ctrl+S" Classes="rich"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconScan}" /></MenuItem.Icon></MenuItem>
                                        <MenuItem x:Name="menuAddServerViaImage" Header="{x:Static loc:L.MenuScanImage}" Classes="rich"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconImage}" /></MenuItem.Icon></MenuItem>
                                        <Separator />
                                        <MenuItem Classes="menuheader" Header="{x:Static loc:L.MenuGrpManual}" IsEnabled="False" />
                                        <MenuItem x:Name="menuAddServerByProtocol" AutomationProperties.Name="{x:Static loc:L.MenuServerByProtocol}" Classes="rich"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconServer}" /></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.MenuServerByProtocol}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuServerDesc}" /></StackPanel></MenuItem.Header><MenuItem x:Name="menuAddVlessServer" Header="{x:Static resx:ResUI.menuAddVlessServer}" /><MenuItem x:Name="menuAddVmessServer" Header="{x:Static resx:ResUI.menuAddVmessServer}" /><MenuItem x:Name="menuAddShadowsocksServer" Header="{x:Static resx:ResUI.menuAddShadowsocksServer}" /><MenuItem x:Name="menuAddTrojanServer" Header="{x:Static resx:ResUI.menuAddTrojanServer}" /><MenuItem x:Name="menuAddHysteria2Server" Header="{x:Static resx:ResUI.menuAddHysteria2Server}" /><MenuItem x:Name="menuAddTuicServer" Header="{x:Static resx:ResUI.menuAddTuicServer}" /><MenuItem x:Name="menuAddWireguardServer" Header="{x:Static resx:ResUI.menuAddWireguardServer}" /><MenuItem x:Name="menuAddAnytlsServer" Header="{x:Static resx:ResUI.menuAddAnytlsServer}" /><MenuItem x:Name="menuAddNaiveServer" Header="{x:Static resx:ResUI.menuAddNaiveServer}" /><MenuItem x:Name="menuAddMasqueServer" Header="{x:Static resx:ResUI.menuAddMasqueServer}" /><MenuItem x:Name="menuAddSocksServer" Header="{x:Static resx:ResUI.menuAddSocksServer}" /><MenuItem x:Name="menuAddHttpServer" Header="{x:Static resx:ResUI.menuAddHttpServer}" /></MenuItem>
                                        <MenuItem x:Name="menuAddPolicyGroupServer" AutomationProperties.Name="{x:Static loc:L.MenuPolicyGroup}" Classes="rich"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconBranch}" /></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.MenuPolicyGroup}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuGroupDesc}" /></StackPanel></MenuItem.Header></MenuItem>
                                        <MenuItem x:Name="menuAddProxyChainServer" AutomationProperties.Name="{x:Static loc:L.MenuProxyChain}" Classes="rich"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconChainStroked}" /></MenuItem.Icon><MenuItem.Header><StackPanel><TextBlock Classes="mititle" Text="{x:Static loc:L.MenuProxyChain}" /><TextBlock Classes="midesc" Text="{x:Static loc:L.MenuChainDesc}" /></StackPanel></MenuItem.Header></MenuItem>
                                        <MenuItem x:Name="menuAddCustomServer" Header="{x:Static loc:L.MenuCustomConfig}" Classes="rich"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconCode}" /></MenuItem.Icon></MenuItem>
                                        <MenuItem x:Name="menuAddCustomOutboundServer" Header="{x:Static loc:L.MenuCustomOutbound}" Classes="rich"><MenuItem.Icon><PathIcon Classes="mi" Data="{StaticResource SemiIconComponent}" /></MenuItem.Icon></MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <!--  Favorites / countries / subscriptions as one compact switch, so the list gets the height.  -->
                        <ListBox
                            x:Name="lstTabs"
                            Margin="10,0,10,6"
                            Classes="sidetabs"
                            DockPanel.Dock="Top"
                            SelectedIndex="0"
                            Theme="{StaticResource V2Segmented}">
                            <ListBoxItem AutomationProperties.AcceleratorKey="Ctrl+1" AutomationProperties.Name="{x:Static loc:L.TabFavorites}" ToolTip.Tip="Ctrl+1">
                                <StackPanel Spacing="3">
                                    <PathIcon Classes="i16" HorizontalAlignment="Center" Data="{StaticResource SemiIconStarStroked}" />
                                    <TextBlock HorizontalAlignment="Center" Text="{x:Static loc:L.TabFavorites}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.AcceleratorKey="Ctrl+2" AutomationProperties.Name="{x:Static loc:L.TabCountries}" ToolTip.Tip="Ctrl+2">
                                <StackPanel Spacing="3">
                                    <PathIcon Classes="i16" HorizontalAlignment="Center" Data="{StaticResource SemiIconGlobeStroke}" />
                                    <TextBlock HorizontalAlignment="Center" Text="{x:Static loc:L.TabCountries}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.AcceleratorKey="Ctrl+3" AutomationProperties.Name="{x:Static loc:L.TabSubscriptions}" ToolTip.Tip="Ctrl+3">
                                <StackPanel Spacing="3">
                                    <PathIcon Classes="i16" HorizontalAlignment="Center" Data="{StaticResource SemiIconFolderStroked}" />
                                    <TextBlock HorizontalAlignment="Center" Text="{x:Static loc:L.TabSubscriptions}" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <ListBox
                            x:Name="lstRows"
                            Padding="6,4,6,10"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerTheme="{StaticResource V2PlainItem}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.DataTemplates>
                                <DataTemplate x:DataType="side:SideHeaderRow">
                                    <Grid
                                        Classes="sidehead"
                                        Classes.subactions="{Binding ShowSubActions}"
                                        ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Classes="muted small"
                                            Text="{Binding Title}" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="0,0,-2,0"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding ShowSubActions}"
                                            Orientation="Horizontal"
                                            Spacing="2">
                                            <Button
                                                AutomationProperties.Name="{x:Static loc:L.UpdateAll}"
                                                Classes="ghost small icon"
                                                Click="SideSubsUpdate_Click"
                                                IsEnabled="{Binding !SubsUpdate.IsBusy, FallbackValue=True}"
                                                Theme="{StaticResource V2Button}"
                                                ToolTip.Tip="{x:Static loc:L.UpdateAll}">
                                                <Panel>
                                                    <PathIcon
                                                        Classes="i14"
                                                        Data="{StaticResource SemiIconRefresh}"
                                                        IsVisible="{Binding !SubsUpdate.IsBusy, FallbackValue=True}" />
                                                    <Path Classes="spinner" IsVisible="{Binding SubsUpdate.IsBusy, FallbackValue=False}" />
                                                </Panel>
                                            </Button>
                                            <Button
                                                AutomationProperties.Name="{x:Static loc:L.AddSubscription}"
                                                Classes="ghost small icon"
                                                Click="SideSubsAdd_Click"
                                                Theme="{StaticResource V2Button}"
                                                ToolTip.Tip="{x:Static loc:L.AddSubscription}">
                                                <PathIcon Classes="i14" Data="{StaticResource SemiIconPlus}" />
                                            </Button>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            MinWidth="104"
                                            AutomationProperties.Name="{Binding Ping.Label, FallbackValue=''}"
                                            Classes="ghost tiny"
                                            Classes.testing="{Binding Ping.IsTesting, FallbackValue=False}"
                                            Click="SidePing_Click"
                                            IsVisible="{Binding ShowPing}"
                                            Theme="{StaticResource V2Button}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <PathIcon
                                                    Classes="i12"
                                                    Data="{StaticResource SemiIconBolt}"
                                                    IsVisible="{Binding !Ping.IsTesting, FallbackValue=True}" />
                                                <Path
                                                    Classes="spinner"
                                                    IsVisible="{Binding Ping.IsTesting, FallbackValue=False}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Classes="num"
                                                    Text="{Binding Ping.Label, FallbackValue=''}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>

                                <DataTemplate x:DataType="side:SideHintRow">
                                    <TextBlock
                                        Margin="8,4,8,8"
                                        Classes="muted small"
                                        LineHeight="17"
                                        Text="{Binding Text}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>

                                <!--  V2pn: a subscription's banner and announcement (SubBannerView, V2pnSubDefaults).  -->
                                <DataTemplate x:DataType="side:SideBannerRow">
                                    <views:SubBannerView Margin="4,0,4,6" Banner="{Binding Banner}" />
                                </DataTemplate>

                                <DataTemplate x:DataType="side:SideAnnounceRow">
                                    <StackPanel Margin="8,2,8,8" Spacing="4">
                                        <TextBlock
                                            Classes="small"
                                            LineHeight="17"
                                            Text="{Binding Text}"
                                            TextWrapping="Wrap" />
                                        <!--  Pulled left by its padding, so its label lines up with the text above.  -->
                                        <Button
                                            Margin="-8,0,0,0"
                                            HorizontalAlignment="Left"
                                            Classes="ghost small"
                                            Click="SideAnnounce_Click"
                                            Content="{x:Static loc:L.SubAnnounceMore}"
                                            IsVisible="{Binding HasUrl}"
                                            Theme="{StaticResource V2Button}"
                                            ToolTip.Tip="{Binding Url}" />
                                    </StackPanel>
                                </DataTemplate>

                                <DataTemplate x:DataType="side:SideServerRow">
                                    <Button
                                        AutomationProperties.Name="{Binding Title}"
                                        Classes="siderow"
                                        Classes.active="{Binding IsActive}"
                                        Classes.indent="{Binding Indent}"
                                        Click="SideServer_Click"
                                        ContextRequested="SideServer_ContextRequested"
                                        Theme="{StaticResource V2SideRow}"
                                        ToolTip.Tip="{x:Static loc:L.ClickToConnect}"
                                        ToolTip.ShowDelay="900">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Panel
                                                Width="26"
                                                Height="20"
                                                VerticalAlignment="Center">
                                                <Border
                                                    Width="24"
                                                    Height="18"
                                                    BoxShadow="{DynamicResource V2FlagRing}"
                                                    ClipToBounds="True"
                                                    CornerRadius="4"
                                                    IsVisible="{Binding ShowFlag}">
                                                    <Image Source="{Binding Flag}" Stretch="UniformToFill" />
                                                </Border>
                                                <PathIcon
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="{DynamicResource V2Faint}"
                                                    Data="{StaticResource SemiIconGlobeStroke}"
                                                    IsVisible="{Binding ShowGlobe}" />
                                                <Border Classes="mono sm" IsVisible="{Binding Indent}">
                                                    <TextBlock Text="{Binding Monogram}" />
                                                </Border>
                                                <Ellipse Classes="badge" IsVisible="{Binding IsActive}" />
                                            </Panel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0,8,0"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                                <TextBlock
                                                    Classes="title"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding Model.Remarks}" />
                                                <DockPanel>
                                                    <PathIcon
                                                        Margin="0,0,4,0"
                                                        Classes="i12"
                                                        DockPanel.Dock="Left"
                                                        Foreground="{DynamicResource V2Star}"
                                                        Data="{StaticResource SemiIconStar}"
                                                        IsVisible="{Binding Model.IsFavorite}" />
                                                    <TextBlock
                                                        Classes="muted small"
                                                        Text="{Binding Subtitle}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <!--  V2pn: the partner's note and what the server is for (V2pnPartnerCatalog).  -->
                                                <TextBlock
                                                    Classes="muted small"
                                                    IsVisible="{Binding HasNote}"
                                                    Text="{Binding Note}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding Note}" />
                                                <ItemsControl
                                                    Margin="0,4,0,4"
                                                    IsVisible="{Binding HasPurposes}"
                                                    ItemsSource="{Binding Purposes}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel ItemSpacing="4" LineSpacing="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Border Classes="tag">
                                                                <TextBlock Text="{Binding}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <Panel Classes="rowinfo">
                                                    <Border
                                                        Classes="pill"
                                                        Classes.bad="{Binding Model.Delay, Converter={x:Static conv:V2pnConverters.IsPingBad}}"
                                                        Classes.good="{Binding Model.Delay, Converter={x:Static conv:V2pnConverters.IsPingGood}}"
                                                        Classes.mid="{Binding Model.Delay, Converter={x:Static conv:V2pnConverters.IsPingMid}}"
                                                        ToolTip.Tip="{Binding Model.Delay, Converter={x:Static conv:V2pnConverters.PingText}}">
                                                        <Border.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Converter="{x:Static conv:V2pnConverters.IsNotTesting}" Path="Model.DelayVal" />
                                                                <Binding Converter="{x:Static conv:V2pnConverters.NotZero}" Path="Model.Delay" />
                                                            </MultiBinding>
                                                        </Border.IsVisible>
                                                        <TextBlock Text="{Binding Model.Delay, Converter={x:Static conv:V2pnConverters.PingText}}" />
                                                    </Border>
                                                    <Border Classes="pill" IsVisible="{Binding Model.DelayVal, Converter={x:Static conv:V2pnConverters.IsTesting}}">
                                                        <Path
                                                            HorizontalAlignment="Center"
                                                            Classes="spinner"
                                                            IsVisible="{Binding Model.DelayVal, Converter={x:Static conv:V2pnConverters.IsTesting}}" />
                                                    </Border>
                                                </Panel>
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    Classes="rowactions"
                                                    Orientation="Horizontal">
                                                    <Button
                                                        AutomationProperties.Name="{x:Static loc:L.ToggleFavorite}"
                                                        Classes="ghost small icon star"
                                                        Classes.on="{Binding Model.IsFavorite}"
                                                        Click="SideStar_Click"
                                                        Theme="{StaticResource V2Button}"
                                                        ToolTip.Tip="{x:Static loc:L.ToggleFavorite}">
                                                        <Panel>
                                                            <PathIcon Data="{StaticResource SemiIconStar}" IsVisible="{Binding Model.IsFavorite}" />
                                                            <PathIcon Data="{StaticResource SemiIconStarStroked}" IsVisible="{Binding !Model.IsFavorite}" />
                                                        </Panel>
                                                    </Button>
                                                    <Button
                                                        Margin="0,0,-4,0"
                                                        AutomationProperties.Name="{x:Static loc:L.More}"
                                                        Classes="ghost small icon kebab"
                                                        Click="SideServerMenu_Click"
                                                        Theme="{StaticResource V2Button}"
                                                        ToolTip.Tip="{x:Static loc:L.More}">
                                                        <PathIcon Classes="i14" Data="{StaticResource SemiIconMore}">
                                                            <PathIcon.RenderTransform>
                                                                <RotateTransform Angle="90" />
                                                            </PathIcon.RenderTransform>
                                                        </PathIcon>
                                                    </Button>
                                                </StackPanel>
                                            </Panel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>

                                <DataTemplate x:DataType="side:SideCountryRow">
                                    <Button
                                        AutomationProperties.Name="{Binding Name}"
                                        Classes="siderow"
                                        Classes.open="{Binding IsExpanded}"
                                        Click="SideCountry_Click"
                                        ContextRequested="SideCountry_ContextRequested"
                                        Theme="{StaticResource V2SideRow}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <Panel
                                                Width="26"
                                                Height="20"
                                                VerticalAlignment="Center">
                                                <Border
                                                    Width="24"
                                                    Height="18"
                                                    BoxShadow="{DynamicResource V2FlagRing}"
                                                    ClipToBounds="True"
                                                    CornerRadius="4"
                                                    IsVisible="{Binding HasFlag}">
                                                    <Image Source="{Binding Flag}" Stretch="UniformToFill" />
                                                </Border>
                                                <PathIcon
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="{DynamicResource V2Faint}"
                                                    Data="{StaticResource SemiIconGlobeStroke}"
                                                    IsVisible="{Binding !HasFlag}" />
                                                <Ellipse Classes="badge" IsVisible="{Binding HasActive}" />
                                            </Panel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0,8,0"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                                <!--  A pool's name ("AUTO — Самый быстрый") is longer than a country's; it takes a second line rather than an ellipsis.  -->
                                                <TextBlock
                                                    Classes="title"
                                                    MaxLines="2"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap"
                                                    ToolTip.Tip="{Binding Name}" />
                                                <TextBlock
                                                    Classes="muted small"
                                                    Text="{Binding Info}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <!--  The pill gives way to the bolt on hover, in the same place, like the server rows.  -->
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <Panel Classes="rowinfo">
                                                    <Border
                                                        Classes="pill"
                                                        Classes.bad="{Binding BestDelay, Converter={x:Static conv:V2pnConverters.IsPingBad}}"
                                                        Classes.good="{Binding BestDelay, Converter={x:Static conv:V2pnConverters.IsPingGood}}"
                                                        Classes.mid="{Binding BestDelay, Converter={x:Static conv:V2pnConverters.IsPingMid}}"
                                                        IsVisible="{Binding BestDelay, Converter={x:Static conv:V2pnConverters.NotZero}}"
                                                        ToolTip.Tip="{Binding BestDelay, Converter={x:Static conv:V2pnConverters.PingText}}">
                                                        <TextBlock Text="{Binding BestDelay, Converter={x:Static conv:V2pnConverters.PingText}}" />
                                                    </Border>
                                                </Panel>
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    Classes="rowactions"
                                                    Orientation="Horizontal">
                                                    <Button
                                                        AutomationProperties.Name="{x:Static loc:L.ConnectFastestIn}"
                                                        Classes="ghost small icon"
                                                        Click="SideCountryConnect_Click"
                                                        Theme="{StaticResource V2Button}"
                                                        ToolTip.Tip="{x:Static loc:L.ConnectFastestIn}">
                                                        <PathIcon Classes="i14" Data="{StaticResource SemiIconBolt}" />
                                                    </Button>
                                                </StackPanel>
                                            </Panel>
                                            <PathIcon
                                                Grid.Column="3"
                                                Width="12"
                                                Height="12"
                                                Margin="6,0,4,0"
                                                Classes.open="{Binding IsExpanded}"
                                                Classes="chevron"
                                                Data="{StaticResource SemiIconChevronDown}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>

                                <DataTemplate x:DataType="side:SideSubRow">
                                    <Button
                                        AutomationProperties.Name="{Binding DisplayName}"
                                        Classes="siderow subrow"
                                        Classes.usage="{Binding HasUsage}"
                                        Click="SideSub_Click"
                                        ContextRequested="SideSub_ContextRequested"
                                        Theme="{StaticResource V2SideRow}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border
                                                Classes="subtile"
                                                Background="{Binding Tint}"
                                                ToolTip.Tip="{Binding PartnerTip}">
                                                <Panel>
                                                    <TextBlock Text="{Binding Monogram}">
                                                        <TextBlock.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding Path="!Busy.IsBusy" />
                                                                <Binding Path="!HasMark" />
                                                            </MultiBinding>
                                                        </TextBlock.IsVisible>
                                                    </TextBlock>
                                                    <!--  V2pn: a verified partner's mark (SideSubRow.Mark).  -->
                                                    <Image
                                                        Width="22"
                                                        Height="22"
                                                        IsVisible="{Binding HasMark}"
                                                        Source="{Binding Mark}" />
                                                    <Path Classes="spinner" IsVisible="{Binding Busy.IsBusy}" />
                                                </Panel>
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0,8,0"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <TextBlock
                                                    Classes="title"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding DisplayName}" />
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Ellipse
                                                        Margin="0,0,6,0"
                                                        Classes="fresh"
                                                        Classes.ok="{Binding IsFresh}"
                                                        Classes.old="{Binding IsStale}"
                                                        Classes.failed="{Binding UpdateFailed}"
                                                        ToolTip.Tip="{Binding Freshness}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Classes="muted small subinfo"
                                                        Classes.warn="{Binding UpdateFailed}"
                                                        Text="{Binding Info}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip.Tip="{Binding Info}" />
                                                </Grid>
                                                <!--  What the provider reports: traffic of the plan and how long it lasts.  -->
                                                <StackPanel
                                                    Classes="subusage"
                                                    IsVisible="{Binding HasUsage}"
                                                    ToolTip.Tip="{Binding Usage.Tooltip, FallbackValue=''}">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock
                                                            Classes="usage"
                                                            Classes.bad="{Binding Usage.RowStartBad, FallbackValue=False}"
                                                            Classes.warn="{Binding Usage.RowStartWarn, FallbackValue=False}"
                                                            Text="{Binding Usage.RowStart, FallbackValue=''}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            Classes="usage"
                                                            Classes.bad="{Binding Usage.RowEndBad, FallbackValue=False}"
                                                            Classes.warn="{Binding Usage.RowEndWarn, FallbackValue=False}"
                                                            Text="{Binding Usage.RowEnd, FallbackValue=''}" />
                                                    </Grid>
                                                    <views:UsageBar
                                                        Classes.bad="{Binding Usage.TrafficBad, FallbackValue=False}"
                                                        Classes.warn="{Binding Usage.TrafficWarn, FallbackValue=False}"
                                                        IsVisible="{Binding Usage.ShowBar, FallbackValue=False}"
                                                        Value="{Binding Usage.Fraction, FallbackValue=0}" />
                                                </StackPanel>
                                                <!--  V2pn: the partner closed the subscription's settings (V2pnLocks); said so the person
                                                      never takes it for V2pn being broken.  -->
                                                <Grid
                                                    Margin="0,3,0,0"
                                                    ColumnDefinitions="Auto,*"
                                                    IsVisible="{Binding IsLocked}"
                                                    ToolTip.Tip="{x:Static loc:L.LockedHint}">
                                                    <PathIcon
                                                        Margin="0,2,5,0"
                                                        VerticalAlignment="Top"
                                                        Classes="i12"
                                                        Foreground="{DynamicResource V2Muted}"
                                                        Data="{StaticResource SemiIconLock}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Classes="muted small"
                                                        Text="{Binding LockText}"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                            </StackPanel>
                                            <!--  Actions and chevron overlap: the column keeps the buttons' width, so hovering
                                                  swaps them without moving the text.  -->
                                            <Panel
                                                Grid.Column="2"
                                                Margin="0,0,-4,0"
                                                VerticalAlignment="Center">
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal"
                                                    Spacing="2">
                                                    <Button
                                                        AutomationProperties.Name="{x:Static loc:L.UpdateSubscription}"
                                                        Classes="ghost small icon reveal"
                                                        Click="SideSubUpdate_Click"
                                                        IsEnabled="{Binding !Busy.IsBusy}"
                                                        Theme="{StaticResource V2Button}"
                                                        ToolTip.Tip="{x:Static loc:L.UpdateSubscription}">
                                                        <PathIcon Classes="i14" Data="{StaticResource SemiIconRefresh}" />
                                                    </Button>
                                                    <Button
                                                        AutomationProperties.Name="{x:Static loc:L.More}"
                                                        Classes="ghost small icon kebab reveal"
                                                        Click="SideSubMenu_Click"
                                                        Theme="{StaticResource V2Button}"
                                                        ToolTip.Tip="{x:Static loc:L.More}">
                                                        <PathIcon Classes="i14" Data="{StaticResource SemiIconMore}">
                                                            <PathIcon.RenderTransform>
                                                                <RotateTransform Angle="90" />
                                                            </PathIcon.RenderTransform>
                                                        </PathIcon>
                                                    </Button>
                                                </StackPanel>
                                                <PathIcon
                                                    HorizontalAlignment="Right"
                                                    Classes="subchevron"
                                                    Data="{StaticResource SemiIconChevronRight}" />
                                            </Panel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>

                                <DataTemplate x:DataType="side:SideActionRow">
                                    <Button
                                        AutomationProperties.Name="{Binding Title}"
                                        Classes="siderow"
                                        Click="SideAction_Click"
                                        Theme="{StaticResource V2SideRow}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Panel
                                                Width="26"
                                                Height="26"
                                                VerticalAlignment="Center">
                                                <Border
                                                    Background="{DynamicResource V2SafeSoft}"
                                                    CornerRadius="7"
                                                    IsVisible="{Binding IsFastest}">
                                                    <Panel>
                                                        <PathIcon
                                                            Classes="i14"
                                                            Foreground="{DynamicResource V2Safe}"
                                                            Data="{StaticResource SemiIconBolt}"
                                                            IsVisible="{Binding !Ping.IsTesting, FallbackValue=True}" />
                                                        <Path
                                                            HorizontalAlignment="Center"
                                                            Classes="spinner"
                                                            IsVisible="{Binding Ping.IsTesting, FallbackValue=False}"
                                                            Stroke="{DynamicResource V2Safe}" />
                                                    </Panel>
                                                </Border>
                                                <PathIcon
                                                    Width="14"
                                                    Height="14"
                                                    Foreground="{DynamicResource V2Muted}"
                                                    Data="{StaticResource SemiIconChevronLeft}"
                                                    IsVisible="{Binding IsBack}" />
                                                <PathIcon
                                                    Width="14"
                                                    Height="14"
                                                    Foreground="{DynamicResource V2Muted}"
                                                    Data="{StaticResource SemiIconPlusCircleStroked}"
                                                    IsVisible="{Binding IsAdd}" />
                                                <PathIcon
                                                    Width="14"
                                                    Height="14"
                                                    Foreground="{DynamicResource V2Muted}"
                                                    Data="{StaticResource SemiIconRefresh}"
                                                    IsVisible="{Binding IsRefresh}" />
                                                <PathIcon
                                                    Width="14"
                                                    Height="14"
                                                    Foreground="{DynamicResource V2Muted}"
                                                    Data="{StaticResource SemiIconClose}"
                                                    IsVisible="{Binding IsClearSearch}" />
                                                <PathIcon
                                                    Width="14"
                                                    Height="14"
                                                    Foreground="{DynamicResource V2Muted}"
                                                    Data="{StaticResource SemiIconGlobe}"
                                                    IsVisible="{Binding IsBrowse}" />
                                            </Panel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0,8,0"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                                <TextBlock
                                                    Classes="title"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <!--  The fastest-server row shows its own ping run in place of the subtitle.  -->
                                                <Panel IsVisible="{Binding !Ping.IsTesting, FallbackValue=True}">
                                                    <TextBlock
                                                        Classes="muted small"
                                                        IsVisible="{Binding Subtitle, Converter={x:Static conv:V2pnConverters.NotEmpty}}"
                                                        Text="{Binding Subtitle}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Panel>
                                                <TextBlock
                                                    Classes="muted small"
                                                    IsVisible="{Binding Ping.IsTesting, FallbackValue=False}"
                                                    Text="{Binding Ping.Progress, FallbackValue=''}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="2"
                                                AutomationProperties.Name="{x:Static loc:L.UpdateSubscription}"
                                                Classes="ghost small icon"
                                                Click="SideBackUpdate_Click"
                                                IsVisible="{Binding IsBack}"
                                                Theme="{StaticResource V2Button}"
                                                ToolTip.Tip="{x:Static loc:L.UpdateSubscription}">
                                                <PathIcon Classes="i14" Data="{StaticResource SemiIconRefresh}" />
                                            </Button>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.DataTemplates>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!--  Stage: map, header, feature rail, stats. The outer border casts the shadow,
                      the inner one clips the map to the rounded corners.  -->
                <Border
                    x:Name="borderStage"
                    Grid.Column="1"
                    BorderBrush="{DynamicResource V2PanelBorder}"
                    BorderThickness="1"
                    BoxShadow="{DynamicResource V2PanelShadow}"
                    CornerRadius="{DynamicResource V2RadiusPanel}">
                    <Border ClipToBounds="True" CornerRadius="{DynamicResource V2RadiusPanelInner}">
                    <!--  The ocean colour behind the map is also the plain stage when the map is turned off.  -->
                    <Panel Background="{DynamicResource V2MapOcean}">
                        <views:MapView x:Name="mapView" />

                        <!--  One tint per verdict, crossfaded by opacity: gradients can't be interpolated.  -->
                        <Border
                            x:Name="tintSafe"
                            Height="300"
                            VerticalAlignment="Top"
                            Background="{DynamicResource V2StateTintSafe}"
                            Classes="tint"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <Border
                            x:Name="tintWarn"
                            Height="300"
                            VerticalAlignment="Top"
                            Background="{DynamicResource V2StateTintWarn}"
                            Classes="tint"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <Border
                            x:Name="tintUnsafe"
                            Height="300"
                            VerticalAlignment="Top"
                            Background="{DynamicResource V2StateTintUnsafe}"
                            Classes="tint"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <Border
                            Height="260"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource V2StageFade}"
                            IsHitTestVisible="False" />

                        <!--  Everything a secondary page covers. Hidden while a page is open, so Tab and screen readers
                              cannot reach the controls under it (the header, welcome card, rail and status card).  -->
                        <Panel x:Name="panelStage">
                        <!--  Connection header. Hidden until the first refresh has filled it, so launch never
                              shows an empty pill or a blank Connect button.  -->
                        <StackPanel
                            x:Name="panelHeader"
                            Margin="16,26,16,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Opacity="0"
                            Spacing="6">
                            <!--  Only this part sits beside the rail, so only it keeps clear of it (88 px tiles + padding).
                                  The mini window has no rail and gives the margin back.  -->
                            <StackPanel
                                x:Name="panelHeadline"
                                Margin="108,0,108,0"
                                HorizontalAlignment="Center"
                                Spacing="6">
                            <!--  Protection state, the first thing to read on this screen.  -->
                            <Border
                                x:Name="pillState"
                                Margin="0,0,0,4"
                                HorizontalAlignment="Center"
                                Classes="state">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse x:Name="dotState" Classes="statedot" />
                                    <Path
                                        x:Name="spinState"
                                        Classes="spinner"
                                        IsVisible="False" />
                                    <TextBlock x:Name="txtStatePill" AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>
                            <DockPanel HorizontalAlignment="Center">
                                <Border
                                    x:Name="borderHeaderFlag"
                                    Width="40"
                                    Height="30"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Left"
                                    BoxShadow="0 1 2 0 #59000000, 0 4 12 -2 #4D000000"
                                    ClipToBounds="True"
                                    CornerRadius="6">
                                    <Image x:Name="imgHeaderFlag" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock
                                    x:Name="txtHeaderTitle"
                                    VerticalAlignment="Center"
                                    Classes="display hdr"
                                    TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock
                                x:Name="txtHeaderSubtitle"
                                HorizontalAlignment="Center"
                                Classes="muted"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <!--  Connect and the mode bar share one width: the button stretches to the bar.  -->
                            <StackPanel
                                x:Name="panelConnect"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                Spacing="12">
                            <!--  Content (power icon + label) is set by SetConnectLabel; enabled by the first refresh.  -->
                            <Button
                                x:Name="btnConnect"
                                MinWidth="248"
                                MaxWidth="480"
                                Height="50"
                                CornerRadius="25"
                                FontSize="15"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Stretch"
                                Classes="connectbtn"
                                IsEnabled="False"
                                Theme="{StaticResource V2Button}" />

                            <!--  The two decisions behind Connect: how the computer is protected and what goes
                                  through the server. Both work while disconnected too, then they apply on Connect.  -->
                            <!--  Shown once the route name is in, so its width change is never seen.  -->
                            <Border
                                x:Name="barConnection"
                                HorizontalAlignment="Center"
                                Classes="floating modebar"
                                Opacity="0">
                                <!--  Each half says what it decides, so the bar reads without hovering. Side by side; in a
                                      one-column window the route takes a row of its own (MainWindow.Adaptive.cs).  -->
                                <Grid
                                    x:Name="gridBar"
                                    ColumnDefinitions="Auto,Auto,*"
                                    ColumnSpacing="8"
                                    RowSpacing="10">
                                    <StackPanel x:Name="panelMode" Spacing="3">
                                    <TextBlock Classes="barcaption" Text="{x:Static loc:L.BarMode}" />
                                    <ListBox
                                        x:Name="lstMode"
                                        Classes="mode"
                                        Theme="{StaticResource V2Segmented}">
                                        <ListBoxItem x:Name="itemModeProxy" AutomationProperties.Name="{x:Static loc:L.ModeProxy}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <PathIcon Classes="i14" Data="{StaticResource SemiIconGlobeStroke}" />
                                                <TextBlock Text="{x:Static loc:L.ModeProxy}" />
                                            </StackPanel>
                                        </ListBoxItem>
                                        <ListBoxItem x:Name="itemModeVpn" AutomationProperties.Name="{x:Static loc:L.ModeVpn}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <PathIcon Classes="i14" Data="{StaticResource SemiIconShieldStroked}" />
                                                <TextBlock Text="{x:Static loc:L.ModeVpn}" />
                                                <!--  A lock, not a warning: VPN mode asks for administrator rights once.  -->
                                                <PathIcon
                                                    x:Name="badgeAdmin"
                                                    Classes="i12 adminlock"
                                                    Data="{StaticResource SemiIconLock}" />
                                            </StackPanel>
                                        </ListBoxItem>
                                    </ListBox>
                                    </StackPanel>
                                    <Border x:Name="sepBar" Grid.Column="1" Classes="vsep" />
                                    <StackPanel x:Name="panelRoute" Grid.Column="2" Spacing="3">
                                    <TextBlock
                                        Classes="barcaption"
                                        Text="{x:Static loc:L.BarRoute}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        x:Name="btnRoute"
                                        AutomationProperties.Name="{x:Static loc:L.RouteTitle}"
                                        Classes="ghost routechip"
                                        Theme="{StaticResource V2Button}"
                                        ToolTip.Tip="{x:Static loc:L.RouteTitle}">
                                        <!--  A grid, not a stack, so a narrow window trims the route's name instead of clipping it.  -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                                            <PathIcon Classes="i14" Data="{StaticResource SemiIconRoute}" />
                                            <TextBlock
                                                x:Name="txtRoute"
                                                Grid.Column="1"
                                                MaxWidth="190"
                                                TextTrimming="CharacterEllipsis" />
                                            <PathIcon Grid.Column="2" Classes="i12" Data="{StaticResource SemiIconChevronDown}" />
                                        </Grid>
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <StackPanel Width="420" Spacing="14">
                                                    <StackPanel Margin="4,0" Spacing="3">
                                                        <TextBlock Classes="title" Text="{x:Static loc:L.RouteTitle}" />
                                                        <TextBlock
                                                            Classes="muted small"
                                                            Text="{x:Static loc:L.RouteSubtitle}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <!--  The presets sit on the menu itself; the picked one is marked by its accent icon and radio.  -->
                                                    <Border Classes="routegroup">
                                                        <StackPanel Spacing="2">
                                                            <Button
                                                                x:Name="btnRouteRussia"
                                                                AutomationProperties.Name="{x:Static loc:L.RouteRussiaDirect}"
                                                                Classes="routeoption"
                                                                Theme="{StaticResource V2SideRow}">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                                    <Border Classes="routeicon">
                                                                        <PathIcon Data="{StaticResource SemiIconBranch}" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                            <TextBlock Classes="routetitle" Text="{x:Static loc:L.RouteRussiaDirect}" />
                                                                            <Border Classes="recommend">
                                                                                <TextBlock Text="{x:Static loc:L.Recommended}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Classes="routehint" Text="{x:Static loc:L.RouteRussiaDirectHint}" />
                                                                    </StackPanel>
                                                                    <Panel Grid.Column="2" Classes="routeradio">
                                                                        <Ellipse Classes="routering" />
                                                                        <Ellipse Classes="routedot" />
                                                                    </Panel>
                                                                </Grid>
                                                            </Button>
                                                            <Button
                                                                x:Name="btnRouteBlocked"
                                                                AutomationProperties.Name="{x:Static loc:L.RouteBlockedOnly}"
                                                                Classes="routeoption"
                                                                Theme="{StaticResource V2SideRow}">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                                    <Border Classes="routeicon">
                                                                        <PathIcon Data="{StaticResource SemiIconFilterStroked}" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                                        <TextBlock Classes="routetitle" Text="{x:Static loc:L.RouteBlockedOnly}" />
                                                                        <TextBlock Classes="routehint" Text="{x:Static loc:L.RouteBlockedOnlyHint}" />
                                                                    </StackPanel>
                                                                    <Panel Grid.Column="2" Classes="routeradio">
                                                                        <Ellipse Classes="routering" />
                                                                        <Ellipse Classes="routedot" />
                                                                    </Panel>
                                                                </Grid>
                                                            </Button>
                                                            <Button
                                                                x:Name="btnRouteAll"
                                                                AutomationProperties.Name="{x:Static loc:L.RouteAll}"
                                                                Classes="routeoption"
                                                                Theme="{StaticResource V2SideRow}">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                                    <Border Classes="routeicon">
                                                                        <PathIcon Data="{StaticResource SemiIconGlobeStroke}" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                                        <TextBlock Classes="routetitle" Text="{x:Static loc:L.RouteAll}" />
                                                                        <TextBlock Classes="routehint" Text="{x:Static loc:L.RouteAllHint}" />
                                                                    </StackPanel>
                                                                    <Panel Grid.Column="2" Classes="routeradio">
                                                                        <Ellipse Classes="routering" />
                                                                        <Ellipse Classes="routedot" />
                                                                    </Panel>
                                                                </Grid>
                                                            </Button>
                                                            <!--  The provider's own preset (reviewed routing.json), while its subscription is in use or the preset is on.  -->
                                                            <Button
                                                                x:Name="btnRoutePartner"
                                                                Classes="routeoption"
                                                                IsVisible="False"
                                                                Theme="{StaticResource V2SideRow}">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                                    <Border Classes="routeicon">
                                                                        <PathIcon Data="{StaticResource SemiIconShieldStroked}" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                                        <TextBlock x:Name="txtRoutePartner" Classes="routetitle" />
                                                                        <TextBlock x:Name="txtRoutePartnerHint" Classes="routehint" />
                                                                    </StackPanel>
                                                                    <Panel Grid.Column="2" Classes="routeradio">
                                                                        <Ellipse Classes="routering" />
                                                                        <Ellipse Classes="routedot" />
                                                                    </Panel>
                                                                </Grid>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border
                                                        x:Name="borderRouteBusy"
                                                        Classes="routebusy"
                                                        IsVisible="False">
                                                        <!--  A dock, not a horizontal stack: the failure text is long and has to wrap.  -->
                                                        <DockPanel>
                                                            <Path
                                                                x:Name="spinRouteBusy"
                                                                Margin="0,0,8,0"
                                                                Classes="spinner"
                                                                DockPanel.Dock="Left"
                                                                IsVisible="False" />
                                                            <PathIcon
                                                                x:Name="iconRouteFailed"
                                                                Margin="0,1,8,0"
                                                                Classes="i14 routefail"
                                                                Data="{StaticResource SemiIconAlertCircle}"
                                                                DockPanel.Dock="Left"
                                                                IsVisible="False" />
                                                            <TextBlock
                                                                x:Name="txtRouteBusy"
                                                                VerticalAlignment="Center"
                                                                TextWrapping="Wrap" />
                                                        </DockPanel>
                                                    </Border>

                                                    <!--  Extras keep the icon column of the presets, so every label starts on one line.  -->
                                                    <StackPanel Spacing="16">
                                                        <Grid Classes="routeextra" ColumnDefinitions="Auto,*,Auto">
                                                            <Border Classes="routeicon plain">
                                                                <PathIcon Data="{StaticResource SemiIconMinusCircleStroked}" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Classes="routetitle" Text="{x:Static loc:L.BlockAds}" />
                                                                <TextBlock Classes="routehint" Text="{x:Static loc:L.BlockAdsHint}" />
                                                            </StackPanel>
                                                            <ToggleSwitch
                                                                x:Name="togBlockAds"
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                AutomationProperties.Name="{x:Static loc:L.BlockAds}"
                                                                OffContent=""
                                                                OnContent="" />
                                                        </Grid>

                                                        <Grid
                                                            x:Name="panelCustomRoutes"
                                                            Classes="routeextra"
                                                            ColumnDefinitions="Auto,*,Auto">
                                                            <Border Classes="routeicon plain">
                                                                <PathIcon Data="{StaticResource SemiIconListView}" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock Classes="routetitle" Text="{x:Static loc:L.RouteCustom}" />
                                                                <TextBlock Classes="routehint" Text="{x:Static loc:L.RouteCustomHint}" />
                                                            </StackPanel>
                                                            <ComboBox
                                                                x:Name="lstCustomRoutes"
                                                                Grid.Column="2"
                                                                Width="150"
                                                                VerticalAlignment="Center"
                                                                AutomationProperties.Name="{x:Static loc:L.RouteCustom}"
                                                                PlaceholderText="{x:Static loc:L.RouteCustomPick}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="ent:RoutingItem">
                                                                        <TextBlock Text="{Binding Remarks, Converter={x:Static common:RoutingPresets.NameConverter}}" TextTrimming="CharacterEllipsis" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </Grid>
                                                    </StackPanel>

                                                    <!--  Opens a window, so it reads as a way out of the menu rather than one more setting.  -->
                                                    <StackPanel Spacing="6">
                                                        <Border Classes="hairline" />
                                                        <Button
                                                            x:Name="btnRoutingSettings"
                                                            AutomationProperties.Name="{x:Static loc:L.RoutingSettings}"
                                                            Classes="routelink"
                                                            Theme="{StaticResource V2SideRow}">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                                <Border Classes="routeicon plain">
                                                                    <PathIcon Data="{StaticResource SemiIconSettingStroked}" />
                                                                </Border>
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Classes="routetitle"
                                                                    Text="{x:Static loc:L.RoutingSettings}" />
                                                                <PathIcon
                                                                    Grid.Column="2"
                                                                    Classes="i12 routechevron"
                                                                    Data="{StaticResource SemiIconChevronRight}" />
                                                            </Grid>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            </StackPanel>
                        </StackPanel>

                        <!--  First run: nothing to connect to yet, so the stage asks for a server instead. The card
                              scrolls when the window is shorter than it; the scroller shows and hides with it.  -->
                        <ScrollViewer
                            x:Name="scrollWelcome"
                            Margin="0,40,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalScrollBarVisibility="Disabled"
                            IsVisible="False"
                            VerticalScrollBarVisibility="Auto">
                        <Border
                            x:Name="cardWelcome"
                            Width="440"
                            Padding="28,26,28,24"
                            Classes="floating"
                            IsVisible="False"
                            Opacity="0">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="6">
                                    <!--  Both are reworded when other apps are found: the card then leads with the move.  -->
                                    <TextBlock
                                        x:Name="txtWelcomeTitle"
                                        Classes="display h3"
                                        Text="{x:Static loc:L.WelcomeTitle}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="txtWelcomeLead"
                                        Classes="muted"
                                        LineHeight="20"
                                        Text="{x:Static loc:L.WelcomeText}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <!--  V2pn: servers already set up in another client on this computer are the quickest start of all.
                                      Each app is a row in the same well as the routing modes below: its tile, what it holds and,
                                      with several apps, a tick (all on). One button moves the ticked ones.  -->
                                <StackPanel x:Name="panelWelcomeImport" IsVisible="False" Spacing="14">
                                    <Border Classes="routegroup">
                                        <StackPanel x:Name="panelWelcomeImportApps" Spacing="2" />
                                    </Border>
                                    <Button
                                        x:Name="btnWelcomeImport"
                                        Height="42"
                                        HorizontalAlignment="Stretch"
                                        Classes="accent"
                                        Content="{x:Static loc:L.ImportMoveSelected}"
                                        Theme="{StaticResource V2Button}" />
                                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                                        <Border VerticalAlignment="Center" Classes="hairline" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Classes="muted small"
                                            Text="{x:Static loc:L.ImportOrByHand}" />
                                        <Border
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Classes="hairline" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <Button
                                        x:Name="btnWelcomePaste"
                                        Height="42"
                                        HorizontalAlignment="Stretch"
                                        Classes="accent"
                                        Content="{x:Static loc:L.WelcomePaste}"
                                        Theme="{StaticResource V2Button}" />
                                    <Grid x:Name="gridWelcomeHand" ColumnDefinitions="*,8,*">
                                        <Button
                                            x:Name="btnWelcomeSub"
                                            HorizontalAlignment="Stretch"
                                            Content="{x:Static loc:L.AddSubscription}"
                                            Theme="{StaticResource V2Button}" />
                                        <Button
                                            x:Name="btnWelcomeQr"
                                            Grid.Column="2"
                                            HorizontalAlignment="Stretch"
                                            Content="{x:Static loc:L.WelcomeQr}"
                                            Theme="{StaticResource V2Button}" />
                                    </Grid>
                                </StackPanel>
                                <!--  What goes through the VPN, decided before the first connection. The Russian
                                      mode needs the runetfreedom lists, downloaded only when the person picks it.  -->
                                <Border Classes="hairline" />
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="sectionlabel" Text="{x:Static loc:L.RouteTitle}" />
                                    <Border Classes="routegroup">
                                    <StackPanel Spacing="2">
                                        <Button
                                            x:Name="btnWelcomeRouteRu"
                                            AutomationProperties.Name="{x:Static loc:L.RouteRussiaDirect}"
                                            Classes="routeoption"
                                            Theme="{StaticResource V2SideRow}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Classes="routeicon">
                                                    <PathIcon Data="{StaticResource SemiIconBranch}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Classes="routetitle" Text="{x:Static loc:L.RouteRussiaDirect}" />
                                                        <Border Classes="recommend">
                                                            <TextBlock Text="{x:Static loc:L.Recommended}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Classes="routehint" Text="{x:Static loc:L.WelcomeRouteRuHint}" />
                                                </StackPanel>
                                                <Panel Grid.Column="2" Classes="routeradio">
                                                    <Ellipse Classes="routering" />
                                                    <Ellipse Classes="routedot" />
                                                </Panel>
                                            </Grid>
                                        </Button>
                                        <Button
                                            x:Name="btnWelcomeRouteAll"
                                            AutomationProperties.Name="{x:Static loc:L.RouteAll}"
                                            Classes="routeoption"
                                            Theme="{StaticResource V2SideRow}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Classes="routeicon">
                                                    <PathIcon Data="{StaticResource SemiIconGlobeStroke}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Classes="routetitle" Text="{x:Static loc:L.RouteAll}" />
                                                    <TextBlock Classes="routehint" Text="{x:Static loc:L.WelcomeRouteAllHint}" />
                                                </StackPanel>
                                                <Panel Grid.Column="2" Classes="routeradio">
                                                    <Ellipse Classes="routering" />
                                                    <Ellipse Classes="routedot" />
                                                </Panel>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                    </Border>
                                    <Border
                                        x:Name="borderWelcomeBusy"
                                        Classes="routebusy"
                                        IsVisible="False">
                                        <!--  A dock, not a horizontal stack: the failure text is long and has to wrap.  -->
                                        <DockPanel>
                                            <Path
                                                x:Name="spinWelcomeBusy"
                                                Margin="0,0,8,0"
                                                Classes="spinner"
                                                DockPanel.Dock="Left"
                                                IsVisible="False" />
                                            <PathIcon
                                                x:Name="iconWelcomeFailed"
                                                Margin="0,1,8,0"
                                                Classes="i14 routefail"
                                                Data="{StaticResource SemiIconAlertCircle}"
                                                DockPanel.Dock="Left"
                                                IsVisible="False" />
                                            <TextBlock
                                                x:Name="txtWelcomeBusy"
                                                VerticalAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </DockPanel>
                                    </Border>
                                    <TextBlock
                                        Classes="muted small"
                                        Text="{x:Static loc:L.WelcomeRouteLater}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </ScrollViewer>

                        <!--  Feature rail: DNS and settings. Mode and routing live under the Connect button.  -->
                        <Panel
                            x:Name="railHost"
                            Margin="0,26,16,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            DataContext="{Binding StatusBarViewModel}">
                            <Border
                                Padding="6"
                                x:DataType="vms:StatusBarViewModel"
                                Classes="floating">
                                <StackPanel Spacing="4">
                                    <!--  The everyday action: fresh servers from every subscription. DNS is an expert's
                                          setting; its tile shows only with advanced settings on, and it is always in the menu below.  -->
                                    <Button
                                        x:Name="btnRailUpdate"
                                        AutomationProperties.Name="{x:Static loc:L.UpdateAll}"
                                        Classes="rail"
                                        Theme="{StaticResource V2RailTile}"
                                        ToolTip.Tip="{x:Static loc:L.UpdateAll}">
                                        <StackPanel Spacing="6">
                                            <PathIcon
                                                HorizontalAlignment="Center"
                                                Classes="rail"
                                                Data="{StaticResource SemiIconRefresh}" />
                                            <TextBlock Classes="rail" Text="{x:Static loc:L.RailUpdate}" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="btnRailDns"
                                        AutomationProperties.Name="{x:Static loc:L.RailDns}"
                                        Classes="rail"
                                        Theme="{StaticResource V2RailTile}"
                                        ToolTip.Tip="{x:Static resx:ResUI.menuDNSSetting}">
                                        <StackPanel Spacing="6">
                                            <PathIcon
                                                HorizontalAlignment="Center"
                                                Classes="rail"
                                                Data="{StaticResource SemiIconServerStroked}" />
                                            <TextBlock Classes="rail" Text="{x:Static loc:L.RailDns}" />
                                        </StackPanel>
                                    </Button>

                                    <!--  One way into settings: the same window as Settings in the app menu. The tile used to open a
                                          menu of 13 entries; routing, DNS and hotkeys now sit in that window under "More", the
                                          system and data tools in the app menu under "Tools".  -->
                                    <Button
                                        x:Name="btnRailSettings"
                                        AutomationProperties.Name="{x:Static loc:L.RailSettings}"
                                        Classes="rail"
                                        Theme="{StaticResource V2RailTile}"
                                        ToolTip.Tip="{x:Static resx:ResUI.menuSetting}">
                                        <StackPanel Spacing="6">
                                            <PathIcon
                                                HorizontalAlignment="Center"
                                                Classes="rail"
                                                Data="{StaticResource SemiIconSettingStroked}" />
                                            <TextBlock Classes="rail" Text="{x:Static loc:L.RailSettings}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Panel>

                        <!--  Bottom statistics  -->
                        <ContentControl
                            x:Name="contentStatusBarView"
                            Margin="16"
                            VerticalAlignment="Bottom"
                            Opacity="0" />
                        </Panel>

                        <!--  Secondary pages (log, server table, Clash) slide over the map  -->
                        <DockPanel
                            x:Name="pageOverlay"
                            Background="{DynamicResource V2ContentBackground}"
                            IsVisible="False">
                            <Grid
                                Height="48"
                                Margin="12,0,16,0"
                                ColumnDefinitions="Auto,*"
                                DockPanel.Dock="Top">
                                <Button
                                    x:Name="btnPageBack"
                                    AutomationProperties.Name="{x:Static loc:L.Back}"
                                    Classes="ghost"
                                    Theme="{StaticResource V2Button}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Classes="i14" Data="{StaticResource SemiIconChevronLeft}" />
                                        <TextBlock Text="{x:Static loc:L.Back}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock
                                    x:Name="txtPageTitle"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Classes="title"
                                    FontSize="15" />
                            </Grid>
                            <Border Classes="hairline" DockPanel.Dock="Top" />
                            <ContentControl x:Name="pageHost" />
                        </DockPanel>
                    </Panel>
                    </Border>
                </Border>

                <!--  A partner look with a layout of its own (cabinet, studio, ASCII) covers the sidebar and the
                      stage; MainWindow.Edition.cs fills it and keeps it in step with the window.  -->
                <ContentControl
                    x:Name="editionHost"
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="2"
                    IsVisible="False" />
            </Grid>

            <!--  V2pn: the first-start walkthrough, over everything under the title bar (MainWindow.Onboarding.cs).  -->
            <Panel
                x:Name="onboardingHost"
                Grid.Row="1"
                IsVisible="False" />

            <!--  V2pn: the old look over the new one while a change of look opens (MainWindow.Edition.cs).  -->
            <Image
                x:Name="imgEditionShot"
                Grid.RowSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                IsVisible="False"
                Stretch="Fill" />
        </Grid>
    </dialogHost:DialogHost>
</Window>
