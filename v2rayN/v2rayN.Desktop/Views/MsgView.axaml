<UserControl
    x:Class="v2rayN.Desktop.Views.MsgView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:loc="using:v2rayN.Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="560"
    d:DesignWidth="900"
    Design.DataContext="{x:Static dd:DesignData.Msg}"
    mc:Ignorable="d">
    <!--  The log: a filter and two switches above the text, copy and clear as labelled buttons.  -->
    <DockPanel Margin="28,20,28,24">

        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*"
                    MinWidth="160"
                    MaxWidth="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="cmbMsgFilter"
                AutomationProperties.Name="{x:Static loc:L.LogFilter}"
                Classes="search"
                PlaceholderText="{x:Static loc:L.LogFilter}"
                ToolTip.Tip="{x:Static loc:L.LogFilterTip}">
                <TextBox.InnerLeftContent>
                    <PathIcon
                        Width="14"
                        Height="14"
                        Margin="10,0,2,0"
                        Foreground="{DynamicResource V2Muted}"
                        Data="{StaticResource SemiIconFilterStroked}" />
                </TextBox.InnerLeftContent>
            </TextBox>

            <StackPanel
                Grid.Column="2"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="btnCopy"
                    AutomationProperties.Name="{x:Static loc:L.LogCopyAll}"
                    Click="menuMsgViewCopyAll_Click"
                    Theme="{StaticResource V2Button}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Classes="i14" Data="{StaticResource SemiIconCopy}" />
                        <TextBlock Text="{x:Static loc:L.LogCopyAll}" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="btnClear"
                    AutomationProperties.Name="{x:Static loc:L.LogClear}"
                    Click="menuMsgViewClear_Click"
                    Theme="{StaticResource V2Button}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Classes="i14" Data="{StaticResource SemiIconDeleteStroked}" />
                        <TextBlock Text="{x:Static loc:L.LogClear}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  The two switches get a row of their own: beside the filter they crowded it in Russian.  -->
        <StackPanel
            Margin="2,14,0,0"
            DockPanel.Dock="Top"
            Orientation="Horizontal"
            Spacing="24">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ToggleSwitch
                    x:Name="togAutoRefresh"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static loc:L.LiveAutoRefresh}"
                    IsChecked="True"
                    OffContent=""
                    OnContent="" />
                <TextBlock
                    VerticalAlignment="Center"
                    Classes="muted"
                    Text="{x:Static loc:L.LiveAutoRefresh}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ToggleSwitch
                    x:Name="togScrollToEnd"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static loc:L.LogScrollToEnd}"
                    IsChecked="True"
                    OffContent=""
                    OnContent="" />
                <TextBlock
                    VerticalAlignment="Center"
                    Classes="muted"
                    Text="{x:Static loc:L.LogScrollToEnd}" />
            </StackPanel>
        </StackPanel>

        <Border
            Margin="0,14,0,0"
            Padding="6,10,4,10"
            Classes="card"
            ClipToBounds="True">
            <Panel>
                <avaloniaEdit:TextEditor
                    Name="txtMsg"
                    Padding="8,0"
                    AutomationProperties.Name="{x:Static loc:L.MenuLog}"
                    FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                    FontSize="13"
                    IsReadOnly="True"
                    VerticalScrollBarVisibility="Auto"
                    WordWrap="True">
                    <avaloniaEdit:TextEditor.Options>
                        <avaloniaEdit:TextEditorOptions AllowScrollBelowDocument="False" />
                    </avaloniaEdit:TextEditor.Options>
                    <avaloniaEdit:TextEditor.ContextFlyout>
                        <MenuFlyout>
                            <MenuItem
                                x:Name="menuMsgViewSelectAll"
                                Click="menuMsgViewSelectAll_Click"
                                Header="{x:Static loc:L.LogSelectAll}"
                                InputGesture="Ctrl+A" />
                            <MenuItem
                                x:Name="menuMsgViewCopy"
                                Click="menuMsgViewCopy_Click"
                                Header="{x:Static loc:L.LogCopy}"
                                InputGesture="Ctrl+C" />
                            <MenuItem
                                x:Name="menuMsgViewCopyAll"
                                Click="menuMsgViewCopyAll_Click"
                                Header="{x:Static loc:L.LogCopyAll}" />
                            <Separator />
                            <MenuItem
                                x:Name="menuMsgViewClear"
                                Click="menuMsgViewClear_Click"
                                Header="{x:Static loc:L.LogClear}" />
                        </MenuFlyout>
                    </avaloniaEdit:TextEditor.ContextFlyout>
                </avaloniaEdit:TextEditor>

                <!--  Empty state  -->
                <StackPanel
                    x:Name="panelEmpty"
                    MaxWidth="420"
                    Margin="24,64"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Spacing="10">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Classes="display h2"
                        Text="{x:Static loc:L.LogEmptyTitle}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Classes="muted"
                        Text="{x:Static loc:L.LogEmptyHint}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Panel>
        </Border>
    </DockPanel>
</UserControl>
