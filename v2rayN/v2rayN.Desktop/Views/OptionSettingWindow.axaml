<Window
    x:Class="v2rayN.Desktop.Views.OptionSettingWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:loc="using:v2rayN.Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.menuSetting}"
    Width="1060"
    Height="700"
    MinWidth="880"
    MinHeight="520"
    x:DataType="vms:OptionSettingViewModel"
    Design.DataContext="{x:Static dd:DesignData.OptionSetting}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <!--
        Settings, regrouped by what they do for the user rather than by v2rayN's config sections.
        Every control keeps its v2rayN name, so the bindings in the code-behind are unchanged.
    -->
    <DockPanel>
        <Border Classes="dialogfooter" DockPanel.Dock="Bottom">
            <StackPanel Classes="footer">
                <Button
                    x:Name="btnSave"
                    Content="{x:Static loc:L.Save}"
                    IsDefault="True" />
                <Button
                    x:Name="btnCancel"
                    Content="{x:Static resx:ResUI.TbCancel}"
                    IsCancel="True" />
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="264,*">
            <Border Classes="settingsnav">
                <DockPanel Margin="12,14,12,12">
                    <TextBox
                        x:Name="txtSearch"
                        Margin="0,0,0,12"
                        AutomationProperties.Name="{x:Static loc:L.SearchSettings}"
                        Classes="search"
                        DockPanel.Dock="Top"
                        PlaceholderText="{x:Static loc:L.SearchSettings}">
                        <TextBox.InnerLeftContent>
                            <PathIcon
                                Width="14"
                                Height="14"
                                Margin="10,0,2,0"
                                Foreground="{DynamicResource V2Muted}"
                                Data="{StaticResource SemiIconSearch}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <Border Classes="advswitch" DockPanel.Dock="Bottom">
                        <!--  The hint runs under the switch too: beside it, the narrow nav column left the
                              title cut and the hint pressed against the knob.  -->
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock
                                VerticalAlignment="Center"
                                Classes="advtitle"
                                Text="{x:Static loc:L.SetAdvanced}"
                                TextWrapping="Wrap" />
                            <ToggleSwitch
                                x:Name="togAdvanced"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="{x:Static loc:L.SetAdvanced}"
                                OffContent=""
                                OnContent="" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,0,4,0"
                                Classes="advhint"
                                Text="{x:Static loc:L.SetAdvancedHint}" />
                        </Grid>
                    </Border>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <ListBox
                        x:Name="lstNav"
                        SelectedIndex="0"
                        Theme="{StaticResource V2NavList}">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Classes="nav" Data="{StaticResource SemiIconSettingStroked}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static loc:L.SetGeneral}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Classes="nav" Data="{StaticResource SemiIconLink}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static loc:L.SetInbound}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Classes="nav" Data="{StaticResource SemiIconGlobeStroke}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static loc:L.SetSysProxy}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Classes="nav" Data="{StaticResource SemiIconShieldStroked}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static loc:L.SetTun}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Classes="nav" Data="{StaticResource SemiIconBolt}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static loc:L.SetBypass}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Classes="adv">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Classes="nav" Data="{StaticResource SemiIconFilterStroked}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static loc:L.SetTraffic}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Classes="adv">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Classes="nav" Data="{StaticResource SemiIconPulse}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static loc:L.SetTests}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Classes="nav" Data="{StaticResource SemiIconDownloadStroked}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static loc:L.SetUpdates}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Classes="adv">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Classes="nav" Data="{StaticResource SemiIconServerStroked}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static loc:L.SetCores}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Classes="adv">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Classes="nav" Data="{StaticResource SemiIconTerminal}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static loc:L.SetLogs}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                    <!--  Settings that live in windows of their own. They open over this one, which stays open.  -->
                    <StackPanel x:Name="panelMore" Margin="0,16,0,8">
                        <TextBlock Classes="navgroup" Text="{x:Static loc:L.SetMore}" />
                        <Button
                            x:Name="btnMoreRouting"
                            Classes="navlink ghost"
                            Theme="{StaticResource V2Button}"
                            ToolTip.Tip="{x:Static loc:L.SetMoreTip}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Classes="nav" Data="{StaticResource SemiIconRoute}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Static loc:L.RtListTitle}"
                                    TextTrimming="CharacterEllipsis" />
                                <PathIcon
                                    Grid.Column="2"
                                    Classes="navopen"
                                    Data="{StaticResource SemiIconExternalOpenStroked}" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="btnMoreDns"
                            Classes="navlink ghost"
                            Theme="{StaticResource V2Button}"
                            ToolTip.Tip="{x:Static loc:L.SetMoreTip}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Classes="nav" Data="{StaticResource SemiIconServerStroked}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Static loc:L.RailDns}"
                                    TextTrimming="CharacterEllipsis" />
                                <PathIcon
                                    Grid.Column="2"
                                    Classes="navopen"
                                    Data="{StaticResource SemiIconExternalOpenStroked}" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="btnMoreHotkeys"
                            Classes="navlink ghost"
                            Theme="{StaticResource V2Button}"
                            ToolTip.Tip="{x:Static loc:L.SetMoreTip}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Classes="nav" Data="{StaticResource SemiIconCommand}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Static loc:L.MenuHotkeys}"
                                    TextTrimming="CharacterEllipsis" />
                                <PathIcon
                                    Grid.Column="2"
                                    Classes="navopen"
                                    Data="{StaticResource SemiIconExternalOpenStroked}" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="btnMoreTemplate"
                            Classes="navlink ghost"
                            Theme="{StaticResource V2Button}"
                            ToolTip.Tip="{x:Static loc:L.SetMoreTip}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Classes="nav" Data="{StaticResource SemiIconCode}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Static loc:L.MenuTemplate}"
                                    TextTrimming="CharacterEllipsis" />
                                <PathIcon
                                    Grid.Column="2"
                                    Classes="navopen"
                                    Data="{StaticResource SemiIconExternalOpenStroked}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ScrollViewer
                x:Name="svContent"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,24,32,32" Spacing="6">
                    <StackPanel x:Name="pageGeneral" Classes="spage">
                        <TextBlock Classes="spagetitle" Text="{x:Static loc:L.SetGeneral}" />
                        <TextBlock Classes="spagehint" Text="{x:Static loc:L.SetGeneralHint}" />
                        <StackPanel Classes="sgroup">
                            <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.GrpStartup}" />
                            <Border Classes="sgroupcard">
                                <StackPanel>
                                    <Border Classes="srow">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconPlayCircle}" /></Border>
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock x:Name="tbAutoRun" Classes="srowtitle" Text="{x:Static loc:L.SetAutoRun}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.SetAutoRunHint}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <ToggleSwitch x:Name="togAutoRun" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconShrink}" /></Border>
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SetStartHidden}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.SetStartHiddenHint}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <ToggleSwitch x:Name="togAutoHideStartup" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconMinimize}" /></Border>
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsHide2TrayWhenClose}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.SetHideToTrayHint}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <ToggleSwitch x:Name="togHide2TrayWhenClose" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow mac">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconApps}" /></Border>
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsMacOSShowInDock}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <ToggleSwitch x:Name="togMacOSShowInDock" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Classes="sgroup">
                            <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.GrpInterface}" />
                            <Border Classes="sgroupcard">
                                <StackPanel>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon blank" />
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsCurrentFontFamily}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static resx:ResUI.TbSettingsCurrentFontFamilyLinuxTip}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbcurrentFontFamily" Width="240" IsEditable="True" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconActivity}" /></Border>
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SetShowSpeed}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.SetShowSpeedHint}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <ToggleSwitch x:Name="togDisplayRealTimeSpeed" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon blank" />
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsStatistics}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <ToggleSwitch x:Name="togEnableStatistics" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon blank" />
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsMainGirdOrientation}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.HintGridOrientation}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbMainGirdOrientation" Width="240" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Classes="sgroup">
                            <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.GrpServerList}" />
                            <Border Classes="sgroupcard">
                                <StackPanel>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsDoubleClick2Activate}" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ToggleSwitch x:Name="togDoubleClick2Activate" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsEnableDragDropSort}" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ToggleSwitch x:Name="togEnableDragDropSort" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsEnableAutoAdjustMainLvColWidth}" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ToggleSwitch x:Name="togEnableAutoAdjustMainLvColWidth" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsKeepOlderDedupl}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.HintKeepOlder}" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ToggleSwitch x:Name="togKeepOlderDedupl" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="pageInbound" Classes="spage" IsVisible="False">
                        <TextBlock Classes="spagetitle" Text="{x:Static loc:L.SetInbound}" />
                        <TextBlock Classes="spagehint" Text="{x:Static loc:L.SetInboundHint}" />
                        <StackPanel Classes="sgroup">
                            <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.GrpPort}" />
                            <Border Classes="sgroupcard">
                                <StackPanel>
                                    <Border Classes="srow">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconLink}" /></Border>
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SetPort}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.SetPortHint}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBox x:Name="txtlocalPort" Width="140" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon blank" />
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsSecondLocalPortEnabled}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.HintSecondPort}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <ToggleSwitch x:Name="togSecondLocalPortEnabled" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon blank" />
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsUdpEnabled}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.HintUdp}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <ToggleSwitch x:Name="togudpEnabled" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Classes="sgroup">
                            <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.GrpLan}" />
                            <Border Classes="sgroupcard">
                                <StackPanel>
                                    <Border Classes="srow">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconWifi}" /></Border>
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SetLan}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.SetLanHint}" />
                                                <TextBlock
                                                    x:Name="txtLanWarning"
                                                    Classes="srowhint"
                                                    Foreground="{DynamicResource V2PingMid}"
                                                    IsVisible="False"
                                                    Text="{x:Static loc:L.LanOpenWarning}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <ToggleSwitch x:Name="togAllowLANConn" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon blank" />
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsNewPort4LAN}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.HintNewPortLan}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <ToggleSwitch x:Name="togNewPort4LAN" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon blank" />
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsUser}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBox x:Name="txtuser" Width="240" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon blank" />
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsPass}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBox x:Name="txtpass" Width="240" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="pageSysProxy" Classes="spage" IsVisible="False">
                        <TextBlock Classes="spagetitle" Text="{x:Static loc:L.SetSysProxy}" />
                        <TextBlock Classes="spagehint" Text="{x:Static loc:L.SetSysProxyHint}" />
                        <StackPanel Classes="sgroup">
                            <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.GrpProxyMethod}" />
                            <Border Classes="sgroupcard">
                                <StackPanel>
                                    <Border Classes="srow">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconGlobeStroke}" /></Border>
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static loc:L.ProxyMethod}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.ProxyMethodHint}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbProxyMethod" Width="280" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Classes="sgroup">
                            <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.GrpProxyRules}" />
                            <Border Classes="sgroupcard">
                                <StackPanel>
                                    <Border Classes="srow win adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsNotProxyLocalAddress}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.HintNotProxyLocal}" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ToggleSwitch x:Name="tognotProxyLocalAddress" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow win adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsAdvancedProtocol}" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbsystemProxyAdvancedProtocol" Width="240" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Classes="sgroup">
                            <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.GrpExceptions}" />
                            <Border Classes="sgroupcard">
                                <StackPanel>
                                    <Border Classes="srow stack adv">
                                        <StackPanel Spacing="10">
                                            <StackPanel>
                                                <TextBlock Classes="srowtitle" Text="{x:Static loc:L.ProxyExceptions}" />
                                                <TextBlock Classes="srowhint" IsVisible="{Binding BlIsWindows}" Text="{x:Static resx:ResUI.TbSettingsExceptionTip}" />
                                                <TextBlock Classes="srowhint" IsVisible="{Binding BlIsNonWindows}" Text="{x:Static resx:ResUI.TbSettingsExceptionTip2}" />
                                            </StackPanel>
                                            <TextBox x:Name="txtsystemProxyExceptions" Height="110" AcceptsReturn="True" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Classes="sgroup">
                            <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.GrpFiles}" />
                            <Border Classes="sgroupcard">
                                <StackPanel>
                                    <Border Classes="srow win adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsCustomSystemProxyPacPath}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.HintPacPath}" />
