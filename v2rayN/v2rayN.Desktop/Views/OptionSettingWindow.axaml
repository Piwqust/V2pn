                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbMixedConcurrencyCount" Width="140" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsSpeedTestTimeout}" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbSpeedTestTimeout" Width="140" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Classes="sgroup">
                            <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.GrpTestTargets}" />
                            <Border Classes="sgroupcard">
                                <StackPanel>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsSpeedPingTestUrl}" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbSpeedPingTestUrl" Width="320" IsEditable="True" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsSpeedTestUrl}" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbSpeedTestUrl" Width="320" IsEditable="True" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsUdpTestUrl}" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbUdpTestTarget" Width="320" IsEditable="True" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsIPAPIUrl}" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbIPAPIUrl" Width="320" IsEditable="True" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="pageUpdates" Classes="spage" IsVisible="False">
                        <TextBlock Classes="spagetitle" Text="{x:Static loc:L.SetUpdates}" />
                        <TextBlock Classes="spagehint" Text="{x:Static loc:L.SetUpdatesHint}" />
                        <StackPanel Classes="sgroup">
                            <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.GrpGeo}" />
                            <Border Classes="sgroupcard">
                                <StackPanel>
                                    <Border Classes="srow">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon"><PathIcon Data="{StaticResource SemiIconRefresh}" /></Border>
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static loc:L.SetGeoInterval}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.SetGeoIntervalHint}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBox x:Name="txtautoUpdateInterval" Width="140" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon blank" />
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsGeoFilesSource}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static resx:ResUI.TbSettingsChinaUserTip}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbGetFilesSourceUrl" Width="320" IsEditable="True" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon blank" />
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsSrsFilesSource}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static resx:ResUI.TbSettingsChinaUserTip}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbSrsFilesSourceUrl" Width="320" IsEditable="True" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Classes="srowicon blank" />
                                            <StackPanel Grid.Column="1" Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsRoutingRulesSource}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static resx:ResUI.TbSettingsChinaUserTip}" />
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbRoutingRulesSourceUrl" Width="320" IsEditable="True" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Classes="sgroup">
                            <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.GrpNetwork}" />
                            <Border Classes="sgroupcard">
                                <StackPanel>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsSubConvert}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.HintSubConvert}" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbSubConvertUrl" Width="320" IsEditable="True" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbRootCertificateProvider}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static resx:ResUI.TbRootCertificateProviderTip}" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbRootCertificateProvider" Width="200" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="pageCores" Classes="spage adv" IsVisible="False">
                        <TextBlock Classes="spagetitle" Text="{x:Static loc:L.SetCores}" />
                        <TextBlock Classes="spagehint" Text="{x:Static loc:L.SetCoresHint}" />
                        <StackPanel Classes="sgroup">
                            <Border Classes="sgroupcard">
                                <StackPanel>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="VLESS" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbCoreType5" Width="200" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="VMess" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbCoreType1" Width="200" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="Trojan" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbCoreType6" Width="200" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="Shadowsocks" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbCoreType3" Width="200" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="Hysteria2" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbCoreType7" Width="200" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="Wireguard" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbCoreType9" Width="200" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="MASQUE" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbCoreType14" Width="200" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="Socks" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbCoreType4" Width="200" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="Custom Pre" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbCoreType2" Width="200" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="pageLogs" Classes="spage adv" IsVisible="False">
                        <TextBlock Classes="spagetitle" Text="{x:Static loc:L.SetLogs}" />
                        <TextBlock Classes="spagehint" Text="{x:Static loc:L.SetLogsHint}" />
                        <StackPanel Classes="sgroup">
                            <Border Classes="sgroupcard">
                                <StackPanel>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsLogEnabledToFile}" />
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.HintLogToFile}" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ToggleSwitch x:Name="toglogEnabled" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                    <Border Classes="srow adv">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Classes="srowtext">
                                                <TextBlock Classes="srowtitle" Text="{x:Static resx:ResUI.TbSettingsLogLevel}" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <ComboBox x:Name="cmbloglevel" Width="180" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        x:Name="txtNoResults"
                        Margin="4,40,0,0"
                        Classes="muted"
                        IsVisible="False"
                        Text="{x:Static loc:L.NothingFound}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
