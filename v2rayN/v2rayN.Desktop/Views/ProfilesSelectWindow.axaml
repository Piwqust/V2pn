<Window
    x:Class="v2rayN.Desktop.Views.ProfilesSelectWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:v2rayN.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:loc="using:v2rayN.Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:side="using:v2rayN.Desktop.ViewModels"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static loc:L.PickTitleOne}"
    Width="640"
    Height="700"
    MinWidth="480"
    MinHeight="420"
    x:DataType="vms:ProfilesSelectViewModel"
    Design.DataContext="{x:Static dd:DesignData.ProfilesSelect}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <!--  The servers as the main window's list shows them: flag, a readable name, what it is, its ping.
          Several are ticked (a group, a chain) or one is chosen (a rule, a pinned program).  -->
    <DockPanel>
        <Border Classes="dialogfooter" DockPanel.Dock="Bottom">
            <DockPanel>
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Button
                        x:Name="btnSelectAll"
                        MinWidth="0"
                        Classes="plain ghost"
                        Content="{x:Static loc:L.PickSelectAll}"
                        Theme="{StaticResource V2Button}" />
                    <TextBlock
                        x:Name="txtCount"
                        VerticalAlignment="Center"
                        Classes="muted" />
                </StackPanel>
                <StackPanel Classes="footer">
                    <Button
                        x:Name="btnSave"
                        MinWidth="100"
                        Content="{x:Static loc:L.PickChoose}"
                        IsDefault="True" />
                    <Button
                        x:Name="btnCancel"
                        MinWidth="100"
                        Content="{x:Static resx:ResUI.TbCancel}"
                        IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Classes="spagehead" DockPanel.Dock="Top">
            <TextBlock x:Name="tbTitle" Classes="spagetitle" Text="{x:Static loc:L.PickTitleOne}" />
            <TextBlock x:Name="tbHint" Classes="spagehint" Text="{x:Static loc:L.PickHintOne}" />
            <TextBox
                x:Name="txtServerFilter"
                Margin="0,12,0,4"
                AutomationProperties.Name="{x:Static loc:L.PickSearch}"
                Classes="search"
                PlaceholderText="{x:Static loc:L.PickSearch}">
                <TextBox.InnerLeftContent>
                    <PathIcon
                        Width="14"
                        Height="14"
                        Margin="10,0,2,0"
                        Foreground="{DynamicResource V2Muted}"
                        Data="{StaticResource SemiIconSearch}" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <!--  Subscriptions as pills; "All" first. Hidden when there is nothing to choose between.  -->
            <ListBox
                x:Name="lstGroup"
                Margin="0,6,0,0"
                Classes="chips"
                DisplayMemberBinding="{Binding Remarks}"
                ItemsSource="{Binding SubItems}" />
        </StackPanel>

        <Border
            Margin="28,4,28,16"
            Classes="sgroupcard"
            ClipToBounds="True">
            <Panel>
                <ListBox
                    x:Name="lstProfiles"
                    Padding="6"
                    Background="Transparent"
                    BorderThickness="0"
                    Classes="single"
                    ItemContainerTheme="{StaticResource V2PickItem}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="side:SideServerRow">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                <Border Classes="pickcheck">
                                    <Path Data="M 20 6 L 9 17 L 4 12" />
                                </Border>
                                <Panel
                                    Grid.Column="1"
                                    Width="26"
                                    Height="20"
                                    VerticalAlignment="Center">
                                    <Border
                                        Width="24"
                                        Height="18"
                                        BoxShadow="{DynamicResource V2FlagRing}"
                                        ClipToBounds="True"
                                        CornerRadius="4"
                                        IsVisible="{Binding ShowFlag}">
                                        <Image Source="{Binding Flag}" Stretch="UniformToFill" />
                                    </Border>
                                    <PathIcon
                                        Width="16"
                                        Height="16"
                                        Foreground="{DynamicResource V2Faint}"
                                        Data="{StaticResource SemiIconGlobeStroke}"
                                        IsVisible="{Binding ShowGlobe}" />
                                    <Ellipse Classes="badge" IsVisible="{Binding IsActive}" />
                                </Panel>
                                <StackPanel
                                    Grid.Column="2"
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                                    <TextBlock
                                        Classes="title"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip.Tip="{Binding Model.Remarks}" />
                                    <TextBlock
                                        Classes="muted small"
                                        Text="{Binding Subtitle}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Classes="pill"
                                    Classes.bad="{Binding Model.Delay, Converter={x:Static conv:V2pnConverters.IsPingBad}}"
                                    Classes.good="{Binding Model.Delay, Converter={x:Static conv:V2pnConverters.IsPingGood}}"
                                    Classes.mid="{Binding Model.Delay, Converter={x:Static conv:V2pnConverters.IsPingMid}}"
                                    IsVisible="{Binding Model.Delay, Converter={x:Static conv:V2pnConverters.NotZero}}">
                                    <TextBlock Text="{Binding Model.Delay, Converter={x:Static conv:V2pnConverters.PingText}}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock
                    x:Name="txtEmpty"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Classes="muted"
                    IsVisible="False"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Panel>
        </Border>
    </DockPanel>
</Window>
