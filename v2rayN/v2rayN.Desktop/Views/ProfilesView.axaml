<UserControl
    x:Class="v2rayN.Desktop.Views.ProfilesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:v2rayN.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:dto="clr-namespace:ServiceLib.Models.Dto;assembly=ServiceLib"
    xmlns:ent="clr-namespace:ServiceLib.Models.Entities;assembly=ServiceLib"
    xmlns:loc="using:v2rayN.Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:Name="Root"
    d:DesignHeight="760"
    d:DesignWidth="900"
    x:DataType="vms:ProfilesViewModel"
    Design.DataContext="{x:Static dd:DesignData.Profiles}"
    mc:Ignorable="d">

    <DockPanel Margin="32,26,28,0">

        <!--  ── Title block ──  -->
        <Grid ColumnDefinitions="*,Auto" DockPanel.Dock="Top">
            <StackPanel VerticalAlignment="Bottom" Spacing="8">
                <TextBlock
                    x:Name="txtTitle"
                    Classes="display h1"
                    TextTrimming="CharacterEllipsis">
                    <Run x:Name="runTitle" />
                    <Run
                        x:Name="runTitleCount"
                        Foreground="{DynamicResource V2Faint}" />
                </TextBlock>
                <TextBlock
                    x:Name="txtSubtitle"
                    Classes="muted"
                    FontSize="13"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Margin="16,0,0,4"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="btnUpdateSub"
                    Theme="{StaticResource V2Button}"
                    ToolTip.Tip="{x:Static loc:L.UpdateSubscription}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Classes="i14" Data="{StaticResource SemiIconRefresh}" />
                        <TextBlock Text="{x:Static loc:L.Update}" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="menuUpdateSubViaProxy" Header="{x:Static loc:L.MenuSubUpdateViaVpn}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Button x:Name="btnAdd" Theme="{StaticResource V2Button}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Classes="i14" Data="{StaticResource SemiIconPlus}" />
                        <TextBlock Text="{x:Static loc:L.AddServer}" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem
                                x:Name="menuAddServerViaClipboard"
                                Header="{x:Static loc:L.PasteFromClipboard}"
                                InputGesture="Ctrl+V" />
                            <MenuItem
                                x:Name="menuAddServerViaScan"
                                Header="{x:Static loc:L.MenuScanScreen}"
                                InputGesture="Ctrl+S" />
                            <MenuItem x:Name="menuAddServerViaImage" Header="{x:Static loc:L.MenuScanImage}" />
                            <Separator />
                            <MenuItem x:Name="menuAddSubscription" Header="{x:Static loc:L.AddSubscription}" />
                            <Separator />
                            <MenuItem Header="{x:Static loc:L.MenuServerByProtocol}">
                                <MenuItem x:Name="menuAddVlessServer" Header="VLESS" />
                                <MenuItem x:Name="menuAddVmessServer" Header="VMess" />
                                <MenuItem x:Name="menuAddShadowsocksServer" Header="Shadowsocks" />
                                <MenuItem x:Name="menuAddTrojanServer" Header="Trojan" />
                                <MenuItem x:Name="menuAddHysteria2Server" Header="Hysteria2" />
                                <MenuItem x:Name="menuAddTuicServer" Header="TUIC" />
                                <MenuItem x:Name="menuAddWireguardServer" Header="WireGuard" />
                                <MenuItem x:Name="menuAddAnytlsServer" Header="AnyTLS" />
                                <MenuItem x:Name="menuAddNaiveServer" Header="NaïveProxy" />
                                <MenuItem x:Name="menuAddMasqueServer" Header="MASQUE" />
                                <MenuItem x:Name="menuAddSocksServer" Header="SOCKS" />
                                <MenuItem x:Name="menuAddHttpServer" Header="HTTP" />
                            </MenuItem>
                            <MenuItem x:Name="menuAddCustomServer" Header="{x:Static loc:L.MenuCustomConfig}" />
                            <MenuItem x:Name="menuAddPolicyGroupServer" Header="{x:Static loc:L.MenuPolicyGroup}" />
                            <MenuItem x:Name="menuAddProxyChainServer" Header="{x:Static loc:L.MenuProxyChain}" />
                            <MenuItem x:Name="menuAddCustomOutboundServer" Header="{x:Static loc:L.MenuCustomOutbound}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!--  Primary action: ping everything in view; the chevron holds the other tests.  -->
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="btnFastRealPing"
                        Classes="primary"
                        CornerRadius="9,0,0,9"
                        Theme="{StaticResource V2Button}"
                        ToolTip.Tip="{x:Static loc:L.TbPingAllTip}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Classes="i14" Data="{StaticResource SemiIconBolt}" />
                            <TextBlock Text="{x:Static loc:L.TestPing}" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Background="{DynamicResource V2Faint}" Opacity="0.5" />
                    <Button
                        Padding="8,0"
                        Classes="primary"
                        CornerRadius="0,9,9,0"
                        Theme="{StaticResource V2Button}"
                        ToolTip.Tip="{x:Static loc:L.MoreTests}">
                        <PathIcon Classes="i14" Data="{StaticResource SemiIconChevronDown}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem x:Name="menuMixedTestServer" Header="{x:Static loc:L.TbPingAndSpeed}" />
                                <Separator />
                                <MenuItem
                                    x:Name="menuTcpingServer2"
                                    Header="{x:Static loc:L.MenuTcping}"
                                    InputGesture="Ctrl+O" />
                                <MenuItem
                                    x:Name="menuRealPingServer2"
                                    Header="{x:Static loc:L.TestPing}"
                                    InputGesture="Ctrl+R" />
                                <MenuItem
                                    x:Name="menuSpeedServer2"
                                    Header="{x:Static loc:L.TestSpeed}"
                                    InputGesture="Ctrl+T" />
                                <MenuItem x:Name="menuUdpTestServer2" Header="{x:Static loc:L.TbUdpPing}" />
                                <Separator />
                                <MenuItem x:Name="menuSortServerResult2" Header="{x:Static loc:L.SortByPing}" />
                                <MenuItem x:Name="menuRemoveInvalidServerResult2" Header="{x:Static loc:L.RemoveDead}" />
                                <Separator />
                                <MenuItem
                                    x:Name="menuStopTests"
                                    Header="{x:Static loc:L.StopTests}"
                                    InputGesture="Escape" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--  ── Search ──  -->
        <Grid
            Margin="0,22,0,16"
            ColumnDefinitions="Auto,*"
            DockPanel.Dock="Top">
            <TextBox
                x:Name="txtServerFilter"
                Width="300"
                Classes="search"
                PlaceholderText="{x:Static loc:L.Search}">
                <TextBox.InnerLeftContent>
                    <PathIcon
                        Width="14"
                        Height="14"
                        Margin="10,0,2,0"
                        Foreground="{DynamicResource V2Muted}"
                        Data="{StaticResource SemiIconSearch}" />
                </TextBox.InnerLeftContent>
            </TextBox>
        </Grid>

        <!--  ── Favorites strip (hidden inside the favorites list itself) ──  -->
        <StackPanel
            x:Name="panelFavorites"
            Margin="0,0,0,18"
            DockPanel.Dock="Top"
            Spacing="10">
            <TextBlock Classes="title" FontSize="14">
                <Run Text="{x:Static loc:L.Favorites}" />
                <Run Foreground="{DynamicResource V2Muted}" Text="{Binding FavoritesCount}" />
            </TextBlock>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="lstFavorites" ItemsSource="{Binding FavoriteItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dto:ProfileItemModel">
                            <Border
                                Width="196"
                                Height="104"
                                Margin="0,2,0,8"
                                Classes="card">
                            <Button
                                Padding="14,12"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding #Root.((vms:ProfilesViewModel)DataContext).ActivateServerCmd}"
                                CommandParameter="{Binding}"
                                CornerRadius="14"
                                Theme="{StaticResource V2Button}"
                                ToolTip.Tip="{x:Static loc:L.Connect}">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border
                                            Width="28"
                                            Height="28"
                                            Classes="mono"
                                            Classes.live="{Binding IsActive}"
                                            CornerRadius="8">
                                            <TextBlock FontSize="9.5" Text="{Binding ConfigType, Converter={x:Static conv:V2pnConverters.ProtocolMonogram}}" />
                                        </Border>
                                        <Border
                                            Grid.Column="2"
                                            Classes="tag live"
                                            IsVisible="{Binding IsActive}">
                                            <TextBlock Text="{x:Static loc:L.Active}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,10,0,0"
                                        VerticalAlignment="Top"
                                        Classes="title"
                                        FontWeight="Medium"
                                        Text="{Binding Remarks}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Classes="muted small"
                                            Text="{Binding SubRemarks}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Ellipse
                                                Classes="dot"
                                                Classes.bad="{Binding Delay, Converter={x:Static conv:V2pnConverters.IsPingBad}}"
                                                Classes.good="{Binding Delay, Converter={x:Static conv:V2pnConverters.IsPingGood}}"
                                                Classes.mid="{Binding Delay, Converter={x:Static conv:V2pnConverters.IsPingMid}}" />
                                            <TextBlock
                                                Classes="muted small num"
                                                Text="{Binding Delay, Converter={x:Static conv:V2pnConverters.PingText}}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!--  ── Server list ──  -->
        <Border
            Margin="0,0,0,24"
            Classes="card"
            ClipToBounds="True">
            <DockPanel>
                <Grid
                    Height="42"
                    Margin="16,0,16,0"
                    ColumnDefinitions="44,*,128,150,92,34,30"
                    DockPanel.Dock="Top">
                    <Button
                        x:Name="btnSortName"
                        Grid.Column="1"
                        Padding="6,0"
                        HorizontalAlignment="Left"
                        Classes="ghost small"
                        Tag="Remarks"
                        Theme="{StaticResource V2Button}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="muted" Text="{x:Static loc:L.ColName}" />
                            <PathIcon
                                Width="10"
                                Height="10"
                                Foreground="{DynamicResource V2Faint}"
                                Data="{StaticResource SemiIconChevronUpDown}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="btnSortType"
                        Grid.Column="2"
                        Padding="6,0"
                        HorizontalAlignment="Left"
                        Classes="ghost small"
                        Tag="ConfigType"
                        Theme="{StaticResource V2Button}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="muted" Text="{x:Static loc:L.ColProtocol}" />
                            <PathIcon
                                Width="10"
                                Height="10"
                                Foreground="{DynamicResource V2Faint}"
                                Data="{StaticResource SemiIconChevronUpDown}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="btnSortSub"
                        Grid.Column="3"
                        Padding="6,0"
                        HorizontalAlignment="Left"
                        Classes="ghost small"
                        Tag="SubRemarks"
                        Theme="{StaticResource V2Button}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="muted" Text="{x:Static loc:L.ColSubscription}" />
                            <PathIcon
                                Width="10"
                                Height="10"
                                Foreground="{DynamicResource V2Faint}"
                                Data="{StaticResource SemiIconChevronUpDown}" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="btnSortPing"
                        Grid.Column="4"
                        Padding="6,0"
                        HorizontalAlignment="Right"
                        Classes="ghost small"
                        Tag="DelayVal"
                        Theme="{StaticResource V2Button}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="muted" Text="{x:Static loc:L.ColPing}" />
                            <PathIcon
                                Width="10"
                                Height="10"
                                Foreground="{DynamicResource V2Faint}"
                                Data="{StaticResource SemiIconChevronUpDown}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Border Classes="hairline" DockPanel.Dock="Top" />

                <Panel>
                    <ListBox
                        x:Name="lstProfiles"
                        Padding="0,6"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerTheme="{StaticResource V2RowItem}"
                        ItemsSource="{Binding ProfileItems}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionMode="Multiple">
                        <ListBox.KeyBindings>
                            <KeyBinding Command="{Binding Export2ShareUrlCmd}" Gesture="Ctrl+C" />
                            <KeyBinding Command="{Binding SetDefaultServerCmd}" Gesture="Enter" />
                        </ListBox.KeyBindings>
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="ctxProfiles">
                                <MenuItem
                                    x:Name="menuSetDefaultServer"
                                    Header="{x:Static loc:L.Connect}"
                                    InputGesture="Enter" />
                                <MenuItem x:Name="menuToggleFavorite" Header="{x:Static loc:L.ToggleFavorite}" />
                                <MenuItem
                                    x:Name="menuEditServer"
                                    Header="{x:Static loc:L.Edit}"
                                    InputGesture="Ctrl+D" />
                                <MenuItem x:Name="menuCopyServer" Header="{x:Static loc:L.RtDuplicate}" />
                                <MenuItem
                                    x:Name="menuRemoveServer"
                                    Header="{x:Static loc:L.MenuDelete}"
                                    InputGesture="Delete" />
                                <MenuItem x:Name="menuRemoveDuplicateServer" Header="{x:Static loc:L.TbRemoveDuplicates}" />
                                <MenuItem x:Name="menuRemoveInvalidServerResult" Header="{x:Static loc:L.RemoveDead}" />
                                <Separator />
                                <MenuItem
                                    x:Name="menuTcpingServer"
                                    Header="{x:Static loc:L.MenuTcping}"
                                    InputGesture="Ctrl+O" />
                                <MenuItem
                                    x:Name="menuRealPingServer"
                                    Header="{x:Static loc:L.TestPing}"
                                    InputGesture="Ctrl+R" />
                                <MenuItem
                                    x:Name="menuSpeedServer"
                                    Header="{x:Static loc:L.TestSpeed}"
                                    InputGesture="Ctrl+T" />
                                <MenuItem x:Name="menuUdpTestServer" Header="{x:Static loc:L.TbUdpPing}" />
                                <MenuItem x:Name="menuSortServerResult" Header="{x:Static loc:L.SortByPing}" />
                                <Separator />
                                <MenuItem
                                    x:Name="menuMoveToGroup"
                                    Header="{x:Static loc:L.TbMoveToSub}"
                                    ItemsSource="{Binding SubItems}">
                                    <MenuItem.ItemTemplate>
                                        <DataTemplate x:DataType="ent:SubItem">
                                            <TextBlock Text="{Binding Remarks}" />
                                        </DataTemplate>
                                    </MenuItem.ItemTemplate>
                                </MenuItem>
                                <MenuItem Header="{x:Static loc:L.TbOrder}">
                                    <MenuItem
                                        x:Name="menuMoveTop"
                                        Header="{x:Static loc:L.RtMoveTop}"
                                        InputGesture="T" />
                                    <MenuItem
                                        x:Name="menuMoveUp"
                                        Header="{x:Static loc:L.RtMoveUp}"
                                        InputGesture="U" />
                                    <MenuItem
                                        x:Name="menuMoveDown"
                                        Header="{x:Static loc:L.RtMoveDown}"
                                        InputGesture="D" />
                                    <MenuItem
                                        x:Name="menuMoveBottom"
                                        Header="{x:Static loc:L.RtMoveBottom}"
                                        InputGesture="B" />
                                </MenuItem>
                                <MenuItem
                                    x:Name="menuSelectAll"
                                    Header="{x:Static loc:L.PickSelectAll}"
                                    InputGesture="Ctrl+A" />
                                <Separator />
                                <MenuItem
                                    x:Name="menuShareServer"
                                    Header="{x:Static loc:L.Share}"
                                    InputGesture="Ctrl+F" />
                                <MenuItem Header="{x:Static loc:L.TbExport}">
                                    <MenuItem x:Name="menuExport2ClientConfig" Header="{x:Static loc:L.TbExportFile}" />
                                    <MenuItem x:Name="menuExport2ClientConfigClipboard" Header="{x:Static loc:L.TbExportCopy}" />
                                    <Separator />
                                    <MenuItem
                                        x:Name="menuExport2ShareUrl"
                                        Header="{x:Static loc:L.CopyLink}"
                                        InputGesture="Ctrl+C" />
                                    <MenuItem x:Name="menuExport2ShareUrlBase64" Header="{x:Static loc:L.TbCopyBase64}" />
                                    <MenuItem x:Name="menuExport2InnerUri" Header="{x:Static loc:L.TbCopyFullLink}" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{x:Static loc:L.TbMakeGroup}">
                                    <MenuItem x:Name="menuGenGroupAllServer" Header="{x:Static loc:L.TbGroupFromList}" />
                                    <MenuItem x:Name="menuGenGroupRegionServer" Header="{x:Static loc:L.TbGroupByCountry}" />
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:ProfileItemModel">
                                <Grid Height="52" ColumnDefinitions="44,*,128,150,92,34,30">
                                    <Border
                                        HorizontalAlignment="Left"
                                        Classes="mono"
                                        Classes.live="{Binding IsActive}">
                                        <TextBlock Text="{Binding ConfigType, Converter={x:Static conv:V2pnConverters.ProtocolMonogram}}" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="6,0,12,0"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                MaxWidth="420"
                                                VerticalAlignment="Center"
                                                Classes="title"
                                                Text="{Binding Remarks}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Border Classes="tag live" IsVisible="{Binding IsActive}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <Ellipse
                                                        Width="5"
                                                        Height="5"
                                                        Classes="dot live" />
                                                    <TextBlock Text="{x:Static loc:L.Active}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Classes="muted small" Text="{Binding Converter={x:Static conv:V2pnConverters.ServerAddress}}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Spacing="3">
                                        <TextBlock
                                            Classes="small"
                                            Foreground="{DynamicResource V2InkSoft}"
                                            Text="{Binding ConfigType, Converter={x:Static conv:V2pnConverters.ProtocolName}}" />
                                        <TextBlock Classes="muted small" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Network}" /><Run Text=" " /><Run Text="{Binding StreamSecurity}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="3"
                                        Margin="6,0,8,0"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding SubRemarks, Converter={x:Static conv:V2pnConverters.NotEmpty}}"
                                        Orientation="Horizontal"
                                        Spacing="7">
                                        <Canvas
                                            Width="14"
                                            Height="12"
                                            VerticalAlignment="Center">
                                            <Canvas.RenderTransform>
                                                <ScaleTransform ScaleX="0.86" ScaleY="0.86" />
                                            </Canvas.RenderTransform>
                                            <Path
                                                Data="{StaticResource V2FolderBack}"
                                                Fill="{DynamicResource V2Folder}"
                                                Opacity="0.55" />
                                            <Path Data="{StaticResource V2FolderFront}" Fill="{DynamicResource V2Folder}" />
                                        </Canvas>
                                        <TextBlock
                                            MaxWidth="118"
                                            VerticalAlignment="Center"
                                            Classes="muted small"
                                            Text="{Binding SubRemarks}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="4"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding #Root.((vms:ProfilesViewModel)DataContext).PingServerCmd}"
                                        CommandParameter="{Binding}"
                                        Theme="{StaticResource V2Button}"
                                        ToolTip.Tip="{x:Static loc:L.TestPing}">
                                        <Border
                                            Classes="pill"
                                            Classes.bad="{Binding Delay, Converter={x:Static conv:V2pnConverters.IsPingBad}}"
                                            Classes.good="{Binding Delay, Converter={x:Static conv:V2pnConverters.IsPingGood}}"
                                            Classes.mid="{Binding Delay, Converter={x:Static conv:V2pnConverters.IsPingMid}}">
                                            <TextBlock Text="{Binding Delay, Converter={x:Static conv:V2pnConverters.PingText}}" />
                                        </Border>
                                    </Button>

                                    <Button
                                        Grid.Column="5"
                                        HorizontalAlignment="Right"
                                        Classes="ghost small icon star"
                                        Classes.on="{Binding IsFavorite}"
                                        Command="{Binding #Root.((vms:ProfilesViewModel)DataContext).ToggleFavoriteCmd}"
                                        CommandParameter="{Binding}"
                                        Theme="{StaticResource V2Button}"
                                        ToolTip.Tip="{x:Static loc:L.ToggleFavorite}">
                                        <Panel>
                                            <PathIcon Data="{StaticResource SemiIconStarStroked}" IsVisible="{Binding !IsFavorite}" />
                                            <PathIcon Data="{StaticResource SemiIconStar}" IsVisible="{Binding IsFavorite}" />
                                        </Panel>
                                    </Button>

                                    <Button
                                        Grid.Column="6"
                                        HorizontalAlignment="Right"
                                        Classes="ghost small icon"
                                        Click="RowMore_Click"
                                        Theme="{StaticResource V2Button}"
                                        ToolTip.Tip="{x:Static loc:L.More}">
                                        <PathIcon
                                            Classes="i14"
                                            Data="{StaticResource SemiIconMore}"
                                            Foreground="{DynamicResource V2Muted}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--  Empty state  -->
                    <StackPanel
                        x:Name="panelEmpty"
                        MaxWidth="420"
                        Margin="24,64"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        IsVisible="False"
                        Spacing="10">
                        <TextBlock
                            x:Name="txtEmptyTitle"
                            HorizontalAlignment="Center"
                            Classes="display h2"
                            Text="{x:Static loc:L.EmptyTitle}" />
                        <TextBlock
                            x:Name="txtEmptyHint"
                            HorizontalAlignment="Center"
                            Classes="muted"
                            Text="{x:Static loc:L.EmptyHint}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <StackPanel
                            x:Name="panelEmptyActions"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="btnEmptyAddSub"
                                Classes="primary"
                                Content="{x:Static loc:L.AddSubscription}"
                                Theme="{StaticResource V2Button}" />
                            <Button
                                x:Name="btnEmptyPaste"
                                Content="{x:Static loc:L.PasteFromClipboard}"
                                Theme="{StaticResource V2Button}" />
                        </StackPanel>
                    </StackPanel>
                </Panel>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
