<Window
    x:Class="v2rayN.Desktop.Views.RoutingSettingWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:v2rayN.Desktop"
    xmlns:common="using:v2rayN.Desktop.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    xmlns:dto="clr-namespace:ServiceLib.Models.Dto;assembly=ServiceLib"
    Title="{x:Static loc:L.RtListTitle}"
    Width="860"
    Height="720"
    x:DataType="vms:RoutingSettingViewModel"
    Design.DataContext="{x:Static dd:DesignData.RoutingSetting}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <DockPanel>
        <StackPanel Classes="spagehead" DockPanel.Dock="Top">
            <TextBlock Classes="spagetitle" Text="{x:Static loc:L.RtListTitle}" />
            <TextBlock Classes="spagehint" Text="{x:Static loc:L.RtListHint}" />
        </StackPanel>

        <!--  Programs pinned to one server or group, checked before any set below. The rows are built in
              code (RenderPinsAsync) as direct children of the card, so the hairlines between them work.  -->
        <StackPanel Margin="28,0,28,0" DockPanel.Dock="Top">
            <StackPanel Classes="sgroup">
                <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.PinGroup}" />
                <Border Classes="sgroupcard">
                    <StackPanel x:Name="panelPins">
                        <Border x:Name="rowPinActions" Classes="srow">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="btnPinClaude"
                                    Content="{x:Static loc:L.PinAddClaude}"
                                    ToolTip.Tip="{x:Static loc:L.PinAddClaudeTip}" />
                                <Button x:Name="btnPinAdd" Content="{x:Static loc:L.PinAdd}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock Classes="sgroupnote" Text="{x:Static loc:L.PinNote}" />
            </StackPanel>
        </StackPanel>

        <!--  Expert settings for every set, behind "Show more fields" under the list.  -->
        <StackPanel Margin="28,0,28,16" DockPanel.Dock="Bottom" Spacing="6">
            <StackPanel Classes="sgroup">
                <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.RtGrpDomains}" />
                <Border Classes="sgroupcard">
                    <StackPanel>
                        <Border x:Name="rowDomainStrategy" Classes="srow adv">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Classes="srowtext">
                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.RtDomainStrategy}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="srowhint" VerticalAlignment="Center" Text="{x:Static loc:L.RtDomainStrategyHint}" />
                                        <HyperlinkButton
                                            Margin="0,3,0,0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Classes="WithIcon"
                                            Click="linkdomainStrategy_Click">
                                            <TextBlock FontSize="12" Text="{x:Static loc:L.RtLearnMore}" />
                                        </HyperlinkButton>
                                    </StackPanel>
                                </StackPanel>
                                <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                    <ComboBox x:Name="cmbdomainStrategy" Width="200" />
                                </Panel>
                            </Grid>
                        </Border>
                        <Border Classes="srow adv">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Classes="srowtext">
                                    <TextBlock Classes="srowtitle" Text="{x:Static loc:L.RtDomainStrategySb}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="srowhint" VerticalAlignment="Center" Text="{x:Static loc:L.RtDomainStrategySbHint}" />
                                        <HyperlinkButton
                                            Margin="0,3,0,0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Classes="WithIcon"
                                            Click="linkdomainStrategy4Singbox_Click">
                                            <TextBlock FontSize="12" Text="{x:Static loc:L.RtLearnMore}" />
                                        </HyperlinkButton>
                                    </StackPanel>
                                </StackPanel>
                                <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                    <ComboBox x:Name="cmbdomainStrategy4Singbox" Width="200" />
                                </Panel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Button x:Name="btnMoreFields" Classes="morefields" Theme="{StaticResource V2Button}" />
        </StackPanel>

        <DockPanel Margin="28,12,28,8">
            <!--  Actions above the list.  -->
            <Menu
                Margin="0,0,0,10"
                HorizontalAlignment="Left"
                DockPanel.Dock="Top">
                <MenuItem x:Name="menuRoutingAdvancedAdd2" Header="{x:Static loc:L.RtNewSet}" />
                <MenuItem x:Name="menuRoutingEdit2" Header="{x:Static loc:L.RtEdit}" />
                <MenuItem x:Name="menuRoutingUse2" Header="{x:Static loc:L.RtUseSet}" />
                <MenuItem x:Name="menuRoutingAdvancedImportRules2" Header="{x:Static loc:L.RtAddBuiltin}" />
            </Menu>
            <TabControl x:Name="tabAdvanced" Classes="single">
                <TabItem HorizontalAlignment="Left" Header="{x:Static loc:L.RtSetsTab}">
                    <DataGrid
                        x:Name="lstRoutings"
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderThickness="1"
                        CanUserResizeColumns="True"
                        GridLinesVisibility="All"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding RoutingItems}">
                        <DataGrid.KeyBindings>
                            <KeyBinding Command="{Binding RoutingAdvancedSetDefaultCmd}" Gesture="Enter" />
                        </DataGrid.KeyBindings>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="menuRoutingEdit" Header="{x:Static loc:L.RtEdit}" />
                                <MenuItem x:Name="menuRoutingAdvancedAdd" Header="{x:Static loc:L.RtNewSet}" />
                                <MenuItem
                                    x:Name="menuRoutingAdvancedRemove"
                                    Header="{x:Static loc:L.RtDelete}"
                                    InputGesture="Back" />
                                <MenuItem
                                    x:Name="menuRoutingAdvancedSelectAll"
                                    Header="{x:Static loc:L.RtSelectAll}"
                                    InputGesture="Ctrl+A" />
                                <MenuItem
                                    x:Name="menuRoutingAdvancedSetDefault"
                                    Header="{x:Static loc:L.RtUseSet}"
                                    InputGesture="Enter" />
                                <Separator />
                                <MenuItem x:Name="menuRoutingAdvancedImportRules" Header="{x:Static loc:L.RtAddBuiltin}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <!--  Columns 2 and 3 (order, link) are expert details: shown together with the extra fields.  -->
                        <DataGrid.Columns>
                            <!--  The set in use is named in its row; a bare check box in a read-only grid
                                  looked like a switch that did nothing.  -->
                            <DataGridTemplateColumn Width="*" Header="{x:Static loc:L.RtColName}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="dto:RoutingItemModel">
                                        <StackPanel
                                            Margin="12,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Remarks, Converter={x:Static common:RoutingPresets.NameConverter}}" />
                                            <Border
                                                Classes="pill good"
                                                MinWidth="0"
                                                IsVisible="{Binding IsActive}">
                                                <TextBlock Text="{x:Static loc:L.RtInUse}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding RuleNum}"
                                Header="{x:Static loc:L.RtColRules}" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding Sort}"
                                Header="{x:Static loc:L.RtColOrder}" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Url}"
                                Header="{x:Static loc:L.RtColLink}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>
</Window>
