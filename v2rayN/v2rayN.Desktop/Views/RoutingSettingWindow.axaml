<Window
    x:Class="v2rayN.Desktop.Views.RoutingSettingWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:v2rayN.Desktop"
    xmlns:common="using:v2rayN.Desktop.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    xmlns:dto="clr-namespace:ServiceLib.Models.Dto;assembly=ServiceLib"
    Title="{x:Static loc:L.RtListTitle}"
    Width="1060"
    Height="740"
    MinWidth="820"
    MinHeight="520"
    x:DataType="vms:RoutingSettingViewModel"
    Design.DataContext="{x:Static dd:DesignData.RoutingSetting}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <!--
        Rule sets as a list beside the chosen set: the sets and the programs on the left, the chosen one
        on the right with its rules, and a rule opens below them. v2rayN stacked three windows for this
        (sets, one set, one rule). Every change is saved at once; closing the window reloads the core.
    -->
    <Window.Styles>
        <Style Selector="TextBlock.navsec">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource V2Faint}" />
            <Setter Property="Margin" Value="10,14,10,6" />
        </Style>
        <Style Selector="TextBlock.navsec.first">
            <Setter Property="Margin" Value="10,2,10,6" />
        </Style>
        <Style Selector="TextBlock.count">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource V2Faint}" />
            <Setter Property="FontFeatures" Value="+tnum" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Ellipse.setdot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{DynamicResource V2BorderStrong}" />
            <Setter Property="StrokeThickness" Value="1.5" />
        </Style>
        <Style Selector="Ellipse.setdot.on">
            <Setter Property="Fill" Value="{DynamicResource V2Safe}" />
            <Setter Property="Stroke" Value="{DynamicResource V2Safe}" />
        </Style>
        <Style Selector="Ellipse.setdot.off">
            <Setter Property="Fill" Value="{DynamicResource V2BorderStrong}" />
        </Style>
        <!--  The set's name is its title and is edited right there.  -->
        <Style Selector="TextBox.titlebox">
            <Setter Property="FontFamily" Value="{DynamicResource V2DisplayFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="-4,0,0,0" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="TextBox.titlebox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource V2Hover}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.titlebox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource V2Hover}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="avares://V2pn/Assets/Fonts#Geist Mono" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource V2Faint}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="Border.rule">
            <Setter Property="Padding" Value="12,8,8,8" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.rule:pointerover">
            <Setter Property="Background" Value="{DynamicResource V2Hover}" />
        </Style>
        <Style Selector="Border.rule.editing">
            <Setter Property="Background" Value="{DynamicResource V2Selected}" />
        </Style>
        <Style Selector="Border.rule.off TextBlock">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.action">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource V2PingNoneSoft}" />
        </Style>
        <Style Selector="Border.action TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.action.vpn">
            <Setter Property="Background" Value="{DynamicResource V2SafeSoft}" />
        </Style>
        <Style Selector="Border.action.vpn TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource V2Safe}" />
        </Style>
        <Style Selector="Border.action.block">
            <Setter Property="Background" Value="{DynamicResource V2UnsafeSoft}" />
        </Style>
        <Style Selector="Border.action.block TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource V2Unsafe}" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="280,*">
        <!--  The list: rule sets, then the programs that go through their own server.  -->
        <Border Classes="settingsnav">
            <DockPanel Margin="12,16,12,12">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Button
                            x:Name="btnNewSet"
                            HorizontalAlignment="Stretch"
                            Theme="{StaticResource V2Button}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Classes="i12" Data="{StaticResource SemiIconPlus}" />
                                <TextBlock Text="{x:Static loc:L.RtNewSet}" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="btnListMenu"
                            Grid.Column="1"
                            AutomationProperties.Name="{x:Static loc:L.RtMoreActions}"
                            Classes="icon"
                            Theme="{StaticResource V2Button}"
                            ToolTip.Tip="{x:Static loc:L.RtMoreActions}">
                            <PathIcon Classes="i14" Data="{StaticResource SemiIconMore}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedRight">
                                    <MenuItem x:Name="menuAddBuiltin" Header="{x:Static loc:L.RtAddBuiltin}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <ListBox x:Name="lstMatch" Theme="{StaticResource V2NavList}">
                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Classes="nav" Data="{StaticResource SemiIconSettingStroked}" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Static loc:L.RtMatchNav}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Classes="navsec first" Text="{x:Static loc:L.RtSetsTab}" />
                        <ListBox
                            x:Name="lstRoutings"
                            AutomationProperties.Name="{x:Static loc:L.RtSetsTab}"
                            Theme="{StaticResource V2NavList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="dto:RoutingItemModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Remarks, Converter={x:Static common:RoutingPresets.NameConverter}}">
                                        <Ellipse Classes="setdot" Classes.on="{Binding IsActive}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="10,9"
                                            VerticalAlignment="Center"
                                            Text="{Binding Remarks, Converter={x:Static common:RoutingPresets.NameConverter}}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Classes="count"
                                            Text="{Binding RuleNum}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Classes="navsec" Text="{x:Static loc:L.PinGroup}" />
                        <ListBox
                            x:Name="lstPins"
                            AutomationProperties.Name="{x:Static loc:L.PinGroup}"
                            Theme="{StaticResource V2NavList}" />
                        <TextBlock
                            x:Name="txtNoPins"
                            Margin="10,0,10,4"
                            Classes="srowhint"
                            Text="{x:Static loc:L.PinEmpty}"
                            TextWrapping="Wrap" />
                        <!--  A WrapPanel: side by side the two do not fit the panel in every language, and the second was cut off.  -->
                        <WrapPanel Margin="4,4,0,0" Orientation="Horizontal">
                            <Button
                                x:Name="btnPinClaude"
                                Margin="0,0,4,6"
                                Classes="ghost small"
                                Content="{x:Static loc:L.PinAddClaude}"
                                Theme="{StaticResource V2Button}"
                                ToolTip.Tip="{x:Static loc:L.PinAddClaudeTip}" />
                            <Button
                                x:Name="btnPinAdd"
                                Margin="0,0,4,6"
                                Classes="ghost small"
                                Theme="{StaticResource V2Button}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Classes="i12" Data="{StaticResource SemiIconPlus}" />
                                    <TextBlock Text="{x:Static loc:L.PinAdd}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--  The chosen entry.  -->
        <ScrollViewer
            x:Name="paneScroll"
            Grid.Column="1"
            HorizontalScrollBarVisibility="Disabled">
            <Panel>
                <!--  A rule set.  -->
                <StackPanel x:Name="paneSet" Margin="28,20,28,28">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox
                            x:Name="txtSetName"
                            AutomationProperties.Name="{x:Static loc:L.RtSetName}"
                            Classes="titlebox"
                            MaxLength="120"
                            PlaceholderText="{x:Static loc:L.RtSetNamePlaceholder}" />
                        <Border
                            x:Name="pillInUse"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Classes="pill good">
                            <TextBlock Text="{x:Static loc:L.RtInUse}" />
                        </Border>
                        <Button
                            x:Name="btnUse"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Classes="accent"
                            Content="{x:Static loc:L.RtUseSet}"
                            Theme="{StaticResource V2Button}" />
                        <Button
                            x:Name="btnSetMenu"
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="{x:Static loc:L.RtMoreActions}"
                            Classes="icon"
                            Theme="{StaticResource V2Button}"
                            ToolTip.Tip="{x:Static loc:L.RtMoreActions}">
                            <PathIcon Classes="i14" Data="{StaticResource SemiIconMore}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem x:Name="menuDuplicate" Header="{x:Static loc:L.RtDuplicate}" />
                                    <MenuItem x:Name="menuCopyRules" Header="{x:Static loc:L.RtCopyRules}" />
                                    <MenuItem Header="{x:Static loc:L.RtImport}">
                                        <MenuItem x:Name="menuImportFile" Header="{x:Static loc:L.RtFromFile}" />
                                        <MenuItem x:Name="menuImportClipboard" Header="{x:Static loc:L.RtFromClipboard}" />
                                        <MenuItem x:Name="menuImportUrl" Header="{x:Static loc:L.RtFromUrl}" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem x:Name="menuDeleteSet" Header="{x:Static loc:L.RtDelete}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <TextBlock
                        x:Name="txtSetSummary"
                        Margin="0,2,0,0"
                        Classes="srowhint"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />

                    <Grid Margin="4,22,0,8" ColumnDefinitions="*,Auto">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource V2Muted}">
                            <Run FontWeight="SemiBold" Text="{x:Static loc:L.RtRulesTab}" />
                            <Run Text=" · " />
                            <Run Text="{x:Static loc:L.RtRulesNote}" />
                        </TextBlock>
                        <Button
                            x:Name="btnAddRule"
                            Grid.Column="1"
                            Classes="small"
                            Theme="{StaticResource V2Button}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Classes="i12" Data="{StaticResource SemiIconPlus}" />
                                <TextBlock Text="{x:Static loc:L.RtAddRule}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Classes="sgroupcard" ClipToBounds="True">
                        <Panel>
                            <StackPanel x:Name="panelRules" />
                            <StackPanel
                                x:Name="panelNoRules"
                                Margin="16,22"
                                HorizontalAlignment="Center"
                                Spacing="4">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Classes="srowtitle"
                                    Text="{x:Static loc:L.RtNoRules}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Classes="srowhint"
                                    Text="{x:Static loc:L.RtNoRulesHint}" />
                                <Button
                                    x:Name="btnAddFirstRule"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    Classes="small"
                                    Content="{x:Static loc:L.RtAddFirstRule}"
                                    Theme="{StaticResource V2Button}" />
                            </StackPanel>
                        </Panel>
                    </Border>

                    <!--  The rule being edited, below the list.  -->
                    <StackPanel x:Name="panelEditor" IsVisible="False">
                        <TextBlock
                            x:Name="txtEditorTitle"
                            Margin="4,24,0,0"
                            Classes="srowtitle"
                            FontSize="15" />
                        <ContentControl x:Name="editorHost" />
                        <StackPanel
                            Margin="0,14,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="btnRuleCancel"
                                MinWidth="100"
                                Content="{x:Static loc:L.Cancel}"
                                Theme="{StaticResource V2Button}" />
                            <Button
                                x:Name="btnRuleSave"
                                MinWidth="100"
                                Classes="primary"
                                Content="{x:Static loc:L.Save}"
                                Theme="{StaticResource V2Button}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  The set's own expert fields, behind their own "Show more fields" (the rule editor has its own).  -->
                    <StackPanel x:Name="boxSetFields">
                    <StackPanel Classes="sgroup">
                        <TextBlock Classes="sgrouplabel" Text="{x:Static loc:L.RtSetDetails}" />
                        <Border Classes="sgroupcard">
                            <StackPanel>
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.RtSetUrl}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.RtSetUrlHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <TextBox x:Name="txtUrl" Width="260" PlaceholderText="https://…" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.RtSetOrder}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.RtSetOrderHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <TextBox x:Name="txtSort" Width="120" PlaceholderText="0" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.RtDomainStrategy}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.RtSetDomainStrategyHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBox x:Name="cmbSetDomainStrategy" Width="200" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.RtDomainStrategySb}" />
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.RtSetDomainStrategyHint}" />
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <ComboBox x:Name="cmbSetDomainStrategySb" Width="200" />
                                        </Panel>
                                    </Grid>
                                </Border>
                                <Border Classes="srow adv">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Classes="srowtext">
                                            <TextBlock Classes="srowtitle" Text="{x:Static loc:L.RtSetRuleset}" />
                                            <StackPanel>
                                                <TextBlock Classes="srowhint" Text="{x:Static loc:L.RtSetRulesetHint}" />
                                                <HyperlinkButton HorizontalAlignment="Left"
                                                    Margin="0,4,0,0"
                                                    Padding="0"
                                                    VerticalAlignment="Center"
                                                    Classes="WithIcon"
                                                    Click="linkCustomRulesetPath4Singbox_Click">
                                                    <TextBlock FontSize="12" Text="{x:Static loc:L.RtExample}" />
                                                </HyperlinkButton>
                                            </StackPanel>
                                        </StackPanel>
                                        <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBox x:Name="txtRulesetPath" Width="180" />
                                                <Button x:Name="btnBrowseRuleset" Content="{x:Static loc:L.TlChooseFile}" Theme="{StaticResource V2Button}" />
                                            </StackPanel>
                                        </Panel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Button
                        x:Name="btnSetFields"
                        Margin="0,10,0,0"
                        Classes="morefields"
                        Theme="{StaticResource V2Button}" />
                    </StackPanel>
                </StackPanel>

                <!--  Programs on their own server: one entry, filled in from code.  -->
                <StackPanel x:Name="panePin" Margin="28,20,28,28" IsVisible="False" />

                <!--  How sites are matched, for every set.  -->
                <StackPanel x:Name="paneMatch" Margin="28,20,28,28" IsVisible="False">
                    <TextBlock Classes="spagetitle" FontSize="20" Text="{x:Static loc:L.RtMatchNav}" />
                    <TextBlock Margin="0,6,0,0" Classes="spagehint" Text="{x:Static loc:L.RtMatchHint}" />
                    <Border Margin="0,20,0,0" Classes="sgroupcard">
                        <StackPanel>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.RtDomainStrategy}" />
                                        <StackPanel>
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.RtDomainStrategyHint}" />
                                            <HyperlinkButton HorizontalAlignment="Left"
                                                Margin="0,4,0,0"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Classes="WithIcon"
                                                Click="linkdomainStrategy_Click">
                                                <TextBlock FontSize="12" Text="{x:Static loc:L.RtLearnMore}" />
                                            </HyperlinkButton>
                                        </StackPanel>
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <ComboBox x:Name="cmbdomainStrategy" Width="200" />
                                    </Panel>
                                </Grid>
                            </Border>
                            <Border Classes="srow">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Classes="srowtext">
                                        <TextBlock Classes="srowtitle" Text="{x:Static loc:L.RtDomainStrategySb}" />
                                        <StackPanel>
                                            <TextBlock Classes="srowhint" Text="{x:Static loc:L.RtDomainStrategySbHint}" />
                                            <HyperlinkButton HorizontalAlignment="Left"
                                                Margin="0,4,0,0"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Classes="WithIcon"
                                                Click="linkdomainStrategy4Singbox_Click">
                                                <TextBlock FontSize="12" Text="{x:Static loc:L.RtLearnMore}" />
                                            </HyperlinkButton>
                                        </StackPanel>
                                    </StackPanel>
                                    <Panel Classes="srowctl" Grid.Column="1" VerticalAlignment="Center">
                                        <ComboBox x:Name="cmbdomainStrategy4Singbox" Width="200" />
                                    </Panel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Panel>
        </ScrollViewer>
    </Grid>
</Window>
