<UserControl
    x:Class="v2rayN.Desktop.Views.StatusBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:loc="using:v2rayN.Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignWidth="900"
    x:DataType="vms:StatusBarViewModel"
    Design.DataContext="{x:Static dd:DesignData.StatusBar}"
    mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="TextBlock.k">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
        </Style>
        <Style Selector="TextBlock.v">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
            <Setter Property="FontFeatures" Value="+tnum" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Styles>

    <Border
        MaxWidth="980"
        Padding="18,12,18,14"
        Classes="floating">
        <Grid ColumnDefinitions="*,28,1.15*" RowDefinitions="Auto,Auto">
            <Grid
                Grid.ColumnSpan="3"
                Margin="0,0,0,10"
                ColumnDefinitions="*,Auto">
                <!--  The left side gives way at narrow widths (the clock trims) so the check group stays on the card.  -->
                <DockPanel Margin="0,0,8,0">
                    <PathIcon
                        x:Name="iconState"
                        Margin="0,0,8,0"
                        Classes="i16"
                        Data="{StaticResource SemiIconShield}"
                        DockPanel.Dock="Left" />
                    <TextBlock
                        x:Name="txtState"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="txtStateTime"
                        VerticalAlignment="Center"
                        Classes="muted num"
                        TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <!--  Connection check: result chip plus the action that runs it.  -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Border
                        x:Name="chipCheck"
                        Classes="check"
                        IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon x:Name="iconCheck" Classes="i12" />
                            <TextBlock x:Name="txtCheck" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!--  The next step after "No response": another server of the same country or subscription.  -->
                    <Button
                        x:Name="btnFindWorking"
                        Classes="accent small"
                        IsVisible="False"
                        Theme="{StaticResource V2Button}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Path
                                x:Name="spinFind"
                                Classes="spinner"
                                IsVisible="False" />
                            <TextBlock x:Name="txtFindWorking" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="btnCheck"
                        Classes="ghost tiny"
                        Theme="{StaticResource V2Button}"
                        ToolTip.Tip="{x:Static loc:L.CheckAvailability}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon
                                x:Name="iconCheckIdle"
                                Classes="i12"
                                Data="{StaticResource SemiIconRefresh}" />
                            <Path
                                x:Name="spinCheck"
                                Classes="spinner"
                                IsVisible="False" />
                            <TextBlock x:Name="txtCheckAction" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="1"
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto">
                <StackPanel Margin="0,0,16,12" Spacing="3">
                    <TextBlock
                        x:Name="lblStatServer"
                        Classes="k"
                        Text="{x:Static loc:L.ServerIp}" />
                    <!--  Prefix trimming keeps the end of the address, so the port stays visible.  -->
                    <TextBlock
                        x:Name="txtStatServer"
                        Classes="v"
                        TextTrimming="PrefixCharacterEllipsis" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,0,12"
                    Spacing="3">
                    <TextBlock Classes="k" Text="{x:Static loc:L.Ping}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="txtStatPing" Classes="v" />
                        <Border
                            x:Name="trackPing"
                            Width="48"
                            Height="4"
                            VerticalAlignment="Center"
                            Background="{DynamicResource V2Pressed}"
                            CornerRadius="2">
                            <Border
                                x:Name="barPing"
                                Width="0"
                                HorizontalAlignment="Left"
                                CornerRadius="2" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Margin="0,0,16,0"
                    Spacing="3">
                    <TextBlock
                        x:Name="lblStatProtocol"
                        Classes="k"
                        Text="{x:Static loc:L.Protocol}" />
                    <TextBlock x:Name="txtStatProtocol" Classes="v" />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    Spacing="3">
                    <TextBlock Classes="k" Text="{x:Static loc:L.SessionTraffic}" />
                    <TextBlock x:Name="txtStatTotal" Classes="v" />
                </StackPanel>
            </Grid>

            <Grid
                x:Name="panelSpeed"
                Grid.Row="1"
                Grid.Column="2"
                RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="k" Text="{x:Static loc:L.CurrentSpeed}" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon
                                Classes="i12"
                                Foreground="{DynamicResource V2Safe}"
                                Data="{StaticResource SemiIconArrowDown}" />
                            <TextBlock
                                x:Name="txtSpeedDown"
                                MinWidth="64"
                                Classes="small num"
                                TextAlignment="Right"
                                Foreground="{DynamicResource V2Ink}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon
                                Classes="i12"
                                Foreground="{DynamicResource V2Folder}"
                                Data="{StaticResource SemiIconArrowUp}" />
                            <TextBlock
                                x:Name="txtSpeedUp"
                                MinWidth="64"
                                Classes="small num"
                                TextAlignment="Right"
                                Foreground="{DynamicResource V2Ink}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!--  Drawn at the real pixel size so the strokes stay crisp at any width.  -->
                <Panel
                    x:Name="chartHost"
                    Grid.Row="1"
                    Height="56"
                    Margin="0,8,0,0"
                    ClipToBounds="True">
                    <Border
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource V2Border}" />
                    <Border
                        Height="1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource V2Border}"
                        Opacity="0.5" />
                    <Canvas>
                        <Path x:Name="pathDownFill" Fill="{DynamicResource V2SafeSoft}" />
                        <Path
                            x:Name="pathDown"
                            Stroke="{DynamicResource V2Safe}"
                            StrokeJoin="Round"
                            StrokeThickness="1.6" />
                        <Path
                            x:Name="pathUp"
                            Stroke="{DynamicResource V2Folder}"
                            StrokeJoin="Round"
                            StrokeThickness="1.3" />
                    </Canvas>
                    <TextBlock
                        x:Name="txtChartMax"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Classes="muted num"
                        FontSize="11" />
                    <TextBlock
                        x:Name="txtChartIdle"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Classes="muted small"
                        Text="{x:Static loc:L.NoTraffic}" />
                </Panel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
