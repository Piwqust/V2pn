<UserControl
    x:Class="v2rayN.Desktop.Views.TrayPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:v2rayN.Desktop">
    <!--
        V2pn: what the tray icon opens (TrayMenuPlacement on Windows, MainWindow.Tray.cs on a Mac). Compact on purpose:
        the connection and its power button in one row, the servers a person goes back to as two columns of cards,
        the mode and the route as two switches, and the everyday actions as one bar of icons. MainWindow.Tray.cs fills
        it and keeps it current.
    -->
    <UserControl.Styles>
        <Style Selector="Border#root">
            <Setter Property="Background" Value="{DynamicResource V2DialogBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource V2PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource V2RadiusFloating}" />
            <Setter Property="BoxShadow" Value="{DynamicResource V2PanelShadow}" />
        </Style>
        <Style Selector="Border.tsep">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource V2Border}" />
        </Style>

        <!--  The connection.  -->
        <Style Selector="Button.thero">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="-6" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Border.tflag">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BoxShadow" Value="0 1 2 0 #40000000" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tglobe">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource V2CardMutedBackground}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tglobe PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
        </Style>
        <Style Selector="TextBlock.ttitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource V2Ink}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="PathIcon.tchevron">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource V2Faint}" />
        </Style>
        <Style Selector="TextBlock.tstate">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.4" />
            <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Ellipse.tdot">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource V2Muted}" />
        </Style>
        <Style Selector="StackPanel.safe TextBlock.tstate">
            <Setter Property="Foreground" Value="{DynamicResource V2Safe}" />
        </Style>
        <Style Selector="StackPanel.safe Ellipse.tdot">
            <Setter Property="Fill" Value="{DynamicResource V2Safe}" />
        </Style>
        <Style Selector="StackPanel.warn TextBlock.tstate">
            <Setter Property="Foreground" Value="{DynamicResource V2PingMid}" />
        </Style>
        <Style Selector="StackPanel.warn Ellipse.tdot">
            <Setter Property="Fill" Value="{DynamicResource V2PingMid}" />
        </Style>
        <Style Selector="StackPanel.unsafe TextBlock.tstate">
            <Setter Property="Foreground" Value="{DynamicResource V2Unsafe}" />
        </Style>
        <Style Selector="StackPanel.unsafe Ellipse.tdot">
            <Setter Property="Fill" Value="{DynamicResource V2Unsafe}" />
        </Style>
        <!--  Connect and Disconnect as one round power button, coloured as the window's Connect.  -->
        <Style Selector="Button.tpower">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tpower PathIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
        </Style>

        <!--  Server cards: flag, name, ping; the one in use is outlined.  -->
        <Style Selector="Button.tcard">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource V2Border}" />
        </Style>
        <Style Selector="Button.tcard.active">
            <Setter Property="BorderBrush" Value="{DynamicResource V2RowSelectedBorder}" />
        </Style>
        <Style Selector="Button.tcard TextBlock.tname">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Button.tcard TextBlock.tping">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFeatures" Value="+tnum" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource V2Muted}" />
        </Style>
        <Style Selector="Button.tcard TextBlock.tping.good">
            <Setter Property="Foreground" Value="{DynamicResource V2PingGood}" />
        </Style>
        <Style Selector="Button.tcard TextBlock.tping.mid">
            <Setter Property="Foreground" Value="{DynamicResource V2PingMid}" />
        </Style>
        <Style Selector="Button.tcard TextBlock.tping.bad">
            <Setter Property="Foreground" Value="{DynamicResource V2PingBad}" />
        </Style>
        <Style Selector="Button.tcard Border.rowflag">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="15" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tcard PathIcon.rowicon">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="{DynamicResource V2InkSoft}" />
        </Style>

        <Style Selector="ListBox.tseg">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.tseg ListBoxItem">
            <Setter Property="Padding" Value="6,0" />
        </Style>

        <!--  The bar of actions: icons with their names in the tooltips.  -->
        <Style Selector="Button.tact">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.tact PathIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="Button.tact.done PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource V2Safe}" />
        </Style>
    </UserControl.Styles>

    <!--  The margin leaves room for the shadow inside the transparent window.  -->
    <Border
        x:Name="root"
        Width="320"
        Margin="10">
        <StackPanel Margin="14,14,14,8" Spacing="12">

            <!--  The connection: flag, country and server (a click picks another), the state, and the power button.  -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Button
                    x:Name="btnServer"
                    Classes="thero"
                    Theme="{StaticResource V2SideRow}"
                    ToolTip.Tip="{x:Static loc:L.TrayAllServersTip}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Panel>
                            <Border x:Name="borderFlag" Classes="tflag">
                                <Image x:Name="imgFlag" Stretch="UniformToFill" />
                            </Border>
                            <Border x:Name="borderGlobe" Classes="tglobe">
                                <PathIcon Data="{StaticResource SemiIconGlobeStroke}" />
                            </Border>
                        </Panel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock x:Name="txtTitle" Classes="ttitle" />
                            <TextBlock
                                x:Name="txtSubtitle"
                                Classes="muted small"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel
                                x:Name="panelState"
                                Margin="0,1,0,0"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Ellipse Classes="tdot" />
                                <TextBlock x:Name="txtState" Classes="tstate" />
                            </StackPanel>
                        </StackPanel>
                        <PathIcon
                            Grid.Column="2"
                            Classes="tchevron"
                            Data="{StaticResource SemiIconChevronRight}" />
                    </Grid>
                </Button>
                <Button
                    x:Name="btnConnect"
                    Grid.Column="1"
                    Classes="connectbtn tpower"
                    Theme="{StaticResource V2Button}">
                    <PathIcon Data="{StaticResource SemiIconPower}" />
                </Button>
            </Grid>

            <!--  The fastest server, the favorites and the recent ones.  -->
            <UniformGrid
                x:Name="gridServers"
                ColumnSpacing="6"
                Columns="2"
                RowSpacing="6" />
            <TextBlock
                x:Name="txtNoServers"
                Classes="muted small"
                IsVisible="False"
                Text="{x:Static loc:L.TrayNoServers}"
                TextWrapping="Wrap" />

            <!--  How the computer is protected, and what goes through the VPN.  -->
            <StackPanel Spacing="6">
                <ListBox
                    x:Name="lstMode"
                    Classes="tseg"
                    Theme="{StaticResource V2Segmented}">
                    <ListBoxItem x:Name="itemProxy" AutomationProperties.Name="{x:Static loc:L.ModeProxy}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="i14" Data="{StaticResource SemiIconGlobeStroke}" />
                            <TextBlock Text="{x:Static loc:L.ModeProxy}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="itemVpn" AutomationProperties.Name="{x:Static loc:L.ModeVpn}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Classes="i14" Data="{StaticResource SemiIconShieldStroked}" />
                            <TextBlock Text="{x:Static loc:L.ModeVpn}" />
                            <PathIcon
                                x:Name="badgeAdmin"
                                Classes="i12 adminlock"
                                Data="{StaticResource SemiIconLock}" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
                <!--  The three routes by short names (the full ones are in the tooltips); a rule set of one's own
                      shows as a fourth item while it is in force.  -->
                <ListBox
                    x:Name="lstRoute"
                    Classes="tseg"
                    Theme="{StaticResource V2Segmented}">
                    <ListBoxItem
                        x:Name="itemRouteRussia"
                        AutomationProperties.Name="{x:Static loc:L.RouteRussiaDirect}"
                        ToolTip.Tip="{x:Static loc:L.RouteRussiaDirect}">
                        <TextBlock Text="{x:Static loc:L.TrayRouteRussia}" TextTrimming="CharacterEllipsis" />
                    </ListBoxItem>
                    <ListBoxItem
                        x:Name="itemRouteBlocked"
                        AutomationProperties.Name="{x:Static loc:L.RouteBlockedOnly}"
                        ToolTip.Tip="{x:Static loc:L.RouteBlockedOnly}">
                        <TextBlock Text="{x:Static loc:L.TrayRouteBlocked}" TextTrimming="CharacterEllipsis" />
                    </ListBoxItem>
                    <ListBoxItem
                        x:Name="itemRouteAll"
                        AutomationProperties.Name="{x:Static loc:L.RouteAll}"
                        ToolTip.Tip="{x:Static loc:L.RouteAll}">
                        <TextBlock Text="{x:Static loc:L.TrayRouteAll}" TextTrimming="CharacterEllipsis" />
                    </ListBoxItem>
                    <ListBoxItem x:Name="itemRouteCustom" IsVisible="False">
                        <TextBlock x:Name="txtRouteCustom" TextTrimming="CharacterEllipsis" />
                    </ListBoxItem>
                </ListBox>
            </StackPanel>

            <Border Classes="tsep" />

            <!--  Paste, Update, Update through the VPN and the terminal command; then the window, Settings and Quit.  -->
            <Grid Margin="-4,-4,-4,0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
                <Button
                    x:Name="btnPaste"
                    AutomationProperties.Name="{x:Static loc:L.WelcomePaste}"
                    Classes="ghost tact"
                    Theme="{StaticResource V2Button}"
                    ToolTip.Tip="{x:Static loc:L.WelcomePaste}">
                    <PathIcon Data="{StaticResource SemiIconCopyAdd}" />
                </Button>
                <Button
                    x:Name="btnUpdate"
                    Grid.Column="1"
                    AutomationProperties.Name="{x:Static loc:L.UpdateAll}"
                    Classes="ghost tact"
                    Theme="{StaticResource V2Button}"
                    ToolTip.Tip="{x:Static loc:L.UpdateAll}">
                    <PathIcon Data="{StaticResource SemiIconRefresh}" />
                </Button>
                <Button
                    x:Name="btnUpdateVpn"
                    Grid.Column="2"
                    AutomationProperties.Name="{x:Static loc:L.TraySubUpdateViaVpn}"
                    Classes="ghost tact"
                    Theme="{StaticResource V2Button}"
                    ToolTip.Tip="{x:Static loc:L.TraySubUpdateViaVpn}">
                    <PathIcon Data="{StaticResource SemiIconShieldStroked}" />
                </Button>
                <Button
                    x:Name="btnTerminal"
                    Grid.Column="3"
                    AutomationProperties.Name="{x:Static loc:L.TrayCopyProxyCmd}"
                    Classes="ghost tact"
                    Theme="{StaticResource V2Button}"
                    ToolTip.Tip="{x:Static loc:L.TrayCopyProxyCmd}">
                    <PathIcon Data="{StaticResource SemiIconTerminal}" />
                </Button>
                <Button
                    x:Name="btnOpenWide"
                    Grid.Column="5"
                    AutomationProperties.Name="{x:Static loc:L.TrayOpen}"
                    Classes="ghost tact"
                    Theme="{StaticResource V2Button}"
                    ToolTip.Tip="{x:Static loc:L.TrayOpen}">
                    <PathIcon Data="{StaticResource SemiIconExternalOpen}" />
                </Button>
                <Button
                    x:Name="btnSettings"
                    Grid.Column="6"
                    AutomationProperties.Name="{x:Static loc:L.Settings}"
                    Classes="ghost tact"
                    Theme="{StaticResource V2Button}"
                    ToolTip.Tip="{x:Static loc:L.Settings}">
                    <PathIcon Data="{StaticResource SemiIconSettingStroked}" />
                </Button>
                <Button
                    x:Name="btnQuit"
                    Grid.Column="7"
                    AutomationProperties.Name="{x:Static loc:L.MenuQuit}"
                    Classes="ghost tact"
                    Theme="{StaticResource V2Button}"
                    ToolTip.Tip="{x:Static loc:L.MenuQuit}">
                    <PathIcon Data="{StaticResource SemiIconExit}" />
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
